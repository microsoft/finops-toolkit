//
// NAME: Network quota usage
// DESCRIPTION: Rehydrates the latest Network quota usage records for each subscription and region.
// CATEGORY: Governance
// FEATURE: Quota
// REGION: All
// TECH: KQL
//
// RESOURCE TYPES: Microsoft.Network/locations/usages
//
// SOURCE: Quota()
//

Quota()
| where x_SourceType =~ 'NetworkUsage'
| where ResourceType =~ 'Microsoft.Network/locations/usages'
| where isnotempty(ResourceName)
| summarize arg_max(x_IngestionTime, *) by ResourceId
| project
    ProviderName,
    ResourceId,
    ResourceName,
    ResourceType,
    SubAccountId,
    displayName,
    location,
    currentValue,
    limit,
    unit,
    x_QuotaDetails,
    x_SourceType,
    x_SourceVersion,
    x_IngestionTime
| order by SubAccountId asc, location asc, ResourceName asc

//
// NAME: Compute VM family offer status
// DESCRIPTION: Shows region and availability zone restrictions from the smallest VM SKU in each family.
// CATEGORY: Governance
// FEATURE: Quota
// REGION: All
// TECH: KQL
//
// RESOURCE TYPES: Microsoft.Compute/skus
//
// SOURCE: Quota()
//

Quota()
| where x_SourceType =~ 'ComputeResourceSku'
| where ResourceType =~ 'Microsoft.Compute/skus'
| where isnotempty(ResourceName) and isnotempty(location)
| summarize arg_max(x_IngestionTime, *) by ResourceId
| extend
    SubscriptionId = SubAccountId,
    FamilyKey = tostring(x_QuotaDetails.Family),
    Location = tolower(location),
    SkuVcpus = toint(extract(@'(\d+)', 1, tostring(x_QuotaDetails.Size)))
| where isnotempty(SubscriptionId) and isnotempty(FamilyKey)
| sort by
    SubscriptionId asc,
    FamilyKey asc,
    Location asc,
    SkuVcpus asc,
    ResourceName asc
| serialize
| extend FamilySkuRank = row_number(
    1,
    SubscriptionId != prev(SubscriptionId)
        or FamilyKey != prev(FamilyKey)
        or Location != prev(Location)
)
| where FamilySkuRank == 1
// The collector stores this region's physical zones as comma-separated strings.
| extend
    RegionRestricted = tobool(x_QuotaDetails.RegionRestricted),
    ZonesPresent = array_sort_asc(extract_all(@'([^,]+)', tostring(x_QuotaDetails.ZonesPresent))),
    ZonesRestricted = array_sort_asc(extract_all(@'([^,]+)', tostring(x_QuotaDetails.ZonesRestricted)))
| project
    SubscriptionId,
    FamilyKey,
    Location,
    RepresentativeSku = ResourceName,
    RegionRestricted,
    ZonesPresent,
    ZonesRestricted,
    x_IngestionTime
| order by SubscriptionId asc, Location asc, FamilyKey asc

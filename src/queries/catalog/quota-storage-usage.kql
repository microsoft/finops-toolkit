//
// NAME: Storage quota usage
// DESCRIPTION: Rehydrates the latest Storage account, disk, and snapshot quota usage records for each subscription and region.
// CATEGORY: Governance
// FEATURE: Quota
// REGION: All
// TECH: KQL
//
// RESOURCE TYPES: Microsoft.Storage/locations/usages, Microsoft.Compute/locations/usages
//
// SOURCE: Quota()
//

Quota()
| where
    (x_SourceType =~ 'StorageUsage'
        and ResourceType =~ 'Microsoft.Storage/locations/usages'
        and ResourceName =~ 'StorageAccounts'
        and isnotempty(location))
    or (x_SourceType =~ 'ComputeUsage'
        and ResourceType =~ 'Microsoft.Compute/locations/usages'
        and ResourceName matches regex '(?i)(disk|snapshot)')
| summarize arg_max(x_IngestionTime, *) by ResourceId
| project
    ProviderName,
    ResourceId,
    ResourceName,
    ResourceType,
    SubAccountId,
    displayName,
    location,
    currentValue,
    limit,
    unit,
    x_QuotaDetails,
    x_SourceType,
    x_SourceVersion,
    x_IngestionTime
| order by SubAccountId asc, location asc, ResourceName asc

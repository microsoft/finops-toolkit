// ContractCommitments_transform_v1_4 function
.create-or-alter function
with (docstring='All contract commitments aligned to FOCUS 1.4.', folder='Contract commitments')
ContractCommitments_transform_v1_4()
{
    ContractCommitments_raw
    | project
        BenefitCategory                       = column_ifexists('BenefitCategory', ''),                            // FOCUS 1.4+
        BillingCurrency,
        ContractCommitmentApplicability       = parse_json(column_ifexists('ContractCommitmentApplicability', '')),// FOCUS 1.4+
        ContractCommitmentCategory,
        ContractCommitmentCost,
        ContractCommitmentId,
        ContractCommitmentPeriodEnd,
        ContractCommitmentPeriodStart,
        ContractCommitmentQuantity,
        ContractCommitmentType,
        ContractCommitmentUnit,
        ContractId,
        ContractPeriodEnd,
        ContractPeriodStart,
        Created                               = column_ifexists('Created', datetime(null)),                       // FOCUS 1.4+
        DiscountPercentage                    = column_ifexists('DiscountPercentage', real(null)),                // FOCUS 1.4+
        DurationType                          = column_ifexists('DurationType', ''),                              // FOCUS 1.4+
        FulfillmentInterval                   = column_ifexists('FulfillmentInterval', ''),                       // FOCUS 1.4+
        InvoiceIssuerName,
        LastUpdated                           = column_ifexists('LastUpdated', datetime(null)),                   // FOCUS 1.4+
        LifecycleStatus                       = column_ifexists('LifecycleStatus', ''),                           // FOCUS 1.4+
        Model                                 = column_ifexists('Model', ''),                                     // FOCUS 1.4+
        OfferCategory                         = column_ifexists('OfferCategory', ''),                             // FOCUS 1.4+
        PaymentInterval                       = column_ifexists('PaymentInterval', ''),                           // FOCUS 1.4+
        PaymentModel                          = column_ifexists('PaymentModel', ''),                              // FOCUS 1.4+
        PaymentUpfrontPercentage              = column_ifexists('PaymentUpfrontPercentage', real(null)),          // FOCUS 1.4+
        PricingCurrency,
        PricingCurrencyContractCommitmentCost = column_ifexists('PricingCurrencyContractCommitmentCost', real(null)),  // FOCUS 1.4+
        x_IngestionTime  = ingestion_time(),
        x_SourceName     = coalesce(x_SourceName, ''),
        x_SourceProvider = coalesce(x_SourceProvider, ''),
        x_SourceType     = coalesce(x_SourceType, ''),
        x_SourceVersion  = coalesce(x_SourceVersion, '')
}


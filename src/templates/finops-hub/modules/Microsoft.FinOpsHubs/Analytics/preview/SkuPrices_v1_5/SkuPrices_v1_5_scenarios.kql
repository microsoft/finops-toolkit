// FOCUS 1.5 SKU Price scenarios: row-per-price-type vs. column-per-price-type
//
// Rows    = SkuPrices_v1_5      one row per SkuPriceId x price type (x_UnitPriceType: List, Base, Contracted, Effective)
// Columns = SkuPricesWide_v1_5  one row per SkuPriceId with ListUnitPrice, ContractedUnitPrice, x_BaseUnitPrice, x_EffectiveUnitPrice
//
// Both tables are built from the same Prices_final_v1_2 data by SkuPrices_v1_5.kql.
// Cost and Usage joins use CostsWithSkuPriceIdv2 (Costs_final_v1_2 + SkuPriceIdv2) on SkuPriceId + ContractId + PricingCurrency.
// Prices are divided by the block size in x_PricingUnitDescription (e.g., "100 Hours") where per-unit prices matter.
// Queries use FOCUS columns where they exist; x_ columns only where FOCUS has no equivalent (meter, offer, term, price type).
// Each query uses the cheapest pattern found for its layout: filter and project early, lookup with a small right side,
// limit prices to the IDs a cost query needs, and evaluate eligibility once per distinct JSON value.
// Test-SkuPriceScenarios.ps1 runs each pair, compares results, and scores them.
//
// Format: "// ## <id> <name>", "// Question: ...", "// Expect: same|different (<why>)", then "// ### Rows" and "// ### Columns" queries.

// ## S01 List price for a SKU
// Question: What is the public list price for this SKU price?
// Source: PR 2595 "Find the List Prices in Force at a Point in Time"
// Expect: same
// ### Rows
SkuPrices_v1_5
| where SkuPriceId == 'ODU_DZH318Z0F6ZF_002N_1 Compute Hour_MS-AZR-0017P' and x_UnitPriceType == 'List'
| project SkuPriceId, PricingCurrency, ListUnitPrice = UnitPrice
// ### Columns
// The list price repeats on every contract's row, so it needs distinct
SkuPricesWide_v1_5
| where SkuPriceId == 'ODU_DZH318Z0F6ZF_002N_1 Compute Hour_MS-AZR-0017P'
| distinct SkuPriceId, PricingCurrency, ListUnitPrice

// ## S02 Negotiated discount by service
// Question: How much does the contract lower usage rates, by service?
// Source: PR 2595 "Measure What Negotiation Reduces the Rate By"; appendix standard_and_negotiated_prices.md
// Expect: same
// ### Rows
SkuPrices_v1_5
| where ChargeCategory == 'Usage' and x_UnitPriceType == 'Contracted'
| project SkuPriceId, PricingCurrency, PricingServiceName, ContractedUnitPrice = UnitPrice
| lookup kind=inner (
    SkuPrices_v1_5
    | where ChargeCategory == 'Usage' and x_UnitPriceType == 'List' and UnitPrice > 0
    | project SkuPriceId, PricingCurrency, ListUnitPrice = UnitPrice
  ) on SkuPriceId, PricingCurrency
| summarize Prices = count(), Discounted = countif(ContractedUnitPrice < ListUnitPrice), AvgDiscountPercent = round(avg(100.0 * (ListUnitPrice - ContractedUnitPrice) / ListUnitPrice), 4) by PricingServiceName
| order by Discounted desc, PricingServiceName asc
| take 10
// ### Columns
SkuPricesWide_v1_5
| where ChargeCategory == 'Usage' and ListUnitPrice > 0 and isnotnull(ContractedUnitPrice)
| summarize Prices = count(), Discounted = countif(ContractedUnitPrice < ListUnitPrice), AvgDiscountPercent = round(avg(100.0 * (ListUnitPrice - ContractedUnitPrice) / ListUnitPrice), 4) by PricingServiceName
| order by Discounted desc, PricingServiceName asc
| take 10

// ## S03 Base price drift from list
// Question: Where has the public list price moved away from the price fixed in the agreement?
// Source: PR 2595 ("Base" price type); research gap: PR 2424 has no column to tell Base from Contracted
// Expect: same
// ### Rows
SkuPrices_v1_5
| where x_UnitPriceType == 'Base'
| project SkuPriceId, PricingCurrency, PricingServiceName, BaseUnitPrice = UnitPrice
| lookup kind=inner (
    SkuPrices_v1_5
    | where x_UnitPriceType == 'List'
    | project SkuPriceId, PricingCurrency, ListUnitPrice = UnitPrice
  ) on SkuPriceId, PricingCurrency
| summarize Prices = count(), ListAboveBase = countif(ListUnitPrice > BaseUnitPrice), ListBelowBase = countif(ListUnitPrice < BaseUnitPrice), MaxDriftPercent = round(max(iff(BaseUnitPrice > 0, 100.0 * (ListUnitPrice - BaseUnitPrice) / BaseUnitPrice, real(null))), 4) by PricingServiceName
| order by ListAboveBase + ListBelowBase desc, PricingServiceName asc
| take 10
// ### Columns
SkuPricesWide_v1_5
| where isnotnull(x_BaseUnitPrice) and isnotnull(ListUnitPrice)
| summarize Prices = count(), ListAboveBase = countif(ListUnitPrice > x_BaseUnitPrice), ListBelowBase = countif(ListUnitPrice < x_BaseUnitPrice), MaxDriftPercent = round(max(iff(x_BaseUnitPrice > 0, 100.0 * (ListUnitPrice - x_BaseUnitPrice) / x_BaseUnitPrice, real(null))), 4) by PricingServiceName
| order by ListAboveBase + ListBelowBase desc, PricingServiceName asc
| take 10

// ## S04 Reservation price vs. on-demand
// Question: For each reservation term, what is the hourly rate and the savings vs. the on-demand contracted rate?
// Source: PR 2595 "Evaluate the Purchase Terms Offered for a SKU"; appendix commitment_pricing.md
// Expect: same
// ### Rows
let reservations = materialize(SkuPrices_v1_5
    | where ChargeCategory == 'Purchase' and x_UnitPriceType == 'Contracted' and x_SkuPriceType == 'ReservedInstance' and x_SkuTerm >= 12
    | project x_SkuMeterId, x_SkuTerm, HourlyRate = UnitPrice / (x_SkuTerm * 730.0));
let meters = reservations | distinct x_SkuMeterId;
reservations
| lookup kind=inner (
    SkuPrices_v1_5
    | where x_SkuMeterId in (meters) and ChargeCategory == 'Usage' and x_UnitPriceType == 'Contracted' and x_SkuPriceType == 'Consumption' and x_SkuOfferId == 'MS-AZR-0017P' and UnitPrice > 0
    | summarize OnDemandRate = min(UnitPrice) by x_SkuMeterId
  ) on x_SkuMeterId
| summarize Reservations = count(), AvgSavingsPercent = round(avg(100.0 * (OnDemandRate - HourlyRate) / OnDemandRate), 2) by Term = x_SkuTerm
| order by Term asc
// ### Columns
let reservations = materialize(SkuPricesWide_v1_5
    | where ChargeCategory == 'Purchase' and x_SkuPriceType == 'ReservedInstance' and x_SkuTerm >= 12 and isnotnull(ContractedUnitPrice)
    | project x_SkuMeterId, x_SkuTerm, HourlyRate = ContractedUnitPrice / (x_SkuTerm * 730.0));
let meters = reservations | distinct x_SkuMeterId;
reservations
| lookup kind=inner (
    SkuPricesWide_v1_5
    | where x_SkuMeterId in (meters) and ChargeCategory == 'Usage' and x_SkuPriceType == 'Consumption' and x_SkuOfferId == 'MS-AZR-0017P' and ContractedUnitPrice > 0
    | summarize OnDemandRate = min(ContractedUnitPrice) by x_SkuMeterId
  ) on x_SkuMeterId
| summarize Reservations = count(), AvgSavingsPercent = round(avg(100.0 * (OnDemandRate - HourlyRate) / OnDemandRate), 2) by Term = x_SkuTerm
| order by Term asc

// ## S05 Savings plan rate vs. on-demand
// Question: For each savings plan term, how much lower is the savings plan rate than the on-demand contracted rate?
// Source: issue #2706 (commitment unit price on covered usage); scope_and_evolution.md
// Expect: same
// ### Rows
let savingsPlans = materialize(SkuPrices_v1_5
    | where x_UnitPriceType == 'Effective' and x_SkuPriceType == 'SavingsPlan'
    | project x_SkuMeterId, x_SkuOfferId, x_SkuTerm, SavingsPlanRate = UnitPrice);
let meters = savingsPlans | distinct x_SkuMeterId;
savingsPlans
| lookup kind=inner (
    SkuPrices_v1_5
    | where x_SkuMeterId in (meters) and ChargeCategory == 'Usage' and x_UnitPriceType == 'Contracted' and x_SkuPriceType == 'Consumption' and UnitPrice > 0
    | summarize OnDemandRate = min(UnitPrice) by x_SkuMeterId, x_SkuOfferId
  ) on x_SkuMeterId, x_SkuOfferId
| summarize Prices = count(), AvgSavingsPercent = round(avg(100.0 * (OnDemandRate - SavingsPlanRate) / OnDemandRate), 2) by Term = x_SkuTerm
| order by Term asc
// ### Columns
let savingsPlans = materialize(SkuPricesWide_v1_5
    | where x_SkuPriceType == 'SavingsPlan' and isnotnull(x_EffectiveUnitPrice)
    | project x_SkuMeterId, x_SkuOfferId, x_SkuTerm, SavingsPlanRate = x_EffectiveUnitPrice);
let meters = savingsPlans | distinct x_SkuMeterId;
savingsPlans
| lookup kind=inner (
    SkuPricesWide_v1_5
    | where x_SkuMeterId in (meters) and ChargeCategory == 'Usage' and x_SkuPriceType == 'Consumption' and ContractedUnitPrice > 0
    | summarize OnDemandRate = min(ContractedUnitPrice) by x_SkuMeterId, x_SkuOfferId
  ) on x_SkuMeterId, x_SkuOfferId
| summarize Prices = count(), AvgSavingsPercent = round(avg(100.0 * (OnDemandRate - SavingsPlanRate) / OnDemandRate), 2) by Term = x_SkuTerm
| order by Term asc

// ## S06 Recent price changes by price type
// Question: Which list, base, contracted, and savings plan prices changed since July 2026?
// Source: appendix price_effectivity_and_currency.md; working-draft "Fluctuation Tracking of Unit Prices"
// Expect: different (columns share one effective start per row, so a change to any price marks every price on the row as changed)
// ### Rows
SkuPrices_v1_5
| where SkuPriceEffectiveStart >= datetime(2026-07-01)
| summarize Changed = count() by PriceType = x_UnitPriceType
| order by PriceType asc
// ### Columns
SkuPricesWide_v1_5
| where SkuPriceEffectiveStart >= datetime(2026-07-01)
| summarize List = countif(isnotnull(ListUnitPrice)), Base = countif(isnotnull(x_BaseUnitPrice)), Contracted = countif(isnotnull(ContractedUnitPrice)), Effective = countif(isnotnull(x_EffectiveUnitPrice))
| evaluate narrow()
| project PriceType = Column, Changed = tolong(Value)
| where Changed > 0
| order by PriceType asc

// ## S07 Cheapest region for a VM size
// Question: Which regions have the lowest list price for each Dv5 VM size?
// Source: PR 2595 "Compare List Prices Across Regions"
// Expect: same
// ### Rows
SkuPrices_v1_5
| where x_UnitPriceType == 'List' and ChargeCategory == 'Usage' and x_SkuPriceType == 'Consumption' and x_SkuMeterSubcategory == 'Dv5 Series' and x_SkuOfferId == 'MS-AZR-0017P'
| summarize Price = min(UnitPrice) by x_SkuMeter, PricingRegionId
| as hint.materialized = true T
| lookup kind=inner (T | summarize MinPrice = min(Price), MaxPrice = max(Price), Regions = count() by x_SkuMeter) on x_SkuMeter
| where Price == MinPrice
| summarize CheapestRegions = strcat_array(array_sort_asc(make_list(PricingRegionId)), ", ") by x_SkuMeter, MinPrice, MaxPrice, Regions
| order by x_SkuMeter asc
// ### Columns
SkuPricesWide_v1_5
| where ChargeCategory == 'Usage' and x_SkuPriceType == 'Consumption' and x_SkuMeterSubcategory == 'Dv5 Series' and x_SkuOfferId == 'MS-AZR-0017P' and isnotnull(ListUnitPrice)
| summarize Price = min(ListUnitPrice) by x_SkuMeter, PricingRegionId
| as hint.materialized = true T
| lookup kind=inner (T | summarize MinPrice = min(Price), MaxPrice = max(Price), Regions = count() by x_SkuMeter) on x_SkuMeter
| where Price == MinPrice
| summarize CheapestRegions = strcat_array(array_sort_asc(make_list(PricingRegionId)), ", ") by x_SkuMeter, MinPrice, MaxPrice, Regions
| order by x_SkuMeter asc

// ## S08 Verify billed unit prices
// Question: Do the list and contracted unit prices on last month's on-demand charges match the price list?
// Source: PR 2595 "Compare Recorded Unit Prices with Published Rates"; dataset.md Relationships
// Expect: same
// ### Rows
// Price sheet prices are per block (e.g., "100 Hours"); use them only when the unit matches the charge's PricingUnit
let block = (d: string, unit: string) { let u = extract(@'^[\d.]+\s*(.*)$', 1, d); let priceUnit = iff(isempty(u) or u startswith '/', strcat('Units', u), u); iff(tolower(trim_end('s', priceUnit)) == tolower(trim_end('s', unit)), coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0), real(null)) };
let costs = materialize(CostsWithSkuPriceIdv2
    | where ChargePeriodStart >= datetime(2026-09-01) and ChargePeriodStart < datetime(2026-10-01)
    | where ChargeCategory == 'Usage' and isempty(CommitmentDiscountCategory)
    | project SkuPriceIdv2, ContractId = tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId)), PricingCurrency, PricingUnit, ListUnitPrice, ContractedUnitPrice);
let ids = costs | distinct SkuPriceIdv2;
costs
| lookup kind=leftouter (SkuPrices_v1_5 | where x_UnitPriceType == 'List' and SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, PricingCurrency, PriceList = UnitPrice, PriceUnit = x_PricingUnitDescription) on SkuPriceIdv2, PricingCurrency
| lookup kind=leftouter (SkuPrices_v1_5 | where x_UnitPriceType == 'Contracted' and SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, ContractId, PricingCurrency, PriceContracted = UnitPrice) on SkuPriceIdv2, ContractId, PricingCurrency
| extend PerUnit = 1.0 / block(PriceUnit, PricingUnit)
| extend PriceList = PriceList * PerUnit, PriceContracted = PriceContracted * PerUnit
| summarize Charges = count(), Priced = countif(isnotnull(PriceList)), ListMatches = countif(abs(ListUnitPrice - PriceList) < 1e-6), ContractedMatches = countif(abs(ContractedUnitPrice - PriceContracted) < 1e-6)
// ### Columns
// Price sheet prices are per block (e.g., "100 Hours"); use them only when the unit matches the charge's PricingUnit
let block = (d: string, unit: string) { let u = extract(@'^[\d.]+\s*(.*)$', 1, d); let priceUnit = iff(isempty(u) or u startswith '/', strcat('Units', u), u); iff(tolower(trim_end('s', priceUnit)) == tolower(trim_end('s', unit)), coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0), real(null)) };
let costs = materialize(CostsWithSkuPriceIdv2
    | where ChargePeriodStart >= datetime(2026-09-01) and ChargePeriodStart < datetime(2026-10-01)
    | where ChargeCategory == 'Usage' and isempty(CommitmentDiscountCategory)
    | project SkuPriceIdv2, ContractId = tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId)), PricingCurrency, PricingUnit, ListUnitPrice, ContractedUnitPrice);
let ids = costs | distinct SkuPriceIdv2;
costs
| lookup kind=leftouter (SkuPricesWide_v1_5 | where SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, ContractId, PricingCurrency, PriceList = ListUnitPrice, PriceContracted = ContractedUnitPrice, PriceUnit = x_PricingUnitDescription) on SkuPriceIdv2, ContractId, PricingCurrency
| extend PerUnit = 1.0 / block(PriceUnit, PricingUnit)
| extend PriceList = PriceList * PerUnit, PriceContracted = PriceContracted * PerUnit
| summarize Charges = count(), Priced = countif(isnotnull(PriceList)), ListMatches = countif(abs(ListUnitPrice - PriceList) < 1e-6), ContractedMatches = countif(abs(ContractedUnitPrice - PriceContracted) < 1e-6)

// ## S09 Savings plan what-if for on-demand usage
// Question: What would last month's on-demand VM usage cost at list, contracted, and 1-year savings plan rates?
// Source: PR 2595 "Project the Effect of Moving Consumption to a Contracted Rate"; issue #2706
// Expect: same
// ### Rows
// Price sheet prices are per block (e.g., "100 Hours"); use them only when the unit matches the charge's PricingUnit
let block = (d: string, unit: string) { let u = extract(@'^[\d.]+\s*(.*)$', 1, d); let priceUnit = iff(isempty(u) or u startswith '/', strcat('Units', u), u); iff(tolower(trim_end('s', priceUnit)) == tolower(trim_end('s', unit)), coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0), real(null)) };
let costs = materialize(CostsWithSkuPriceIdv2
    | where ChargePeriodStart >= datetime(2026-09-01) and ChargePeriodStart < datetime(2026-10-01)
    | where ChargeCategory == 'Usage' and isempty(CommitmentDiscountCategory) and ServiceName == 'Virtual Machines'
    // No column links an on-demand price to its savings plan price; the IDs differ only by prefix
    | project SkuPriceIdv2, SavingsPlanSkuPriceId = strcat('SPU12', substring(SkuPriceIdv2, 3)), ContractId = tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId)), PricingCurrency, PricingUnit, PricingQuantity, EffectiveCost);
let ids = costs | distinct SkuPriceIdv2;
let spIds = costs | distinct SavingsPlanSkuPriceId;
costs
| lookup kind=leftouter (SkuPrices_v1_5 | where x_UnitPriceType == 'List' and SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, PricingCurrency, PriceList = UnitPrice, PriceUnit = x_PricingUnitDescription) on SkuPriceIdv2, PricingCurrency
| lookup kind=leftouter (SkuPrices_v1_5 | where x_UnitPriceType == 'Contracted' and SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, ContractId, PricingCurrency, PriceContracted = UnitPrice) on SkuPriceIdv2, ContractId, PricingCurrency
| lookup kind=leftouter (SkuPrices_v1_5 | where x_UnitPriceType == 'Effective' and SkuPriceId in (spIds) | project SavingsPlanSkuPriceId = SkuPriceId, ContractId, PricingCurrency, PriceSavingsPlan = UnitPrice) on SavingsPlanSkuPriceId, ContractId, PricingCurrency
| extend PerUnit = 1.0 / block(PriceUnit, PricingUnit)
| extend PriceList = PriceList * PerUnit, PriceContracted = PriceContracted * PerUnit, PriceSavingsPlan = PriceSavingsPlan * PerUnit
| summarize AtList = round(sum(PricingQuantity * PriceList), 2), AtContracted = round(sum(PricingQuantity * PriceContracted), 2), AtSavingsPlan = round(sum(PricingQuantity * coalesce(PriceSavingsPlan, PriceContracted)), 2), Billed = round(sum(EffectiveCost), 2)
// ### Columns
// Price sheet prices are per block (e.g., "100 Hours"); use them only when the unit matches the charge's PricingUnit
let block = (d: string, unit: string) { let u = extract(@'^[\d.]+\s*(.*)$', 1, d); let priceUnit = iff(isempty(u) or u startswith '/', strcat('Units', u), u); iff(tolower(trim_end('s', priceUnit)) == tolower(trim_end('s', unit)), coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0), real(null)) };
let costs = materialize(CostsWithSkuPriceIdv2
    | where ChargePeriodStart >= datetime(2026-09-01) and ChargePeriodStart < datetime(2026-10-01)
    | where ChargeCategory == 'Usage' and isempty(CommitmentDiscountCategory) and ServiceName == 'Virtual Machines'
    // No column links an on-demand price to its savings plan price; the IDs differ only by prefix
    | project SkuPriceIdv2, SavingsPlanSkuPriceId = strcat('SPU12', substring(SkuPriceIdv2, 3)), ContractId = tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId)), PricingCurrency, PricingUnit, PricingQuantity, EffectiveCost);
let ids = costs | distinct SkuPriceIdv2;
let spIds = costs | distinct SavingsPlanSkuPriceId;
costs
| lookup kind=leftouter (SkuPricesWide_v1_5 | where SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, ContractId, PricingCurrency, PriceList = ListUnitPrice, PriceContracted = ContractedUnitPrice, PriceUnit = x_PricingUnitDescription) on SkuPriceIdv2, ContractId, PricingCurrency
| lookup kind=leftouter (SkuPricesWide_v1_5 | where SkuPriceId in (spIds) | project SavingsPlanSkuPriceId = SkuPriceId, ContractId, PricingCurrency, PriceSavingsPlan = x_EffectiveUnitPrice) on SavingsPlanSkuPriceId, ContractId, PricingCurrency
| extend PerUnit = 1.0 / block(PriceUnit, PricingUnit)
| extend PriceList = PriceList * PerUnit, PriceContracted = PriceContracted * PerUnit, PriceSavingsPlan = PriceSavingsPlan * PerUnit
| summarize AtList = round(sum(PricingQuantity * PriceList), 2), AtContracted = round(sum(PricingQuantity * PriceContracted), 2), AtSavingsPlan = round(sum(PricingQuantity * coalesce(PriceSavingsPlan, PriceContracted)), 2), Billed = round(sum(EffectiveCost), 2)

// ## S10 All prices for one SKU
// Question: Show every price type for one VM size in one region side by side.
// Source: PR 2595 catalog discovery; FOCUS Cost and Usage ListUnitPrice/ContractedUnitPrice pairing
// Expect: same
// ### Rows
SkuPrices_v1_5
| where x_SkuMeterId == '0404074d-2846-5fe5-bd12-2c8e858c3f30' and ChargeCategory == 'Usage'
| summarize
    ListUnitPrice       = take_anyif(UnitPrice, x_UnitPriceType == 'List'),
    BaseUnitPrice       = take_anyif(UnitPrice, x_UnitPriceType == 'Base'),
    ContractedUnitPrice = take_anyif(UnitPrice, x_UnitPriceType == 'Contracted'),
    EffectiveUnitPrice  = take_anyif(UnitPrice, x_UnitPriceType == 'Effective')
    by SkuPriceId, PricingCurrency
| order by SkuPriceId asc
// ### Columns
SkuPricesWide_v1_5
| where x_SkuMeterId == '0404074d-2846-5fe5-bd12-2c8e858c3f30' and ChargeCategory == 'Usage'
| project SkuPriceId, PricingCurrency, ListUnitPrice, BaseUnitPrice = x_BaseUnitPrice, ContractedUnitPrice, EffectiveUnitPrice = x_EffectiveUnitPrice
| order by SkuPriceId asc

// ## S11 Estimate a planned workload
// Question: What would 2 D2 v5, 4 D4 v5, and 1 E8 v5 VMs in US East cost for a month at list and contracted rates?
// Source: PR 2595 "Estimate the Cost of a Planned Workload"
// Expect: same
// ### Rows
let block = (d: string) { coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0) };
let plan = datatable(SkuPriceId: string, Quantity: real) [
    'ODU_DZH318Z08M9X_008W_1 Compute Hour_MS-AZR-0017P', 1460,
    'ODU_DZH318Z08M9X_007S_1 Compute Hour_MS-AZR-0017P', 2920,
    'ODU_DZH318Z08M9J_003G_1 Compute Hour_MS-AZR-0017P', 730 ];
SkuPrices_v1_5
| where x_UnitPriceType in ('List', 'Contracted')
| lookup kind=inner plan on SkuPriceId
| extend Cost = Quantity * UnitPrice / block(x_PricingUnitDescription)
| summarize AtList = round(sumif(Cost, x_UnitPriceType == 'List'), 2), AtContracted = round(sumif(Cost, x_UnitPriceType == 'Contracted'), 2)
// ### Columns
let block = (d: string) { coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0) };
let plan = datatable(SkuPriceId: string, Quantity: real) [
    'ODU_DZH318Z08M9X_008W_1 Compute Hour_MS-AZR-0017P', 1460,
    'ODU_DZH318Z08M9X_007S_1 Compute Hour_MS-AZR-0017P', 2920,
    'ODU_DZH318Z08M9J_003G_1 Compute Hour_MS-AZR-0017P', 730 ];
SkuPricesWide_v1_5
| lookup kind=inner plan on SkuPriceId
| summarize AtList = round(sum(Quantity * ListUnitPrice / block(x_PricingUnitDescription)), 2), AtContracted = round(sum(Quantity * ContractedUnitPrice / block(x_PricingUnitDescription)), 2)

// ## S12 Prices a billing account is eligible for
// Question: How many prices of each type can a billing account with no agreement on this price list use?
// Source: PR 2595 "Identify the Prices a Billing Account is Eligible For"; sku_price_eligibility_examples.md
// Expect: different (columns scope the whole row to the agreement, so the public list price is hidden from other accounts)
// ### Rows
let account = '/providers/microsoft.billing/billingaccounts/1234567';
SkuPrices_v1_5
// Evaluate each distinct eligibility object once instead of once per price
| summarize Prices = count() by PriceType = x_UnitPriceType, Eligibility = tostring(SkuPriceEligibility)
| extend e = parse_json(Eligibility)
| mv-apply rule = e.Inclusions on (
    summarize Included = countif(rule.Dimension == 'BillingAccountId' and (
        (rule.Operator == 'In' and set_has_element(rule.Values, account)) or
        (rule.Operator == 'StartsWith' and account startswith tostring(rule.Values[0])))))
| where tobool(e.IsGlobalScope) or Included > 0
| summarize Prices = sum(Prices) by PriceType
| order by PriceType asc
// ### Columns
let account = '/providers/microsoft.billing/billingaccounts/1234567';
SkuPricesWide_v1_5
// Evaluate each distinct eligibility object once instead of once per price
| summarize List = countif(isnotnull(ListUnitPrice)), Base = countif(isnotnull(x_BaseUnitPrice)), Contracted = countif(isnotnull(ContractedUnitPrice)), Effective = countif(isnotnull(x_EffectiveUnitPrice)) by Eligibility = tostring(SkuPriceEligibility)
| extend e = parse_json(Eligibility)
| mv-apply rule = e.Inclusions on (
    summarize Included = countif(rule.Dimension == 'BillingAccountId' and (
        (rule.Operator == 'In' and set_has_element(rule.Values, account)) or
        (rule.Operator == 'StartsWith' and account startswith tostring(rule.Values[0])))))
| where tobool(e.IsGlobalScope) or Included > 0
| summarize List = sum(List), Base = sum(Base), Contracted = sum(Contracted), Effective = sum(Effective)
| evaluate narrow()
| project PriceType = Column, Prices = tolong(Value)
| where Prices > 0
| order by PriceType asc

// ## S13 Usage rates vs. purchase fees
// Question: How many prices of each type are usage rates vs. purchase fees?
// Source: PR 2595 "Separate Usage Rates from Purchase Fees and Credit Values"
// Expect: same
// ### Rows
SkuPrices_v1_5
| summarize Prices = count() by ChargeCategory, PriceType = x_UnitPriceType
| order by ChargeCategory asc, PriceType asc
// ### Columns
SkuPricesWide_v1_5
| summarize List = countif(isnotnull(ListUnitPrice)), Base = countif(isnotnull(x_BaseUnitPrice)), Contracted = countif(isnotnull(ContractedUnitPrice)), Effective = countif(isnotnull(x_EffectiveUnitPrice)) by ChargeCategory
| mv-expand kind = array p = bag_pack('List', List, 'Base', Base, 'Contracted', Contracted, 'Effective', Effective)
| project ChargeCategory, PriceType = tostring(p[0]), Prices = tolong(p[1])
| where Prices > 0
| order by ChargeCategory asc, PriceType asc

// ## S14 Backfill missing prices on cost data
// Question: Which cost rows are missing a list or contracted unit price, and how much list and contracted cost does the price list fill in?
// Source: FinOps hubs Costs transform (price backfill); dataset.md Relationships (SkuPriceId + ContractId + effective dates)
// Expect: same
// ### Rows
// Price sheet prices are per block (e.g., "100 Hours"); use them only when the unit matches the charge's PricingUnit
let block = (d: string, unit: string) { let u = extract(@'^[\d.]+\s*(.*)$', 1, d); let priceUnit = iff(isempty(u) or u startswith '/', strcat('Units', u), u); iff(tolower(trim_end('s', priceUnit)) == tolower(trim_end('s', unit)), coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0), real(null)) };
let costs = materialize(CostsWithSkuPriceIdv2
    | where isnotempty(SkuPriceIdv2) and (isnull(ListUnitPrice) or ListUnitPrice == 0 or isnull(ContractedUnitPrice) or ContractedUnitPrice == 0)
    | project SkuPriceIdv2, ContractId = tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId)), PricingCurrency, PricingUnit, ChargePeriodStart, PricingQuantity, ListUnitPrice, ContractedUnitPrice);
let ids = costs | distinct SkuPriceIdv2;
costs
| lookup kind=leftouter (SkuPrices_v1_5 | where x_UnitPriceType == 'List' and SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, PricingCurrency, PriceList = UnitPrice, PriceUnit = x_PricingUnitDescription, ListStart = SkuPriceEffectiveStart) on SkuPriceIdv2, PricingCurrency
| lookup kind=leftouter (SkuPrices_v1_5 | where x_UnitPriceType == 'Contracted' and SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, ContractId, PricingCurrency, PriceContracted = UnitPrice, ContractedStart = SkuPriceEffectiveStart) on SkuPriceIdv2, ContractId, PricingCurrency
| extend PerUnit = 1.0 / block(PriceUnit, PricingUnit)
| extend PriceList = PriceList * PerUnit, PriceContracted = PriceContracted * PerUnit
// Only use a price that was in effect when the charge happened
| extend PriceList = iff(ChargePeriodStart >= ListStart, PriceList, real(null)), PriceContracted = iff(ChargePeriodStart >= ContractedStart, PriceContracted, real(null))
| extend MissingList = isnull(ListUnitPrice) or ListUnitPrice == 0, MissingContracted = isnull(ContractedUnitPrice) or ContractedUnitPrice == 0
| summarize MissingList = countif(MissingList), FilledList = countif(MissingList and PriceList > 0), ListCostAdded = round(sumif(PricingQuantity * PriceList, MissingList), 2),
    MissingContracted = countif(MissingContracted), FilledContracted = countif(MissingContracted and PriceContracted > 0), ContractedCostAdded = round(sumif(PricingQuantity * PriceContracted, MissingContracted), 2)
// ### Columns
// Price sheet prices are per block (e.g., "100 Hours"); use them only when the unit matches the charge's PricingUnit
let block = (d: string, unit: string) { let u = extract(@'^[\d.]+\s*(.*)$', 1, d); let priceUnit = iff(isempty(u) or u startswith '/', strcat('Units', u), u); iff(tolower(trim_end('s', priceUnit)) == tolower(trim_end('s', unit)), coalesce(todouble(extract(@'^([\d.]+)', 1, d)), 1.0), real(null)) };
let costs = materialize(CostsWithSkuPriceIdv2
    | where isnotempty(SkuPriceIdv2) and (isnull(ListUnitPrice) or ListUnitPrice == 0 or isnull(ContractedUnitPrice) or ContractedUnitPrice == 0)
    | project SkuPriceIdv2, ContractId = tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId)), PricingCurrency, PricingUnit, ChargePeriodStart, PricingQuantity, ListUnitPrice, ContractedUnitPrice);
let ids = costs | distinct SkuPriceIdv2;
costs
| lookup kind=leftouter (SkuPricesWide_v1_5 | where SkuPriceId in (ids) | project SkuPriceIdv2 = SkuPriceId, ContractId, PricingCurrency, PriceList = ListUnitPrice, PriceContracted = ContractedUnitPrice, PriceUnit = x_PricingUnitDescription, PriceStart = SkuPriceEffectiveStart) on SkuPriceIdv2, ContractId, PricingCurrency
| extend PerUnit = 1.0 / block(PriceUnit, PricingUnit)
| extend PriceList = PriceList * PerUnit, PriceContracted = PriceContracted * PerUnit
// Only use a price that was in effect when the charge happened; the row has one start for all of its prices
| extend PriceList = iff(ChargePeriodStart >= PriceStart, PriceList, real(null)), PriceContracted = iff(ChargePeriodStart >= PriceStart, PriceContracted, real(null))
| extend MissingList = isnull(ListUnitPrice) or ListUnitPrice == 0, MissingContracted = isnull(ContractedUnitPrice) or ContractedUnitPrice == 0
| summarize MissingList = countif(MissingList), FilledList = countif(MissingList and PriceList > 0), ListCostAdded = round(sumif(PricingQuantity * PriceList, MissingList), 2),
    MissingContracted = countif(MissingContracted), FilledContracted = countif(MissingContracted and PriceContracted > 0), ContractedCostAdded = round(sumif(PricingQuantity * PriceContracted, MissingContracted), 2)

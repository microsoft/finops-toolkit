// SkuPrices_v1_5 (PREVIEW): FOCUS 1.5 SKU Price dataset (FOCUS PR 2424 draft) built from Prices_final_v1_2
// Run in the Ingestion database. Build-SkuPrices.ps1 runs everything below in order.
//
// Tables (full history: one row per run of months where the price didn't change):
//   SkuPrices_v1_5             One row per SkuPriceId x price type x contract x currency x run (x_UnitPriceType: List, Base, Contracted, Effective)
//   SkuPricesWide_v1_5         Comparison layout: one row per SkuPriceId x contract x currency x run, price types as columns
//                              (a new run starts when any price on the row changes)
//   SkuPrices_v1_5_runs_table  Build helper: effective start/end of every run, per price type and for the wide layout
//
// Custom columns cover FOCUS 1.5 gaps: x_UnitPriceType (no price type column), x_SkuTerm (no term on usage prices).
// Source columns that are not SKU Price columns get an x_ prefix (source SkuPriceId -> x_SkuPriceIdv1).
// Built one price type and one month at a time to stay within memory on small clusters.
// Effective dates are month-level: Prices_final_v1_2 holds one price sheet per month, not the provider's change dates.

// 1. Source rows for one price type (rows layout)
.create-or-alter function with (folder = 'FOCUS 1.5 preview', docstring = 'Prices_final_v1_2 rows for one price type with UnitPrice, ContractId, and the run key')
SkuPrices_v1_5_source(priceType: string) {
    Prices_final_v1_2
    | extend UnitPrice = case(
        priceType == 'List',       ListUnitPrice,
        priceType == 'Base',       x_BaseUnitPrice,
        priceType == 'Contracted', ContractedUnitPrice,
        priceType == 'Effective',  x_EffectiveUnitPrice,
        real(null))
    | where isnotnull(UnitPrice)
    // Savings plan rows carry only the SP rate; their list/base/contracted prices are copies of the on-demand meter's prices
    | where priceType == 'Effective' or x_SkuPriceType != 'SavingsPlan'
    // List prices are public: no contract. Everything else belongs to the agreement: EA enrollment or MCA billing account (not the billing profile)
    | extend ContractId = iff(priceType == 'List', '', tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId)))
    | extend tmp_k = hash_xxhash64(strcat(SkuPriceIdv2, '|', ContractId, '|', PricingCurrency)), tmp_M = startofmonth(x_IngestionTime), tmp_V = hash_xxhash64(tostring(UnitPrice))
}

// 2. Source rows for the wide layout (all price types as columns)
.create-or-alter function with (folder = 'FOCUS 1.5 preview', docstring = 'Prices_final_v1_2 rows for the wide layout with ContractId and the run key')
SkuPricesWide_v1_5_source() {
    Prices_final_v1_2
    // Savings plan rows carry only the SP rate; their list/base/contracted prices are copies of the on-demand meter's prices
    | extend tmp_IsSP = x_SkuPriceType == 'SavingsPlan'
    | extend
        ListUnitPrice                        = iff(tmp_IsSP, real(null), ListUnitPrice),
        ContractedUnitPrice                  = iff(tmp_IsSP, real(null), ContractedUnitPrice),
        x_BaseUnitPrice                      = iff(tmp_IsSP, real(null), x_BaseUnitPrice),
        x_ContractedUnitPriceDiscount        = iff(tmp_IsSP, real(null), x_ContractedUnitPriceDiscount),
        x_ContractedUnitPriceDiscountPercent = iff(tmp_IsSP, real(null), x_ContractedUnitPriceDiscountPercent)
    // Every row carries a contracted price, so every row belongs to the agreement
    | extend ContractId = tolower(strcat('/providers/microsoft.billing/billingaccounts/', x_BillingAccountId))
    | extend tmp_k = hash_xxhash64(strcat(SkuPriceIdv2, '|', ContractId, '|', PricingCurrency)), tmp_M = startofmonth(x_IngestionTime),
        tmp_V = hash_xxhash64(strcat(ListUnitPrice, '|', x_BaseUnitPrice, '|', ContractedUnitPrice, '|', x_EffectiveUnitPrice))
}

// 3. Runs: consecutive months with the same value for a key become one run with an effective start and end
.create-or-alter function with (folder = 'FOCUS 1.5 preview', docstring = 'Runs of unchanged values: k (key), M (month), V (value hash), Start (effective start in that month)')
SkuPrices_v1_5_runs(T: (k: long, M: datetime, V: long, Start: datetime)) {
    let hist = T | summarize hint.shufflekey = k V = take_any(V), Start = min(Start) by k, M;
    let latestMonth = toscalar(hist | summarize max(M));
    // A run starts in a month when the value differs from the previous month or the key wasn't there the previous month
    let runStarts = hist
        | join kind=leftouter hint.shufflekey = k (hist | project k, M = datetime_add('month', 1, M), PrevV = V) on k, M
        | where isnull(PrevV) or PrevV != V
        | project k, RunStart = M;
    hist
    | join kind=inner hint.shufflekey = k runStarts on k
    | where RunStart <= M
    | summarize hint.shufflekey = k RunStart = max(RunStart) by k, M, Start
    | summarize hint.shufflekey = k LastMonth = max(M), EffectiveStart = min(Start) by k, RunStart
    // Runs still in the latest month are current: no end. Others end when the next month starts.
    | extend EffectiveEnd = iff(LastMonth == latestMonth, datetime(null), datetime_add('month', 1, LastMonth))
}

.create-or-alter function with (folder = 'FOCUS 1.5 preview', docstring = 'Runs for one price type (List, Base, Contracted, Effective) or Wide, for one hash partition of keys')
SkuPrices_v1_5_runs_build(priceType: string, part: int, parts: int) {
    union
        (SkuPrices_v1_5_source(priceType) | where priceType != 'Wide' and abs(tmp_k % parts) == part | project k = tmp_k, M = tmp_M, V = tmp_V, Start = x_EffectivePeriodStart),
        (SkuPricesWide_v1_5_source() | where priceType == 'Wide' and abs(tmp_k % parts) == part | project k = tmp_k, M = tmp_M, V = tmp_V, Start = x_EffectivePeriodStart)
    | invoke SkuPrices_v1_5_runs()
    | extend x_UnitPriceType = priceType
}

// 4. Rows layout: one price type, runs that end in one month
.create-or-alter function with (folder = 'FOCUS 1.5 preview', skipvalidation = 'true', docstring = 'FOCUS 1.5 SKU Price rows for one price type and the runs that end in one month (reads SkuPrices_v1_5_runs_table)')
SkuPrices_v1_5_build(priceType: string, month: datetime) {
    let runs = SkuPrices_v1_5_runs_table | where x_UnitPriceType == priceType and LastMonth == month | project tmp_k = k, tmp_Start = EffectiveStart, tmp_End = EffectiveEnd;
    let src = SkuPrices_v1_5_source(priceType)
        | where tmp_M == month
        | lookup kind=inner runs on tmp_k
        | extend x_UnitPriceType = priceType
        // One row per key (collapses list prices repeated across billing accounts)
        | summarize hint.shufflekey = SkuPriceIdv2 take_any(*) by SkuPriceIdv2, ContractId, PricingCurrency
        | extend tmp_TierGroup = strcat(x_SkuMeterId, '|', x_SkuPriceType, '|', x_SkuTerm, '|', x_SkuOfferId, '|', ContractId, '|', PricingCurrency);
    // First time each price was seen
    let created = Prices_final_v1_2 | summarize hint.shufflekey = SkuPriceIdv2 SkuPriceCreated = min(x_IngestionTime) by SkuPriceIdv2;
    // Tier max = next tier min for the same meter and price (only meters with more than one tier)
    let tierMax = src
        | summarize Tiers = make_set(x_SkuTier) by tmp_TierGroup
        | where array_length(Tiers) > 1
        | extend Tiers = array_sort_asc(Tiers)
        | mv-expand with_itemindex = tmp_i x_SkuTier = Tiers to typeof(real)
        | extend QuantityTierMaximum = todouble(Tiers[tmp_i + 1])
        | project tmp_TierGroup, x_SkuTier, QuantityTierMaximum;
    src
    | lookup kind=leftouter tierMax on tmp_TierGroup, x_SkuTier
    | lookup kind=leftouter created on SkuPriceIdv2
    | extend x_SkuPriceIdv1 = SkuPriceId
    | extend
        PricingCurrencyCategory = 'Payable',
        PricingRegionId         = x_SkuRegion,          // Region name, not ID; best available
        PricingServiceName      = x_SkuMeterCategory,   // Meter category; price sheet has no service name
        PurchaseDurationType    = iff(ChargeCategory != 'Purchase' or isnull(x_SkuTerm), '',
                                    case(x_SkuTerm == 12, '1 Year', x_SkuTerm % 12 == 0, strcat(x_SkuTerm / 12, ' Years'), x_SkuTerm == 1, '1 Month', strcat(x_SkuTerm, ' Months'))),
        PurchasePaymentModel    = '',                   // Not in the price sheet
        QuantityTierMinimum     = coalesce(x_SkuTier, real(0)),
        ServiceProviderName     = 'Microsoft',
        SkuPriceDescription     = x_SkuDescription,
        SkuPriceEffectiveEnd    = tmp_End,              // Month after the last month with this price; empty when current
        SkuPriceEffectiveStart  = tmp_Start,            // First month with this price
        SkuPriceEligibility     = iff(priceType == 'List',
                                    dynamic({'IsGlobalScope': true}),
                                    bag_pack('IsGlobalScope', false, 'InclusionOperator', 'Or', 'Inclusions',
                                        pack_array(
                                            // Matches the account itself (EA) and every billing profile under it (MCA)
                                            bag_pack('Dimension', 'BillingAccountId', 'Operator', 'In', 'Values', pack_array(ContractId)),
                                            bag_pack('Dimension', 'BillingAccountId', 'Operator', 'StartsWith', 'Values', pack_array(strcat(ContractId, '/')))))),
        SkuPriceId              = SkuPriceIdv2,
        SkuPriceLastUpdated     = x_IngestionTime,      // Last ingestion of this price; provider date not available
        // Discount vs. list for this row's price type (replaces the 6 wide discount columns)
        x_UnitPriceDiscount        = iff(priceType == 'List', real(null), ListUnitPrice - UnitPrice),
        x_UnitPriceDiscountPercent = iff(priceType == 'List' or ListUnitPrice == 0, real(null), 100.0 * (ListUnitPrice - UnitPrice) / ListUnitPrice)
    // List rows are collapsed across billing accounts and MCA rows across billing profiles, so clear values that differ between them
    | extend tmp_IsList = priceType == 'List', tmp_IsMca = x_BillingProfileId != x_BillingAccountId
    | extend
        BillingAccountName = iff(tmp_IsList or tmp_IsMca, '', BillingAccountName),  // MCA: profile name
        x_BillingAccountId = iff(tmp_IsList, '', x_BillingAccountId),
        x_BillingProfileId = iff(tmp_IsList or tmp_IsMca, '', x_BillingProfileId)
    | project-away tmp_*, BillingAccountId,  // EA: same as ContractId; MCA: profile-level, collapsed into ContractId
        ListUnitPrice, ContractedUnitPrice, x_BaseUnitPrice, x_EffectiveUnitPrice,  // In UnitPrice + x_UnitPriceType
        x_ContractedUnitPriceDiscount, x_ContractedUnitPriceDiscountPercent, x_EffectiveUnitPriceDiscount, x_EffectiveUnitPriceDiscountPercent,
        x_TotalUnitPriceDiscount, x_TotalUnitPriceDiscountPercent,  // Replaced by x_UnitPriceDiscount(Percent)
        x_EffectivePeriodStart, x_EffectivePeriodEnd  // Replaced by SkuPriceEffectiveStart/End
    // Source columns that are not SKU Price columns become custom columns
    | project-rename
        x_BillingAccountName       = BillingAccountName,
        x_BillingCurrency          = BillingCurrency,
        x_CommitmentDiscountType   = CommitmentDiscountType,
        x_CommitmentDiscountUnit   = CommitmentDiscountUnit,
        x_PricingCategory          = PricingCategory,
        x_SkuMeter                 = SkuMeter,
        x_SkuPriceIdv2             = SkuPriceIdv2
    // All columns in alphabetical order (FOCUS columns sort before x_ columns)
    | project-reorder * asc
}

// 5. Columns layout (comparison): runs that end in one month
.create-or-alter function with (folder = 'FOCUS 1.5 preview', skipvalidation = 'true', docstring = 'FOCUS 1.5 SKU Price rows with price types as columns for the runs that end in one month (comparison layout)')
SkuPricesWide_v1_5_build(month: datetime) {
    let runs = SkuPrices_v1_5_runs_table | where x_UnitPriceType == 'Wide' and LastMonth == month | project tmp_k = k, tmp_Start = EffectiveStart, tmp_End = EffectiveEnd;
    let src = SkuPricesWide_v1_5_source()
        | where tmp_M == month
        | lookup kind=inner runs on tmp_k
        | summarize hint.shufflekey = SkuPriceIdv2 take_any(*) by SkuPriceIdv2, ContractId, PricingCurrency
        | extend tmp_TierGroup = strcat(x_SkuMeterId, '|', x_SkuPriceType, '|', x_SkuTerm, '|', x_SkuOfferId, '|', ContractId, '|', PricingCurrency);
    let created = Prices_final_v1_2 | summarize hint.shufflekey = SkuPriceIdv2 SkuPriceCreated = min(x_IngestionTime) by SkuPriceIdv2;
    let tierMax = src
        | summarize Tiers = make_set(x_SkuTier) by tmp_TierGroup
        | where array_length(Tiers) > 1
        | extend Tiers = array_sort_asc(Tiers)
        | mv-expand with_itemindex = tmp_i x_SkuTier = Tiers to typeof(real)
        | extend QuantityTierMaximum = todouble(Tiers[tmp_i + 1])
        | project tmp_TierGroup, x_SkuTier, QuantityTierMaximum;
    src
    | lookup kind=leftouter tierMax on tmp_TierGroup, x_SkuTier
    | lookup kind=leftouter created on SkuPriceIdv2
    | extend x_SkuPriceIdv1 = SkuPriceId
    | extend
        PricingCurrencyCategory = 'Payable',
        PricingRegionId         = x_SkuRegion,
        PricingServiceName      = x_SkuMeterCategory,
        PurchaseDurationType    = iff(ChargeCategory != 'Purchase' or isnull(x_SkuTerm), '',
                                    case(x_SkuTerm == 12, '1 Year', x_SkuTerm % 12 == 0, strcat(x_SkuTerm / 12, ' Years'), x_SkuTerm == 1, '1 Month', strcat(x_SkuTerm, ' Months'))),
        PurchasePaymentModel    = '',
        QuantityTierMinimum     = coalesce(x_SkuTier, real(0)),
        ServiceProviderName     = 'Microsoft',
        SkuPriceDescription     = x_SkuDescription,
        SkuPriceEffectiveEnd    = tmp_End,
        SkuPriceEffectiveStart  = tmp_Start,
        // One eligibility for the whole row, even though the list price on it is public
        SkuPriceEligibility     = bag_pack('IsGlobalScope', false, 'InclusionOperator', 'Or', 'Inclusions',
                                    pack_array(
                                        bag_pack('Dimension', 'BillingAccountId', 'Operator', 'In', 'Values', pack_array(ContractId)),
                                        bag_pack('Dimension', 'BillingAccountId', 'Operator', 'StartsWith', 'Values', pack_array(strcat(ContractId, '/'))))),
        SkuPriceId              = SkuPriceIdv2,
        SkuPriceLastUpdated     = x_IngestionTime
    | extend tmp_IsMca = x_BillingProfileId != x_BillingAccountId
    | extend
        BillingAccountName = iff(tmp_IsMca, '', BillingAccountName),
        x_BillingProfileId = iff(tmp_IsMca, '', x_BillingProfileId)
    | project-away tmp_*, BillingAccountId, x_EffectivePeriodStart, x_EffectivePeriodEnd
    | project-rename
        x_BillingAccountName     = BillingAccountName,
        x_BillingCurrency        = BillingCurrency,
        x_CommitmentDiscountType = CommitmentDiscountType,
        x_CommitmentDiscountUnit = CommitmentDiscountUnit,
        x_PricingCategory        = PricingCategory,
        x_SkuMeter               = SkuMeter,
        x_SkuPriceIdv2           = SkuPriceIdv2
    | project-reorder * asc
}

// 6. Build (Build-SkuPrices.ps1 runs these): runs per type, then each table one month (and type) at a time
.set-or-replace SkuPrices_v1_5_runs_table with (folder = 'FOCUS 1.5 preview', recreate_schema = true) <| SkuPrices_v1_5_runs_build('List', 0, 8)

.append SkuPrices_v1_5_runs_table <| SkuPrices_v1_5_runs_build('Base', 0, 8)

.append SkuPrices_v1_5_runs_table <| SkuPrices_v1_5_runs_build('Contracted', 0, 8)

.append SkuPrices_v1_5_runs_table <| SkuPrices_v1_5_runs_build('Effective', 0, 8)

.append SkuPrices_v1_5_runs_table <| SkuPrices_v1_5_runs_build('Wide', 0, 8)

// ...each partition 0-7 for each price type and Wide

.set-or-replace SkuPrices_v1_5 with (folder = 'FOCUS 1.5 preview', recreate_schema = true) <| SkuPrices_v1_5_build('List', datetime(2025-09-01))

.append SkuPrices_v1_5 <| SkuPrices_v1_5_build('Base', datetime(2025-09-01))

// ...each price type for each month in Prices_final_v1_2

.set-or-replace SkuPricesWide_v1_5 with (folder = 'FOCUS 1.5 preview', recreate_schema = true) <| SkuPricesWide_v1_5_build(datetime(2025-09-01))

.append SkuPricesWide_v1_5 <| SkuPricesWide_v1_5_build(datetime(2025-10-01))

// ...each month in Prices_final_v1_2

// 7. Costs copy with SkuPriceIdv2, so Cost and Usage can join to SkuPrices on SkuPriceId
//    Costs has no x_SkuProductId/x_SkuMeterType, so the ID is looked up from prices by price type + meter + offer + term
//    On-demand usage            -> on-demand price
//    Reservation-covered usage  -> on-demand price (Microsoft has no usage price for reservations)
//    Savings-plan-covered usage -> savings plan price for the term
//    Reservation purchase       -> reservation price for the term, only when one ID matches
//    Everything else            -> empty
.create-or-alter function with (folder = 'FOCUS 1.5 preview', docstring = 'Hash of price type + charge category + meter + offer + term, used to look up SkuPriceIdv2')
SkuPriceIdv2_key(priceType: string, chargeCategory: string, meterId: string, offerId: string, term: int) {
    hash_xxhash64(strcat(priceType, '|', chargeCategory, '|', meterId, '|', offerId, '|', coalesce(term, 0)))
}

.create-or-alter function with (folder = 'FOCUS 1.5 preview', docstring = 'SkuPriceIdv2 per lookup key, only where one ID matches')
SkuPriceIdv2_map_build() {
    Prices_final_v1_2
    | distinct x_SkuPriceType, ChargeCategory, x_SkuMeterId, x_SkuOfferId, x_SkuTerm, SkuPriceIdv2
    | summarize hint.shufflekey = x_SkuMeterId Ids = make_set(SkuPriceIdv2, 2) by k = SkuPriceIdv2_key(x_SkuPriceType, ChargeCategory, x_SkuMeterId, x_SkuOfferId, x_SkuTerm), x_SkuMeterId
    | where array_length(Ids) == 1
    | project k, SkuPriceIdv2 = tostring(Ids[0])
}

.create-or-alter function with (folder = 'FOCUS 1.5 preview', skipvalidation = 'true', docstring = 'Costs_final_v1_2 for one month with SkuPriceIdv2 (reads SkuPriceIdv2_map)')
CostsWithSkuPriceIdv2_build(month: datetime) {
    let costs = Costs_final_v1_2
        | where ChargePeriodStart >= month and ChargePeriodStart < datetime_add('month', 1, month)
        | extend tmp_PriceType = case(
            ChargeCategory == 'Usage' and CommitmentDiscountCategory == 'Spend',       'SavingsPlan',
            ChargeCategory == 'Usage',                                                  'Consumption',
            ChargeCategory == 'Purchase' and CommitmentDiscountType == 'Reservation',  'ReservedInstance',
            '')
        | extend tmp_k = SkuPriceIdv2_key(tmp_PriceType, ChargeCategory, x_SkuMeterId,
            iff(tmp_PriceType == 'ReservedInstance', '', x_SkuOfferId),
            iff(tmp_PriceType in ('SavingsPlan', 'ReservedInstance'), x_SkuTerm, int(null)));
    // Only the keys this month needs, to keep the lookup small
    let keys = costs | distinct tmp_k;
    costs
    | lookup kind=leftouter (SkuPriceIdv2_map | where k in (keys) | project tmp_k = k, SkuPriceIdv2) on tmp_k
    | project-away tmp_*
}

// Build the map, then Costs one month at a time (Build-SkuPrices.ps1 loops over every month in Costs_final_v1_2)
.set-or-replace SkuPriceIdv2_map with (folder = 'FOCUS 1.5 preview', recreate_schema = true) <| SkuPriceIdv2_map_build()

.set-or-replace CostsWithSkuPriceIdv2 with (folder = 'FOCUS 1.5 preview', recreate_schema = true) <| CostsWithSkuPriceIdv2_build(datetime(2025-09-01))

.append CostsWithSkuPriceIdv2 <| CostsWithSkuPriceIdv2_build(datetime(2025-10-01))

// ...one .append per remaining month
// Validation: Test-SkuPrices.ps1. Scenarios: SkuPrices_v1_5_scenarios.kql + Test-SkuPriceScenarios.ps1.

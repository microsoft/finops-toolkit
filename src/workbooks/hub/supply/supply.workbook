                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let ComputeFamilyUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Compute VM family quota usage\\r\\n// DESCRIPTION: Shows the latest VM family vCPU quota, usage, headroom, and utilization for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Compute/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'ComputeUsage'\\r\\n| where ResourceType =~ 'Microsoft.Compute/locations/usages'\\r\\n| where ResourceName endswith 'Family'\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| extend\\r\\n    HeadroomCores = iff(limit >= 0, limit - currentValue, real(null)),\\r\\n    PercentUsed = iff(limit > 0, round(100.0 * currentValue / limit, 1), real(null))\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    SubscriptionId = SubAccountId,\\r\\n    Location = location,\\r\\n    Family = displayName,\\r\\n    FamilyKey = ResourceName,\\r\\n    CoresUsed = currentValue,\\r\\n    CoresTotal = limit,\\r\\n    HeadroomCores,\\r\\n    PercentUsed,\\r\\n    unit,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubscriptionId asc, Location asc, FamilyKey asc\\n);\\nlet ComputeFamilyOfferStatus = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Compute VM family offer status\\r\\n// DESCRIPTION: Shows region and availability zone restrictions from the smallest VM SKU in each family.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: virtualMachines\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'ComputeResourceSku'\\r\\n| where ResourceType =~ 'virtualMachines'\\r\\n| where isnotempty(ResourceName) and isnotempty(location)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| extend\\r\\n    SubscriptionId = SubAccountId,\\r\\n    FamilyKey = tostring(x_QuotaDetails.Family),\\r\\n    Location = tolower(location),\\r\\n    Capabilities = todynamic(x_QuotaDetails.Capabilities),\\r\\n    LocationInfo = todynamic(x_QuotaDetails.LocationInfo),\\r\\n    Restrictions = todynamic(x_QuotaDetails.Restrictions)\\r\\n| where isnotempty(SubscriptionId) and isnotempty(FamilyKey)\\r\\n| mv-apply Capability = Capabilities to typeof(dynamic) on (\\r\\n    summarize RepresentativeVcpus = minif(\\r\\n        todouble(Capability.value),\\r\\n        tostring(Capability.name) =~ 'vCPUs'\\r\\n    )\\r\\n)\\r\\n| where isnotnull(RepresentativeVcpus)\\r\\n| sort by\\r\\n    SubscriptionId asc,\\r\\n    FamilyKey asc,\\r\\n    Location asc,\\r\\n    RepresentativeVcpus asc,\\r\\n    ResourceName asc\\r\\n| serialize\\r\\n| extend FamilySkuRank = row_number(\\r\\n    1,\\r\\n    SubscriptionId != prev(SubscriptionId)\\r\\n        or FamilyKey != prev(FamilyKey)\\r\\n        or Location != prev(Location)\\r\\n)\\r\\n| where FamilySkuRank == 1\\r\\n// LocationInfo carries one entry per region the SKU is offered in. Match it to\\r\\n// this row's own Location instead of blindly taking index 0, otherwise a SKU\\r\\n// available in multiple regions reports zone data from the wrong region.\\r\\n| mv-expand LocationInfoEntry = LocationInfo\\r\\n| where tolower(tostring(LocationInfoEntry.location)) == Location\\r\\n| extend\\r\\n    ZonesPresent = array_sort_asc(todynamic(LocationInfoEntry.zones)),\\r\\n    RestrictionRows = iff(array_length(Restrictions) > 0, Restrictions, dynamic([{}]))\\r\\n| mv-apply Restriction = RestrictionRows to typeof(dynamic) on (\\r\\n    summarize\\r\\n        RegionRestricted = countif(tostring(Restriction.type) =~ 'Location') > 0,\\r\\n        ZonesRestricted = make_list_if(\\r\\n            todynamic(Restriction.restrictionInfo.zones),\\r\\n            tostring(Restriction.type) =~ 'Zone'\\r\\n        )\\r\\n)\\r\\n| project\\r\\n    SubscriptionId,\\r\\n    FamilyKey,\\r\\n    Location,\\r\\n    RepresentativeSku = ResourceName,\\r\\n    RepresentativeVcpus,\\r\\n    RegionRestricted,\\r\\n    ZonesPresent,\\r\\n    ZonesRestricted,\\r\\n    x_IngestionTime\\r\\n| order by SubscriptionId asc, Location asc, FamilyKey asc\\n);\\nlet Matrix = materialize(\\nComputeFamilyUsage\\n| join kind=leftouter ComputeFamilyOfferStatus on SubscriptionId, FamilyKey, Location\\n| summarize\\n    RowLabel=take_any(Family),\\n    Used=sum(CoresUsed),\\n    Quota=sum(CoresTotal),\\n    Subscriptions=dcount(SubscriptionId),\\n    InUseSubscriptions=dcountif(SubscriptionId, CoresUsed > 0),\\n    AtLimitSubscriptions=dcountif(SubscriptionId, CoresTotal > 0 and CoresUsed >= CoresTotal),\\n    QuotaSubscriptions=dcountif(SubscriptionId, CoresTotal > 0),\\n    NoQuotaSubscriptions=dcountif(SubscriptionId, CoresTotal <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubscriptionId, CoresTotal < 0),\\n    OfferSubscriptions=dcountif(SubscriptionId, isnotempty(RepresentativeSku)),\\n    RegionRestrictedSubscriptions=dcountif(SubscriptionId, RegionRestricted),\\n    ZoneRestrictedSubscriptions=dcountif(SubscriptionId, array_length(ZonesRestricted) > 0),\\n    RepresentativeSkus=make_set_if(RepresentativeSku, isnotempty(RepresentativeSku), 100),\\n    RepresentativeVcpus=min(RepresentativeVcpus),\\n    ZonesPresent=make_list_if(ZonesPresent, array_length(ZonesPresent) > 0, 100),\\n    ZonesRestricted=make_list_if(ZonesRestricted, array_length(ZonesRestricted) > 0, 100),\\n    LatestObservation=max(x_IngestionTime),\\n    OfferObservation=max(x_IngestionTime1)\\n    by RowKey=FamilyKey, Unit=unit, Location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nlet Filtered = materialize(\\n    Matrix\\n    | extend Search=base64_decode_tostring('{SupplyComputeSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        NoQuotaSubscriptions >= Subscriptions, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        Quota <= 0 or OfferSubscriptions == 0, 'Not reported',\\n        RegionRestrictedSubscriptions > 0, 'Blocked',\\n        ZoneRestrictedSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyComputeRegion}' == '*' or Location =~ '{SupplyComputeRegion}'\\n| where '{SupplyComputeStatus}' == 'all'\\n    or ('{SupplyComputeStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyComputeStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyComputeStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyComputeHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyComputeHighWater}'), strcat('At or above ', '{SupplyComputeHighWater}', '%'),\\n        strcat('Below ', '{SupplyComputeHighWater}', '%'))\\n);\\nlet Rows = Filtered\\n| summarize Unit=take_any(Unit) by RowLabel;\\nlet Regions = Filtered\\n| summarize by Location;\\nRows\\n| extend JoinKey=1\\n| join kind=inner (Regions | extend JoinKey=1) on JoinKey\\n| project-away JoinKey\\n| join kind=leftouter (\\n    Filtered\\n    | project RowLabel, Unit, Location, UtilizationPercent\\n) on RowLabel, Unit, Location\\n| extend UtilizationPercent=coalesce(UtilizationPercent, -1.0)\\n| project ['VM family']=RowLabel, Unit, Location, UtilizationPercent\\n| evaluate pivot(Location, take_any(UtilizationPercent), ['VM family'], Unit)\\n| order by ['VM family'] asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Estate quota by VM family and region",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "^(?!VMfamily$|Unit$).+",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "-1",
                                "representation": "gray",
                                "text": "Not observed"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "100",
                                "representation": "redBright",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "90",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "80",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "0",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "gray",
                                "text": "{0}{1}"
                              }
                            ],
                            "customColumnWidthSetting": "18ch"
                          },
                          "numberFormat": {
                            "unit": 1,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 1
                            }
                          }
                        }
                      ]
                    },
                    "noDataMessage": "No Compute quota observations were ingested; deployment capacity is unknown."
                  },
                  "doNotRunWhenHidden": true,

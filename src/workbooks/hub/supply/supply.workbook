                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Required = datatable(EvidenceSource:string)\\n[\\n    'ComputeUsage',\\n    'ComputeResourceSku'\\n];\\nlet Observed = Quota()\\n| where x_SourceType in~ ('ComputeUsage', 'ComputeResourceSku')\\n| summarize\\n    Observations=count(),\\n    Resources=dcount(ResourceId),\\n    Subscriptions=dcount(SubAccountId),\\n    SnapshotDays=dcount(startofday(x_IngestionTime)),\\n    LatestObservation=max(x_IngestionTime)\\n    by EvidenceSource=x_SourceType;\\nRequired\\n| join kind=leftouter Observed on EvidenceSource\\n| extend EvidenceState=iff(coalesce(Observations, 0) == 0, 'Not reported - collection outcome unknown', 'Observed')\\n| project EvidenceSource, EvidenceState, Observations, Resources, Subscriptions, SnapshotDays, LatestObservation\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",

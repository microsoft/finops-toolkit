                                    }
                                  ]
                                }
                              },
                              {
                                "columnMatch": "SupplyStatus|OfferStatus",
                                "formatter": 18,
                                "formatOptions": {
                                  "thresholdsOptions": "colors",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Open",
                                      "representation": "green",
                                      "text": "{0}{1}"
                                    },
                                    {

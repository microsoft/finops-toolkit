                              {
                                "columnMatch": "UtilizationPercent",
                                "formatter": 8,
                                "formatOptions": {
                                  "min": 0,
                                  "max": 100,
                                  "palette": "greenRed",
                                  "customColumnWidthSetting": "18ch"
                                }
                              }
                            ]

                  "name": "d75d8289-f7ea-3be0-82fb-4ca0648743aa"
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "loadType": "lazy",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "a93c5859-15ed-3359-f457-4ecf9f4304b7",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAzureSqlSubscriptionSearch",
                              "label": "Search subscriptions",
                              "type": 1,
                              "isRequired": false,
                              "value": ""
                            },
                            {
                              "id": "b230a44b-2edb-1a16-55ab-fb32a4ff6de8",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAzureSqlSubscriptionPage",
                              "label": "Page",
                              "type": 2,
                              "isRequired": true,
                              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let ResourceSearch=base64_decode_tostring('{SupplyAzureSqlSearch:base64}');\\nlet SubscriptionSearch=base64_decode_tostring('{SupplyAzureSqlSubscriptionSearch:base64}');\\nlet AzureSqlQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: SQL subscription quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure SQL quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Sql/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'SqlSubscriptionUsage'\\r\\n| where ResourceType =~ 'Microsoft.Sql/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nAzureSqlQuotaUsage\\n| where ResourceName in~ (\\n    'RegionalVCoreQuotaForSQLDBAndDW',\\n    'ServerQuota',\\n    'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota'\\n)\\n| project SubscriptionId=SubAccountId, Region=location, RowKey=ResourceName, RowLabel=coalesce(displayName, ResourceName), Used=currentValue, Quota=limit, LatestObservation=x_IngestionTime\\n| where isempty(ResourceSearch) or RowLabel contains ResourceSearch or RowKey contains ResourceSearch\\n| where isempty(SubscriptionSearch) or SubscriptionId startswith SubscriptionSearch\\n| where '{SupplyAzureSqlStatus}' == 'all'\\n    or ('{SupplyAzureSqlStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureSqlStatus}' == 'at-limit' and Quota > 0 and Used >= Quota)\\n    or ('{SupplyAzureSqlStatus}' == 'no-quota' and Quota <= 0)\\n| where '{SupplyAzureSqlRegion}' == '*' or Region =~ '{SupplyAzureSqlRegion}'\\n| summarize\\n    ['Quota metrics']=dcount(RowKey),\\n    Regions=dcount(Region),\\n    Pairs=count(),\\n    InUse=countif(Used > 0),\\n    AtLimit=countif(Quota > 0 and Used >= Quota),\\n    NoQuota=countif(coalesce(Quota, 0.0) <= 0),\\n    LatestObservation=max(LatestObservation)\\n    by SubscriptionId\\n| order by AtLimit desc, NoQuota desc, InUse desc, SubscriptionId asc\\n| summarize TotalRows=count()\\n| extend TotalPages=max_of(1, toint(ceiling(todouble(TotalRows) / 50.0)))\\n| mv-expand Page=range(1, TotalPages, 1) to typeof(long)\\n| order by Page asc\\n| project\\n    value=tostring(Page),\\n    label=strcat('Page ', Page, ' of ', TotalPages, ' - ', TotalRows, ' rows'),\\n    selected=Page == 1\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                              "queryType": 9,
                              "typeSettings": {
                                "additionalResourceOptions": [],
                                "showDefault": false
                              }
                            }
                          ],
                          "style": "standard",
                          "queryType": 9
                        },
                        "customWidth": "100",
                        "name": "b742c9c3-694b-7d36-f6d5-f6949114d8b3"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let ResourceSearch=base64_decode_tostring('{SupplyAzureSqlSearch:base64}');\\nlet SubscriptionSearch=base64_decode_tostring('{SupplyAzureSqlSubscriptionSearch:base64}');\\nlet AzureSqlQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: SQL subscription quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure SQL quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Sql/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'SqlSubscriptionUsage'\\r\\n| where ResourceType =~ 'Microsoft.Sql/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nAzureSqlQuotaUsage\\n| where ResourceName in~ (\\n    'RegionalVCoreQuotaForSQLDBAndDW',\\n    'ServerQuota',\\n    'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota'\\n)\\n| project SubscriptionId=SubAccountId, Region=location, RowKey=ResourceName, RowLabel=coalesce(displayName, ResourceName), Used=currentValue, Quota=limit, LatestObservation=x_IngestionTime\\n| where isempty(ResourceSearch) or RowLabel contains ResourceSearch or RowKey contains ResourceSearch\\n| where isempty(SubscriptionSearch) or SubscriptionId startswith SubscriptionSearch\\n| where '{SupplyAzureSqlStatus}' == 'all'\\n    or ('{SupplyAzureSqlStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureSqlStatus}' == 'at-limit' and Quota > 0 and Used >= Quota)\\n    or ('{SupplyAzureSqlStatus}' == 'no-quota' and Quota <= 0)\\n| where '{SupplyAzureSqlRegion}' == '*' or Region =~ '{SupplyAzureSqlRegion}'\\n| summarize\\n    ['Quota metrics']=dcount(RowKey),\\n    Regions=dcount(Region),\\n    Pairs=count(),\\n    InUse=countif(Used > 0),\\n    AtLimit=countif(Quota > 0 and Used >= Quota),\\n    NoQuota=countif(coalesce(Quota, 0.0) <= 0),\\n    LatestObservation=max(LatestObservation)\\n    by SubscriptionId\\n| order by AtLimit desc, NoQuota desc, InUse desc, SubscriptionId asc\\n| serialize PageRow=row_number()\\n| extend PageNumber=coalesce(toint('{SupplyAzureSqlSubscriptionPage}'), 1)\\n| where PageRow > (PageNumber - 1) * 50\\n    and PageRow <= PageNumber * 50\\n| project-away PageRow, PageNumber\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 3,
                          "title": "Subscriptions",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {

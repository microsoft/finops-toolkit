                  "name": "126ba277-5735-3592-900c-35e953acb0eb"
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "loadType": "lazy",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "6c43513e-a828-389e-ed7f-6c2fd9691019",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAppServicePairsPage",
                              "label": "Page",
                              "type": 2,
                              "isRequired": true,
                              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AppServiceQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: App Service quota usage\\r\\n// DESCRIPTION: Rehydrates the latest App Service quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Web/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'AppServiceUsage'\\r\\n| where ResourceType =~ 'Microsoft.Web/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAppServiceQuotaUsage\\n| summarize\\n    RowLabel=take_any(iff(ResourceName == '*', 'Total Regional VMs', displayName)),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nMatrix\\n| extend Search=base64_decode_tostring('{SupplyAppServiceSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        QuotaSubscriptions == 0 and NegativeLimitSubscriptions > 0, 'Invalid',\\n        QuotaSubscriptions == 0, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        QuotaSubscriptions == 0, 'Not reported',\\n        AtLimitSubscriptions > 0, 'Blocked',\\n        NoQuotaSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyAppServiceRegion}' == '*' or Location =~ '{SupplyAppServiceRegion}'\\n| where '{SupplyAppServiceStatus}' == 'all'\\n    or ('{SupplyAppServiceStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAppServiceStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyAppServiceStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyAppServiceHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyAppServiceHighWater}'), strcat('At or above ', '{SupplyAppServiceHighWater}', '%'),\\n        strcat('Below ', '{SupplyAppServiceHighWater}', '%'))\\n| summarize TotalRows=count()\\n| extend TotalPages=max_of(1, toint(ceiling(todouble(TotalRows) / 50.0)))\\n| mv-expand Page=range(1, TotalPages, 1) to typeof(long)\\n| order by Page asc\\n| project\\n    value=tostring(Page),\\n    label=strcat('Page ', Page, ' of ', TotalPages, ' - ', TotalRows, ' rows'),\\n    selected=Page == 1\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                              "queryType": 9,
                              "typeSettings": {
                                "additionalResourceOptions": [],
                                "showDefault": false
                              }
                            }
                          ],
                          "style": "standard",
                          "queryType": 9
                        },
                        "customWidth": "100",
                        "name": "72cc2465-3f5f-44e1-e891-ec1ac0ae723d"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AppServiceQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: App Service quota usage\\r\\n// DESCRIPTION: Rehydrates the latest App Service quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Web/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'AppServiceUsage'\\r\\n| where ResourceType =~ 'Microsoft.Web/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAppServiceQuotaUsage\\n| summarize\\n    RowLabel=take_any(iff(ResourceName == '*', 'Total Regional VMs', displayName)),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nMatrix\\n| extend Search=base64_decode_tostring('{SupplyAppServiceSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        QuotaSubscriptions == 0 and NegativeLimitSubscriptions > 0, 'Invalid',\\n        QuotaSubscriptions == 0, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        QuotaSubscriptions == 0, 'Not reported',\\n        AtLimitSubscriptions > 0, 'Blocked',\\n        NoQuotaSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyAppServiceRegion}' == '*' or Location =~ '{SupplyAppServiceRegion}'\\n| where '{SupplyAppServiceStatus}' == 'all'\\n    or ('{SupplyAppServiceStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAppServiceStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyAppServiceStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyAppServiceHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyAppServiceHighWater}'), strcat('At or above ', '{SupplyAppServiceHighWater}', '%'),\\n        strcat('Below ', '{SupplyAppServiceHighWater}', '%'))\\n| project\\n    ['Plan SKU']=RowLabel,\\n    Region=Location,\\n    Used,\\n    Quota,\\n    Headroom,\\n    UtilizationPercent,\\n    Unit,\\n    Subscriptions,\\n    InUseSubscriptions,\\n    AtLimitSubscriptions,\\n    NoQuotaSubscriptions,\\n    NegativeLimitSubscriptions,\\n    QuotaStatus,\\n    SupplyStatus,\\n    HighWater,\\n    LatestObservation\\n| order by UtilizationPercent desc nulls last, ['Plan SKU'] asc, Region asc\\n| serialize PageRow=row_number()\\n| extend PageNumber=coalesce(toint('{SupplyAppServicePairsPage}'), 1)\\n| where PageRow > (PageNumber - 1) * 50\\n    and PageRow <= PageNumber * 50\\n| project-away PageRow, PageNumber\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 3,
                          "title": "Filtered sku and region detail",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "rowLimit": 50,
                            "formatters": [
                              {
                                "columnMatch": "QuotaStatus|EvidenceState",
                                "formatter": 18,
                                "formatOptions": {
                                  "thresholdsOptions": "colors",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Healthy",
                                      "representation": "green",
                                      "text": "{0}{1}"

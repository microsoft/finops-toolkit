                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Required = datatable(EvidenceSource:string)\\n[\\n    'AppServiceUsage'\\n];\\nlet Observed = Quota()\\n| where x_SourceType in~ ('AppServiceUsage')\\n| summarize\\n    Observations=count(),\\n    Resources=dcount(ResourceId),\\n    Subscriptions=dcount(SubAccountId),\\n    SnapshotDays=dcount(startofday(x_IngestionTime)),\\n    LatestObservation=max(x_IngestionTime)\\n    by EvidenceSource=x_SourceType;\\nRequired\\n| join kind=leftouter Observed on EvidenceSource\\n| extend EvidenceState=iff(coalesce(Observations, 0) == 0, 'Not reported - collection outcome unknown', 'Observed')\\n| project EvidenceSource, EvidenceState, Observations, Resources, Subscriptions, SnapshotDays, LatestObservation\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Evidence coverage",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "QuotaStatus|EvidenceState",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Healthy",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Watch",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Action",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Exhausted",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Invalid",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Stale",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {

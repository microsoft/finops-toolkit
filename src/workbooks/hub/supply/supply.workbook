                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "loadType": "lazy",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "50cad57f-a9da-8f52-e7f9-9aa87fcab0c0",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAzureAiSubscriptionSearch",
                              "label": "Search subscriptions",
                              "type": 1,
                              "isRequired": false,
                              "value": ""
                            },
                            {
                              "id": "524c1499-0d4e-bde7-912a-11e70331f4d2",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAzureAiSubscriptionPage",
                              "label": "Page",
                              "type": 2,
                              "isRequired": true,
                              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let ResourceSearch=base64_decode_tostring('{SupplyAzureAiSearch:base64}');\\nlet SubscriptionSearch=base64_decode_tostring('{SupplyAzureAiSubscriptionSearch:base64}');\\nlet AzureAiQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Azure AI services quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure AI services quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.CognitiveServices/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'CognitiveServicesUsage'\\r\\n| where ResourceType =~ 'Microsoft.CognitiveServices/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nAzureAiQuotaUsage\\n\\n| project SubscriptionId=SubAccountId, Region=location, RowKey=ResourceName, RowLabel=coalesce(displayName, ResourceName), Used=currentValue, Quota=limit, LatestObservation=x_IngestionTime\\n| where isempty(ResourceSearch) or RowLabel contains ResourceSearch or RowKey contains ResourceSearch\\n| where isempty(SubscriptionSearch) or SubscriptionId startswith SubscriptionSearch\\n| where '{SupplyAzureAiStatus}' == 'all'\\n    or ('{SupplyAzureAiStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureAiStatus}' == 'at-limit' and Quota > 0 and Used >= Quota)\\n    or ('{SupplyAzureAiStatus}' == 'no-quota' and Quota <= 0)\\n| where '{SupplyAzureAiRegion}' == '*' or Region =~ '{SupplyAzureAiRegion}'\\n| summarize\\n    ['Models']=dcount(RowKey),\\n    Regions=dcount(Region),\\n    Pairs=count(),\\n    InUse=countif(Used > 0),\\n    AtLimit=countif(Quota > 0 and Used >= Quota),\\n    NoQuota=countif(coalesce(Quota, 0.0) <= 0),\\n    LatestObservation=max(LatestObservation)\\n    by SubscriptionId\\n| order by AtLimit desc, NoQuota desc, InUse desc, SubscriptionId asc\\n| summarize TotalRows=count()\\n| extend TotalPages=max_of(1, toint(ceiling(todouble(TotalRows) / 50.0)))\\n| mv-expand Page=range(1, TotalPages, 1) to typeof(long)\\n| order by Page asc\\n| project\\n    value=tostring(Page),\\n    label=strcat('Page ', Page, ' of ', TotalPages, ' - ', TotalRows, ' rows'),\\n    selected=Page == 1\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                              "queryType": 9,
                              "typeSettings": {
                                "additionalResourceOptions": [],
                                "showDefault": false
                              }
                            }
                          ],
                          "style": "standard",
                          "queryType": 9
                        },
                        "customWidth": "100",
                        "name": "7d54078d-f595-1f7d-cda2-4b48833783cf"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let ResourceSearch=base64_decode_tostring('{SupplyAzureAiSearch:base64}');\\nlet SubscriptionSearch=base64_decode_tostring('{SupplyAzureAiSubscriptionSearch:base64}');\\nlet AzureAiQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Azure AI services quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure AI services quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.CognitiveServices/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'CognitiveServicesUsage'\\r\\n| where ResourceType =~ 'Microsoft.CognitiveServices/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nAzureAiQuotaUsage\\n\\n| project SubscriptionId=SubAccountId, Region=location, RowKey=ResourceName, RowLabel=coalesce(displayName, ResourceName), Used=currentValue, Quota=limit, LatestObservation=x_IngestionTime\\n| where isempty(ResourceSearch) or RowLabel contains ResourceSearch or RowKey contains ResourceSearch\\n| where isempty(SubscriptionSearch) or SubscriptionId startswith SubscriptionSearch\\n| where '{SupplyAzureAiStatus}' == 'all'\\n    or ('{SupplyAzureAiStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureAiStatus}' == 'at-limit' and Quota > 0 and Used >= Quota)\\n    or ('{SupplyAzureAiStatus}' == 'no-quota' and Quota <= 0)\\n| where '{SupplyAzureAiRegion}' == '*' or Region =~ '{SupplyAzureAiRegion}'\\n| summarize\\n    ['Models']=dcount(RowKey),\\n    Regions=dcount(Region),\\n    Pairs=count(),\\n    InUse=countif(Used > 0),\\n    AtLimit=countif(Quota > 0 and Used >= Quota),\\n    NoQuota=countif(coalesce(Quota, 0.0) <= 0),\\n    LatestObservation=max(LatestObservation)\\n    by SubscriptionId\\n| order by AtLimit desc, NoQuota desc, InUse desc, SubscriptionId asc\\n| serialize PageRow=row_number()\\n| extend PageNumber=coalesce(toint('{SupplyAzureAiSubscriptionPage}'), 1)\\n| where PageRow > (PageNumber - 1) * 50\\n    and PageRow <= PageNumber * 50\\n| project-away PageRow, PageNumber\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 3,
                          "title": "Subscriptions",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "rowLimit": 50
                          },
                          "noDataMessage": "No subscriptions match the selected status and region."
                        },
                        "doNotRunWhenHidden": true,
                        "customWidth": "100",
                        "name": "a00e17e5-9c52-6ec5-c89f-ffb5cc9965b5"
                      }
                    ]

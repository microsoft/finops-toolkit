                  "type": 1,
                  "content": {
                    "json": "### Azure SQL subscription quota and counters\n\nOnly the five supported regional quota metrics are included. Negative limits remain explicit and non-comparable.\n\n**Evidence:** Provider-reported SQL quota - point-in-time\n\n**Next action:** Use the exact SQL metric and service workflow. Validate region and zone-redundant access separately."
                  },
                  "customWidth": "100",
                  "name": "a75ad98a-6136-2a92-19bb-0e11ab566eb4"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "b21385b8-d5a4-6e7d-f75f-9fe9dff8dc79",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureSqlSearch",
                        "label": "Search",
                        "type": 1,
                        "isRequired": false,
                        "value": ""
                      },
                      {
                        "id": "b0bd2db9-3571-ff48-2040-6cc56c612a88",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureSqlStatus",
                        "label": "Show",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"datatable(value:string, label:string, selected:bool)\\n[\\n    'all', 'All', true,\\n    'in-use', 'In use', false,\\n    'at-limit', 'At limit', false,\\n    'no-quota', 'No quota', false\\n]\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "330c5cdc-f765-503a-1ebe-d68e98d30dd9",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureSqlRegion",
                        "label": "Region",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureSqlQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: SQL subscription quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure SQL quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Sql/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'SqlSubscriptionUsage'\\r\\n| where ResourceType =~ 'Microsoft.Sql/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureSqlQuotaUsage\\n| where ResourceName in~ (\\n    'RegionalVCoreQuotaForSQLDBAndDW',\\n    'ServerQuota',\\n    'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota'\\n)\\n| extend RowLabel=case(\\n    ResourceName =~ 'RegionalVCoreQuotaForSQLDBAndDW', 'Azure SQL Database and Synapse vCores',\\n    ResourceName =~ 'ServerQuota', 'Logical servers',\\n    ResourceName =~ 'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota', 'SQL MI standard-series vCores',\\n    ResourceName =~ 'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota', 'SQL MI premium-series vCores',\\n    ResourceName =~ 'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota', 'SQL MI memory-optimized premium vCores',\\n    ResourceName)\\n| summarize\\n    RowLabel=take_any(RowLabel),\\n    Used=sumif(currentValue, limit > 0),\\n    Quota=sumif(limit, limit > 0),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nMatrix\\n| summarize by value=tolower(Location)\\n| extend label=value, selected=false\\n| union (print value='*', label='All regions', selected=true)\\n| extend Sort=iff(value == '*', 0, 1)\\n| order by Sort asc, label asc\\n| project value, label, selected\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "6da02d13-a283-c364-5791-359b1d57bb80",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureSqlHighWater",
                        "label": "High-water mark",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"datatable(value:string, label:string, selected:bool)\\n[\\n    '60', '60%', false,\\n    '70', '70%', true,\\n    '80', '80%', false,\\n    '90', '90%', false\\n]\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "8009a3b9-aa89-b6c8-34ad-eb1d5ad91a17",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureSqlDetail",
                        "type": 1,
                        "isRequired": false,
                        "value": "pairs",
                        "isHiddenWhenLocked": true
                      }
                    ],
                    "style": "standard",
                    "queryType": 9
                  },
                  "customWidth": "100",
                  "name": "e6891fbe-040c-110b-3bfe-f13a2102773f"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureSqlQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: SQL subscription quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure SQL quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Sql/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'SqlSubscriptionUsage'\\r\\n| where ResourceType =~ 'Microsoft.Sql/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureSqlQuotaUsage\\n| where ResourceName in~ (\\n    'RegionalVCoreQuotaForSQLDBAndDW',\\n    'ServerQuota',\\n    'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota'\\n)\\n| extend RowLabel=case(\\n    ResourceName =~ 'RegionalVCoreQuotaForSQLDBAndDW', 'Azure SQL Database and Synapse vCores',\\n    ResourceName =~ 'ServerQuota', 'Logical servers',\\n    ResourceName =~ 'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota', 'SQL MI standard-series vCores',\\n    ResourceName =~ 'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota', 'SQL MI premium-series vCores',\\n    ResourceName =~ 'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota', 'SQL MI memory-optimized premium vCores',\\n    ResourceName)\\n| summarize\\n    RowLabel=take_any(RowLabel),\\n    Used=sumif(currentValue, limit > 0),\\n    Quota=sumif(limit, limit > 0),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nunion\\n    (Matrix | summarize Value=count() | extend Sort=1, Metric='Quota-region pairs'),\\n    (Matrix | summarize Value=countif(Used > 0) | extend Sort=2, Metric='In use'),\\n    (Matrix | summarize Value=countif(AtLimitSubscriptions > 0) | extend Sort=3, Metric='At limit'),\\n    (Matrix | summarize Value=countif(NoQuotaSubscriptions >= Subscriptions) | extend Sort=4, Metric='No quota')\\n| order by Sort asc\\n| project Metric, Value\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Azure SQL subscription quota and counters summary",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false,
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Metric",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "Value",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "style": "decimal",
                            "maximumFractionDigits": 1,
                            "maximumSignificantDigits": 4
                          }
                        }
                      },
                      "showBorder": false,
                      "rowLimit": 6,
                      "size": "auto"
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "4e495b43-ca41-abe5-3b87-99eb1da55921"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureSqlQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: SQL subscription quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure SQL quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Sql/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'SqlSubscriptionUsage'\\r\\n| where ResourceType =~ 'Microsoft.Sql/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureSqlQuotaUsage\\n| where ResourceName in~ (\\n    'RegionalVCoreQuotaForSQLDBAndDW',\\n    'ServerQuota',\\n    'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota',\\n    'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota'\\n)\\n| extend RowLabel=case(\\n    ResourceName =~ 'RegionalVCoreQuotaForSQLDBAndDW', 'Azure SQL Database and Synapse vCores',\\n    ResourceName =~ 'ServerQuota', 'Logical servers',\\n    ResourceName =~ 'SubscriptionSQLManagedInstanceStandardSeriesVCoreQuota', 'SQL MI standard-series vCores',\\n    ResourceName =~ 'SubscriptionSQLManagedInstancePremiumSeriesVCoreQuota', 'SQL MI premium-series vCores',\\n    ResourceName =~ 'SubscriptionSQLManagedInstancePremiumSeriesMemoryOptimizedVCoreQuota', 'SQL MI memory-optimized premium vCores',\\n    ResourceName)\\n| summarize\\n    RowLabel=take_any(RowLabel),\\n    Used=sumif(currentValue, limit > 0),\\n    Quota=sumif(limit, limit > 0),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nlet Filtered = materialize(\\n    Matrix\\n    | extend Search=base64_decode_tostring('{SupplyAzureSqlSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        QuotaSubscriptions == 0 and NegativeLimitSubscriptions > 0, 'Invalid',\\n        QuotaSubscriptions == 0, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        QuotaSubscriptions == 0, 'Not reported',\\n        AtLimitSubscriptions > 0, 'Blocked',\\n        NoQuotaSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyAzureSqlRegion}' == '*' or Location =~ '{SupplyAzureSqlRegion}'\\n| where '{SupplyAzureSqlStatus}' == 'all'\\n    or ('{SupplyAzureSqlStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureSqlStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyAzureSqlStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyAzureSqlHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyAzureSqlHighWater}'), strcat('At or above ', '{SupplyAzureSqlHighWater}', '%'),\\n        strcat('Below ', '{SupplyAzureSqlHighWater}', '%'))\\n);\\nlet Rows = Filtered\\n| summarize Unit=take_any(Unit) by RowLabel;\\nlet Regions = Filtered\\n| summarize by Location;\\nRows\\n| extend JoinKey=1\\n| join kind=inner (Regions | extend JoinKey=1) on JoinKey\\n| project-away JoinKey\\n| join kind=leftouter (\\n    Filtered\\n    | project RowLabel, Unit, Location, UtilizationPercent\\n) on RowLabel, Unit, Location\\n| extend UtilizationPercent=coalesce(UtilizationPercent, -1.0)\\n| project ['Azure SQL quota']=RowLabel, Unit, Location, UtilizationPercent\\n| evaluate pivot(Location, take_any(UtilizationPercent), ['Azure SQL quota'], Unit)\\n| order by ['Azure SQL quota'] asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Estate quota by Azure SQL metric and region",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "^(?!AzureSQLquota$|Unit$).+",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "-1",
                                "representation": "gray",
                                "text": "Not observed"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "100",
                                "representation": "redBright",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "90",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "80",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "0",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "gray",
                                "text": "{0}{1}"
                              }
                            ],
                            "customColumnWidthSetting": "18ch"
                          },
                          "numberFormat": {
                            "unit": 1,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 1
                            }
                          }
                        }
                      ]
                    },
                    "noDataMessage": "No Azure SQL subscription-usage observations were ingested; SQL quota posture is unknown."
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "71cdc844-1a33-4478-fdc1-94099f8293ea"
                },
                {
                  "type": 11,
                  "content": {
                    "version": "LinkItem/1.0",
                    "style": "tabs",
                    "links": [

            "name": "4fd1a07b-5ddb-0a8e-6d6c-3683682d51aa"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "lazy",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "### Premium SSD v2 disks\n\nReview provisioned Premium SSD v2 GiB independently from quota, availability, and matched cost.\n\n**Evidence:** Observed Premium SSD v2 provisioned size - GiB inventory; no quota limit\n\n**Next action:** Inspect disk zone, attachment, IOPS, throughput, and service quota separately; observed GiB is inventory, not quota."
                  },
                  "customWidth": "100",
                  "name": "938770ce-4189-0ec7-8b10-f152faff3342"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "8d6ecefd-68f6-e953-5269-6258c0c66beb",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyPremiumSsdV2QuotaSeries",
                        "label": "Inventory series",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Premium SSD v2 disks\\r\\n// DESCRIPTION: Rehydrates the latest Premium SSD v2 disk inventory for each subscription.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Compute/disks\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n// NOTES:\\r\\n// - Premium SSD v2 disks are inventory observations. currentValue contains disk size in GiB, and limit may be empty.\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\r\\n| where ResourceType =~ 'Microsoft.Compute/disks'\\r\\n| where isnotempty(ResourceName) and displayName =~ 'PremiumV2_LRS'\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nCurrent\\n| order by SubAccountId asc, location asc, ResourceName asc\\n| serialize\\n| extend\\n    value=base64_encode_tostring(strcat(\\n        ResourceId, '|||',\\n        SubAccountId, '|||',\\n        location, '|||',\\n        ResourceName, '|||',\\n        unit, '|||',\\n        x_SourceVersion)),\\n    label=strcat(coalesce(displayName, ResourceName), ' | ', SubAccountId, ' | ', coalesce(location, 'global')),\\n    selected=row_number() == 1\\n| project value, label, selected\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "06a8bd09-65e9-418c-21c0-d46730f89fe6",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyPremiumSsdV2DemandSeries",
                        "label": "Matched cost series",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Premium SSD v2 disks\\r\\n// DESCRIPTION: Rehydrates the latest Premium SSD v2 disk inventory for each subscription.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Compute/disks\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n// NOTES:\\r\\n// - Premium SSD v2 disks are inventory observations. currentValue contains disk size in GiB, and limit may be empty.\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\r\\n| where ResourceType =~ 'Microsoft.Compute/disks'\\r\\n| where isnotempty(ResourceName) and displayName =~ 'PremiumV2_LRS'\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Inventory = Current\\n| extend JoinResourceId=tolower(ResourceId)\\n| project JoinResourceId, InventoryResourceId=ResourceId, ResourceName, SubAccountId, location, SizeGiB=currentValue;\\nlet Billed = Costs()\\n| where ChargePeriodStart >= startofday(now() - 430d)\\n| where ProviderName =~ 'Microsoft' and ChargeCategory =~ 'Usage'\\n| where x_ResourceType =~ 'microsoft.compute/disks'\\n| extend JoinResourceId=tolower(ResourceId)\\n| summarize EffectiveCost=sum(EffectiveCost)\\n    by JoinResourceId, ResourceId, x_SkuMeterCategory, x_SkuMeterSubcategory, SkuMeter, SkuPriceId, BillingCurrency;\\nInventory\\n| join kind=leftouter Billed on JoinResourceId\\n| order by InventoryResourceId asc, BillingCurrency asc\\n| serialize\\n| extend\\n    value=base64_encode_tostring(strcat(\\n        InventoryResourceId, '|||',\\n        x_SkuMeterCategory, '|||',\\n        x_SkuMeterSubcategory, '|||',\\n        SkuMeter, '|||',\\n        SkuPriceId, '|||',\\n        BillingCurrency)),\\n    label=strcat(ResourceName, ' | ', coalesce(SkuMeter, 'No matched meter'), ' | ', coalesce(BillingCurrency, 'No currency')),\\n    selected=row_number() == 1\\n| project value, label, selected\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      }
                    ],
                    "style": "standard",
                    "queryType": 9
                  },
                  "customWidth": "100",
                  "name": "84878946-1105-007f-ce38-e68b554fd4d2"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Premium SSD v2 disks\\r\\n// DESCRIPTION: Rehydrates the latest Premium SSD v2 disk inventory for each subscription.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Compute/disks\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n// NOTES:\\r\\n// - Premium SSD v2 disks are inventory observations. currentValue contains disk size in GiB, and limit may be empty.\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\r\\n| where ResourceType =~ 'Microsoft.Compute/disks'\\r\\n| where isnotempty(ResourceName) and displayName =~ 'PremiumV2_LRS'\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Coverage = Quota()\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\n| summarize Observations=count(), SnapshotDays=dcount(startofday(x_IngestionTime));\\nlet CurrentSummary = Current\\n| summarize ResourceKeys=count(), Stale=countif(datetime_diff('hour', now(), x_IngestionTime) > 48);\\nunion\\n    (Coverage | project Sort=1, Metric='Observations', Value=Observations),\\n    (Coverage | project Sort=2, Metric='Snapshot days', Value=SnapshotDays),\\n    (CurrentSummary | project Sort=3, Metric='Current resource keys', Value=ResourceKeys),\\n    (CurrentSummary | project Sort=4, Metric='Stale', Value=Stale)\\n| order by Sort asc\\n| project Metric, Value\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Premium SSD v2 disks summary",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false,
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Metric",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "Value",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "style": "decimal",
                            "maximumFractionDigits": 1,
                            "maximumSignificantDigits": 4
                          }
                        }
                      },
                      "showBorder": false,
                      "rowLimit": 6,
                      "size": "auto"
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "6f105800-fe8e-62bd-6701-89ecd22273d3"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Premium SSD v2 disks\\r\\n// DESCRIPTION: Rehydrates the latest Premium SSD v2 disk inventory for each subscription.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Compute/disks\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n// NOTES:\\r\\n// - Premium SSD v2 disks are inventory observations. currentValue contains disk size in GiB, and limit may be empty.\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\r\\n| where ResourceType =~ 'Microsoft.Compute/disks'\\r\\n| where isnotempty(ResourceName) and displayName =~ 'PremiumV2_LRS'\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nCurrent\\n| extend\\n    CurrentValue=todouble(currentValue),\\n    LimitValue=todouble(limit),\\n    AgeHours=round(todouble(datetime_diff('minute', now(), x_IngestionTime)) / 60.0, 1)\\n| extend EvidenceState=case(\\n        AgeHours > 48, 'Stale',\\n        'premium-ssd-v2' == 'premium-ssd-v2' and (isnull(CurrentValue) or CurrentValue < 0), 'Invalid',\\n        'Observed inventory')\\n| project\\n    Subscription=SubAccountId,\\n    Region=location,\\n    Resource=coalesce(displayName, ResourceName),\\n    SizeGiB=CurrentValue,\\n    Limit=iff(true, real(null), LimitValue),\\n    Unit=iff('premium-ssd-v2' == 'premium-ssd-v2', 'GiB', unit),\\n    EvidenceState,\\n    AgeHours,\\n    LatestObservation=x_IngestionTime,\\n    ResourceId=ResourceId\\n| order by Subscription asc, Region asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Current inventory",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "QuotaStatus|EvidenceState",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Healthy",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Watch",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Action",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Exhausted",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Invalid",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Stale",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "No quota",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Observed",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Observed inventory",
                                "representation": "blue",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Unknown or unclassified",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Not reported - collection outcome unknown",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "gray",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "noDataMessage": "No Premium SSD v2 disks were observed; this is not a disk quota or regional availability conclusion."
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "bbf95fc7-77bd-610b-3220-6ab20da0a752"
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "loadType": "always",
                    "items": [
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Selection=split(base64_decode_tostring('{SupplyPremiumSsdV2QuotaSeries}'), '|||');\\nlet SelectedResourceId=tostring(Selection[0]);\\nlet SelectedSubscription=tostring(Selection[1]);\\nlet SelectedRegion=tostring(Selection[2]);\\nlet SelectedResourceName=tostring(Selection[3]);\\nlet SelectedUnit=tostring(Selection[4]);\\nlet SelectedSourceVersion=tostring(Selection[5]);\\nlet History = Quota()\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\n| where isnotempty(SelectedResourceId)\\n| where ResourceId =~ SelectedResourceId\\n| where SubAccountId =~ SelectedSubscription\\n| where location =~ SelectedRegion\\n| where ResourceName =~ SelectedResourceName\\n| where unit =~ SelectedUnit\\n| where x_SourceVersion =~ SelectedSourceVersion\\n| extend Day=startofday(x_IngestionTime)\\n| summarize arg_max(x_IngestionTime, *) by Day, ResourceId;\\nlet SnapshotDays=toscalar(History | summarize dcount(Day));\\nHistory\\n| extend HistoryMode=case(\\n    SnapshotDays == 1, 'Collecting history - trends are disabled',\\n    true, 'Observed inventory history - runway is not applicable',\\n    SnapshotDays == 2, 'Observed delta - insufficient trend points',\\n    SnapshotDays < 7, 'Provisional trend - low confidence',\\n    'Compatible daily history')\\n| project\\n    Day,\\n    SizeGiB=currentValue,\\n    Limit=iff(true, real(null), limit),\\n    Unit=iff('premium-ssd-v2' == 'premium-ssd-v2', 'GiB', unit),\\n    HistoryMode,\\n    Ingested=x_IngestionTime\\n| order by Day asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 2,
                          "title": "Observed history",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "rowLimit": 10000,
                            "formatters": [
                              {
                                "columnMatch": "HistoryMode",
                                "formatter": 18,
                                "formatOptions": {
                                  "thresholdsOptions": "colors",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Compatible daily history",
                                      "representation": "green",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Provisional trend - low confidence",
                                      "representation": "yellow",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Observed delta - insufficient trend points",
                                      "representation": "yellow",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Collecting history - trends are disabled",
                                      "representation": "gray",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Observed inventory history - runway is not applicable",
                                      "representation": "blue",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "Default",
                                      "thresholdValue": null,
                                      "representation": "gray",
                                      "text": "{0}{1}"
                                    }
                                  ]
                                }
                              }
                            ]
                          },
                          "noDataMessage": "Select an exact source key with compatible observations to view history."
                        },
                        "doNotRunWhenHidden": true,
                        "customWidth": "50",
                        "name": "b427cb9f-ede9-ef00-2e7d-138c1e6b2260"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Premium SSD v2 disks\\r\\n// DESCRIPTION: Rehydrates the latest Premium SSD v2 disk inventory for each subscription.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Compute/disks\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n// NOTES:\\r\\n// - Premium SSD v2 disks are inventory observations. currentValue contains disk size in GiB, and limit may be empty.\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\r\\n| where ResourceType =~ 'Microsoft.Compute/disks'\\r\\n| where isnotempty(ResourceName) and displayName =~ 'PremiumV2_LRS'\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nCurrent\\n| summarize\\n    ObservedObjects=count(),\\n    ObservedGiB=sum(todouble(currentValue)),\\n    LatestObservation=max(x_IngestionTime)\\n    by Subscription=SubAccountId, Region=coalesce(location, 'global')\\n| extend Cell=strcat(round(ObservedGiB, 1), ' GiB | Observed inventory')\\n| project Subscription, Region, Cell\\n| evaluate pivot(Region, take_any(Cell), Subscription)\\n| order by Subscription asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 2,
                          "title": "Subscription x region",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "rowLimit": 10000
                          }
                        },
                        "doNotRunWhenHidden": true,
                        "customWidth": "50",
                        "name": "51a6d6b7-758d-c6cb-484c-ffc4ffe1d670"
                      }
                    ]
                  },
                  "customWidth": "100",
                  "name": "5c8ad971-66ea-9d1b-6ccb-6ad1866d77ce"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Selection=split(base64_decode_tostring('{SupplyPremiumSsdV2DemandSeries}'), '|||');\\nlet SelectedResourceId=tostring(Selection[0]);\\nlet SelectedCategory=tostring(Selection[1]);\\nlet SelectedSubcategory=tostring(Selection[2]);\\nlet SelectedMeter=tostring(Selection[3]);\\nlet SelectedPriceId=tostring(Selection[4]);\\nlet SelectedCurrency=tostring(Selection[5]);\\nCosts()\\n| where ChargePeriodStart >= startofday(now() - 430d)\\n| where ProviderName =~ 'Microsoft' and ChargeCategory =~ 'Usage'\\n| where x_ResourceType =~ 'microsoft.compute/disks'\\n| where isnotempty(SelectedResourceId)\\n| where ResourceId =~ SelectedResourceId\\n| where x_SkuMeterCategory =~ SelectedCategory\\n| where x_SkuMeterSubcategory =~ SelectedSubcategory\\n| where SkuMeter =~ SelectedMeter\\n| where SkuPriceId =~ SelectedPriceId\\n| where BillingCurrency =~ SelectedCurrency\\n| summarize EffectiveCost=sum(EffectiveCost), Rows=count()\\n    by Day=startofday(ChargePeriodStart), ResourceId, SkuMeter, BillingCurrency\\n| project Day, ResourceId, SkuMeter, EffectiveCost, BillingCurrency, Rows\\n| order by Day asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 2,
                    "title": "Parallel matched cost",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000
                    },
                    "noDataMessage": "Select one exact meter, unit, price, and currency series. Quota and billed demand are never combined."
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "327293f8-5988-0016-69af-355adf1c74da"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"Quota()\\n| where x_SourceType =~ 'PremiumSSDv2Disk'\\n| summarize\\n    Observations=count(),\\n    Resources=dcount(ResourceId),\\n    Subscriptions=dcount(SubAccountId),\\n    SnapshotDays=dcount(startofday(x_IngestionTime)),\\n    LatestObservation=max(x_IngestionTime)\\n| extend EvidenceState=iff(Observations == 0, 'Not reported - collection outcome unknown', 'Observed')\\n| project EvidenceState, Observations, Resources, Subscriptions, SnapshotDays, LatestObservation\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Evidence coverage",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "QuotaStatus|EvidenceState",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Healthy",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Watch",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Action",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Exhausted",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Invalid",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Stale",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },

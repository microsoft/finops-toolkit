            "name": "ca5e8afc-2792-8fbc-7daa-b0d4b54538b8"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "lazy",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "Select a row to open that Supply class. Evidence is independent; missing observations remain unknown."
                  },
                  "customWidth": "100",
                  "name": "f4c2b7ea-7c91-85b9-4c73-aa1f2590754d"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Registry = datatable(\\n    ClassId:string,\\n    QuotaArea:string,\\n    EvidenceType:string,\\n    SourceType:string,\\n    SourceNote:string,\\n    EmptyState:string\\n)\\n[\\n    'app-service', 'App Service quota', 'Provider metric', 'AppServiceUsage', 'Provider-reported App Service quota - point-in-time', 'No App Service quota observations were ingested; this does not mean zero usage or unlimited capacity.',\\n    'azure-ai', 'Azure AI quota pools', 'Provider metric', 'CognitiveServicesUsage', 'Provider-reported Azure AI quota - point-in-time', 'No Azure AI quota observations were ingested; check query coverage and provider access.',\\n    'compute', 'Compute quota', 'Provider metric', 'ComputeUsage', 'Provider-reported compute quota - point-in-time', 'No Compute quota observations were ingested; deployment capacity is unknown.',\\n    'azure-sql', 'Azure SQL subscription quota and counters', 'Provider metric', 'SqlSubscriptionUsage', 'Provider-reported SQL quota - point-in-time', 'No Azure SQL subscription-usage observations were ingested; SQL quota posture is unknown.',\\n    'storage', 'Storage quotas', 'Provider metric', 'StorageUsage', 'Provider-reported storage quota - point-in-time', 'No Storage quota was reported. Validate ingestion, permissions, supported regions, and source execution.',\\n    'capacity-reservations', 'Capacity reservation groups', 'Inventory', 'CapacityReservation', 'Capacity reservation group observed - inventory only', 'No capacity reservation groups were observed; absence is unverified without a complete snapshot.',\\n    'premium-ssd-v2', 'Premium SSD v2 disks', 'Inventory', 'PremiumSSDv2Disk', 'Observed Premium SSD v2 provisioned size - GiB inventory; no quota limit', 'No Premium SSD v2 disks were observed; this is not a disk quota or regional availability conclusion.'\\n];\\nlet Observed = Quota()\\n| where x_SourceType in~ (\\n    'AppServiceUsage',\\n    'CognitiveServicesUsage',\\n    'ComputeUsage',\\n    'SqlSubscriptionUsage',\\n    'StorageUsage',\\n    'CapacityReservation',\\n    'PremiumSSDv2Disk'\\n)\\n| summarize\\n    Observations=count(),\\n    Resources=dcount(ResourceId),\\n    Subscriptions=dcount(SubAccountId),\\n    SnapshotDays=dcount(startofday(x_IngestionTime)),\\n    LatestObservation=max(x_IngestionTime)\\n    by SourceType=x_SourceType;\\nRegistry\\n| join kind=leftouter Observed on SourceType\\n| extend\\n    EvidenceState=iff(coalesce(Observations, 0) == 0, 'Not reported - collection outcome unknown', 'Observed'),\\n    Observations=iff(coalesce(Observations, 0) == 0, long(null), Observations),\\n    Resources=iff(coalesce(Resources, 0) == 0, long(null), Resources),\\n    Subscriptions=iff(coalesce(Subscriptions, 0) == 0, long(null), Subscriptions),\\n    SnapshotDays=iff(coalesce(SnapshotDays, 0) == 0, long(null), SnapshotDays)\\n| project QuotaArea, EvidenceType, EvidenceState, Observations, Resources, Subscriptions, SnapshotDays, LatestObservation, SourceNote, EmptyState, ClassId\\n| order by EvidenceType asc, QuotaArea asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Quota coverage",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "QuotaStatus|EvidenceState",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Healthy",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Watch",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Action",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Exhausted",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Invalid",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Stale",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "No quota",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Observed",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Observed inventory",
                                "representation": "blue",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Unknown or unclassified",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Not reported - collection outcome unknown",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "gray",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "noDataMessage": "Supply coverage is unavailable.",
                    "exportFieldName": "ClassId",
                    "exportParameterName": "SelectedSupplyTab",
                    "exportDefaultValue": "home"
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "40d00b09-4619-f2de-dbc5-d2074c71a45a"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "SelectedSupplyTab",
              "comparison": "isEqualTo",
              "value": "home"
            },
            "name": "32112b62-d48a-c6d4-714c-99deda23e099"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "lazy",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "### App Service quota\n\nProvider-reported App Service instance usage, quota, and headroom. Total Regional VMs and the selected SKU both constrain deployment.\n\n**Evidence:** Provider-reported App Service quota - point-in-time\n\n**Next action:** Validate region access and SKU availability separately before requesting an exact SKU quota increase."
                  },
                  "customWidth": "100",
                  "name": "94b37cc0-bf0f-6530-3de3-438f87ca1288"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "6ca170aa-c738-c62c-2992-c4f93471316b",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAppServiceSearch",
                        "label": "Search",
                        "type": 1,
                        "isRequired": false,
                        "value": ""
                      },
                      {
                        "id": "fb9c45a1-5c3b-bdda-7314-c350111ea4aa",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAppServiceStatus",
                        "label": "Show",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"datatable(value:string, label:string, selected:bool)\\n[\\n    'all', 'All', true,\\n    'in-use', 'In use', false,\\n    'at-limit', 'At limit', false,\\n    'no-quota', 'No quota', false\\n]\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "e610fe29-4bc3-0c37-9bdb-3df99a93298b",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAppServiceRegion",
                        "label": "Region",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AppServiceQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: App Service quota usage\\r\\n// DESCRIPTION: Rehydrates the latest App Service quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Web/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'AppServiceUsage'\\r\\n| where ResourceType =~ 'Microsoft.Web/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAppServiceQuotaUsage\\n| summarize\\n    RowLabel=take_any(iff(ResourceName == '*', 'Total Regional VMs', displayName)),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nMatrix\\n| summarize by value=tolower(Location)\\n| extend label=value, selected=false\\n| union (print value='*', label='All regions', selected=true)\\n| extend Sort=iff(value == '*', 0, 1)\\n| order by Sort asc, label asc\\n| project value, label, selected\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "7b1c958a-b7ff-258e-1d84-be8fa4986c44",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAppServiceHighWater",
                        "label": "High-water mark",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"datatable(value:string, label:string, selected:bool)\\n[\\n    '60', '60%', false,\\n    '70', '70%', true,\\n    '80', '80%', false,\\n    '90', '90%', false\\n]\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "7c2009c6-d901-b194-2a66-6fe37134e886",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAppServiceDetail",
                        "type": 1,
                        "isRequired": false,
                        "value": "pairs",
                        "isHiddenWhenLocked": true
                      }
                    ],
                    "style": "standard",
                    "queryType": 9
                  },
                  "customWidth": "100",
                  "name": "f7fa94f2-78dd-3bec-2423-c1494a627e68"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AppServiceQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: App Service quota usage\\r\\n// DESCRIPTION: Rehydrates the latest App Service quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Web/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'AppServiceUsage'\\r\\n| where ResourceType =~ 'Microsoft.Web/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAppServiceQuotaUsage\\n| summarize\\n    RowLabel=take_any(iff(ResourceName == '*', 'Total Regional VMs', displayName)),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nunion\\n    (Matrix | summarize Value=count() | extend Sort=1, Metric='SKU-region pairs'),\\n    (Matrix | summarize Value=countif(Used > 0) | extend Sort=2, Metric='In use'),\\n    (Matrix | summarize Value=countif(AtLimitSubscriptions > 0) | extend Sort=3, Metric='At limit'),\\n    (Matrix | summarize Value=countif(NoQuotaSubscriptions >= Subscriptions) | extend Sort=4, Metric='No quota')\\n| order by Sort asc\\n| project Metric, Value\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "App Service quota summary",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false,
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Metric",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "Value",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "style": "decimal",
                            "maximumFractionDigits": 1,
                            "maximumSignificantDigits": 4
                          }
                        }
                      },
                      "showBorder": false,
                      "rowLimit": 6,
                      "size": "auto"
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "f1c23ab0-bbe2-2dbf-30bc-c451810e89bb"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AppServiceQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: App Service quota usage\\r\\n// DESCRIPTION: Rehydrates the latest App Service quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Web/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'AppServiceUsage'\\r\\n| where ResourceType =~ 'Microsoft.Web/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAppServiceQuotaUsage\\n| summarize\\n    RowLabel=take_any(iff(ResourceName == '*', 'Total Regional VMs', displayName)),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nlet Filtered = materialize(\\n    Matrix\\n    | extend Search=base64_decode_tostring('{SupplyAppServiceSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        QuotaSubscriptions == 0 and NegativeLimitSubscriptions > 0, 'Invalid',\\n        QuotaSubscriptions == 0, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        QuotaSubscriptions == 0, 'Not reported',\\n        AtLimitSubscriptions > 0, 'Blocked',\\n        NoQuotaSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyAppServiceRegion}' == '*' or Location =~ '{SupplyAppServiceRegion}'\\n| where '{SupplyAppServiceStatus}' == 'all'\\n    or ('{SupplyAppServiceStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAppServiceStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyAppServiceStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyAppServiceHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyAppServiceHighWater}'), strcat('At or above ', '{SupplyAppServiceHighWater}', '%'),\\n        strcat('Below ', '{SupplyAppServiceHighWater}', '%'))\\n);\\nlet Rows = Filtered\\n| summarize Unit=take_any(Unit) by RowLabel;\\nlet Regions = Filtered\\n| summarize by Location;\\nRows\\n| extend JoinKey=1\\n| join kind=inner (Regions | extend JoinKey=1) on JoinKey\\n| project-away JoinKey\\n| join kind=leftouter (\\n    Filtered\\n    | project RowLabel, Unit, Location, UtilizationPercent\\n) on RowLabel, Unit, Location\\n| extend UtilizationPercent=coalesce(UtilizationPercent, -1.0)\\n| project ['Plan SKU']=RowLabel, Unit, Location, UtilizationPercent\\n| evaluate pivot(Location, take_any(UtilizationPercent), ['Plan SKU'], Unit)\\n| order by ['Plan SKU'] asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Estate quota by plan SKU and region",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "^(?!PlanSKU$|Unit$).+",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "-1",
                                "representation": "gray",
                                "text": "Not observed"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "100",
                                "representation": "redBright",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "90",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "80",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "0",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "gray",
                                "text": "{0}{1}"
                              }
                            ],
                            "customColumnWidthSetting": "18ch"
                          },
                          "numberFormat": {
                            "unit": 1,

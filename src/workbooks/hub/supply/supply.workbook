                  "name": "19271de1-6aef-1103-b8e4-2f09c9b51533"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "SelectedSupplyTab",
              "comparison": "isEqualTo",
              "value": "app-service"
            },
            "name": "ad044cfa-a568-209d-b4e9-e0ccca4239e4"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "lazy",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "### Azure AI quota pools\n\nEach model and deployment-tier pool is independent. Quota is never summed across models, and units remain provider-reported.\n\n**Evidence:** Provider-reported Azure AI quota - point-in-time\n\n**Next action:** Validate model availability, deployment scope, and actual capacity separately from the provider quota row."
                  },
                  "customWidth": "100",
                  "name": "a1294757-459c-2d41-8db2-f34e23aa29bb"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "1d85d47f-9b92-86ce-dfb1-9e0cafdbe13b",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureAiSearch",
                        "label": "Search",
                        "type": 1,
                        "isRequired": false,
                        "value": ""
                      },
                      {
                        "id": "a703a05b-b272-ec92-e0c9-7b18b4d5443f",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureAiStatus",
                        "label": "Show",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"datatable(value:string, label:string, selected:bool)\\n[\\n    'all', 'All', true,\\n    'in-use', 'In use', false,\\n    'at-limit', 'At limit', false,\\n    'no-quota', 'No quota', false\\n]\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "0dd52457-cb41-b528-d2b6-5475b8185c19",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureAiRegion",
                        "label": "Region",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureAiQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Azure AI services quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure AI services quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.CognitiveServices/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'CognitiveServicesUsage'\\r\\n| where ResourceType =~ 'Microsoft.CognitiveServices/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureAiQuotaUsage\\n| summarize\\n    RowLabel=take_any(displayName),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nMatrix\\n| summarize by value=tolower(Location)\\n| extend label=value, selected=false\\n| union (print value='*', label='All regions', selected=true)\\n| extend Sort=iff(value == '*', 0, 1)\\n| order by Sort asc, label asc\\n| project value, label, selected\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "5d86b99e-3fae-5d4a-ed95-a4b250cdfde8",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureAiHighWater",
                        "label": "High-water mark",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"datatable(value:string, label:string, selected:bool)\\n[\\n    '60', '60%', false,\\n    '70', '70%', true,\\n    '80', '80%', false,\\n    '90', '90%', false\\n]\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "10205b1b-13a9-9d96-34a5-49e2e7310e77",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyAzureAiDetail",
                        "type": 1,
                        "isRequired": false,
                        "value": "pairs",
                        "isHiddenWhenLocked": true
                      }
                    ],
                    "style": "standard",
                    "queryType": 9
                  },
                  "customWidth": "100",
                  "name": "a7e6006a-6471-1e4b-07e1-23f9ddef4479"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureAiQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Azure AI services quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure AI services quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.CognitiveServices/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'CognitiveServicesUsage'\\r\\n| where ResourceType =~ 'Microsoft.CognitiveServices/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureAiQuotaUsage\\n| summarize\\n    RowLabel=take_any(displayName),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nunion\\n    (Matrix | summarize Value=count() | extend Sort=1, Metric='Model-region pairs'),\\n    (Matrix | summarize Value=countif(Used > 0) | extend Sort=2, Metric='In use'),\\n    (Matrix | summarize Value=countif(AtLimitSubscriptions > 0) | extend Sort=3, Metric='At limit'),\\n    (Matrix | summarize Value=countif(NoQuotaSubscriptions >= Subscriptions) | extend Sort=4, Metric='No quota')\\n| order by Sort asc\\n| project Metric, Value\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Azure AI quota pools summary",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false,
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Metric",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "Value",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "style": "decimal",
                            "maximumFractionDigits": 1,
                            "maximumSignificantDigits": 4
                          }
                        }
                      },
                      "showBorder": false,
                      "rowLimit": 6,
                      "size": "auto"
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "9e64fbcd-f80a-513e-7297-4a1d18b605e7"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureAiQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Azure AI services quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure AI services quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.CognitiveServices/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'CognitiveServicesUsage'\\r\\n| where ResourceType =~ 'Microsoft.CognitiveServices/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureAiQuotaUsage\\n| summarize\\n    RowLabel=take_any(displayName),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nlet Filtered = materialize(\\n    Matrix\\n    | extend Search=base64_decode_tostring('{SupplyAzureAiSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        QuotaSubscriptions == 0 and NegativeLimitSubscriptions > 0, 'Invalid',\\n        QuotaSubscriptions == 0, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        QuotaSubscriptions == 0, 'Not reported',\\n        AtLimitSubscriptions > 0, 'Blocked',\\n        NoQuotaSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyAzureAiRegion}' == '*' or Location =~ '{SupplyAzureAiRegion}'\\n| where '{SupplyAzureAiStatus}' == 'all'\\n    or ('{SupplyAzureAiStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureAiStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyAzureAiStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyAzureAiHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyAzureAiHighWater}'), strcat('At or above ', '{SupplyAzureAiHighWater}', '%'),\\n        strcat('Below ', '{SupplyAzureAiHighWater}', '%'))\\n);\\nlet Rows = Filtered\\n| summarize Unit=take_any(Unit) by RowLabel;\\nlet Regions = Filtered\\n| summarize by Location;\\nRows\\n| extend JoinKey=1\\n| join kind=inner (Regions | extend JoinKey=1) on JoinKey\\n| project-away JoinKey\\n| join kind=leftouter (\\n    Filtered\\n    | project RowLabel, Unit, Location, UtilizationPercent\\n) on RowLabel, Unit, Location\\n| extend UtilizationPercent=coalesce(UtilizationPercent, -1.0)\\n| project ['Model and tier']=RowLabel, Unit, Location, UtilizationPercent\\n| evaluate pivot(Location, take_any(UtilizationPercent), ['Model and tier'], Unit)\\n| order by ['Model and tier'] asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Estate quota by Azure AI model and region",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "^(?!Modelandtier$|Unit$).+",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "-1",
                                "representation": "gray",
                                "text": "Not observed"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "100",
                                "representation": "redBright",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "90",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "80",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": ">=",
                                "thresholdValue": "0",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "gray",
                                "text": "{0}{1}"
                              }
                            ],
                            "customColumnWidthSetting": "18ch"
                          },
                          "numberFormat": {
                            "unit": 1,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 1
                            }
                          }
                        }
                      ]
                    },
                    "noDataMessage": "No Azure AI quota observations were ingested; check query coverage and provider access."
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "78e2725e-697c-0392-a61e-3735349c026c"
                },
                {
                  "type": 11,
                  "content": {
                    "version": "LinkItem/1.0",
                    "style": "tabs",
                    "links": [
                      {
                        "id": "1de5a3c1-a5e9-4939-aefb-80f67bd9b03f",
                        "cellValue": "SupplyAzureAiDetail",
                        "linkTarget": "parameter",
                        "linkLabel": "Model and region",
                        "subTarget": "pairs",
                        "style": "link"
                      },
                      {
                        "id": "3f124e60-5611-1ffe-c38b-0a02eca8d3fb",
                        "cellValue": "SupplyAzureAiDetail",
                        "linkTarget": "parameter",
                        "linkLabel": "Subscriptions",
                        "subTarget": "subscriptions",
                        "style": "link"
                      }
                    ]
                  },
                  "name": "1ee88ceb-28fe-3d47-e273-03e6b073b07f"
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "loadType": "lazy",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "c16ca5e0-754e-bdf6-e63f-3eb93ccdca22",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAzureAiPairsPage",
                              "label": "Page",
                              "type": 2,
                              "isRequired": true,
                              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureAiQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Azure AI services quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure AI services quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.CognitiveServices/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'CognitiveServicesUsage'\\r\\n| where ResourceType =~ 'Microsoft.CognitiveServices/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureAiQuotaUsage\\n| summarize\\n    RowLabel=take_any(displayName),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nMatrix\\n| extend Search=base64_decode_tostring('{SupplyAzureAiSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        QuotaSubscriptions == 0 and NegativeLimitSubscriptions > 0, 'Invalid',\\n        QuotaSubscriptions == 0, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        QuotaSubscriptions == 0, 'Not reported',\\n        AtLimitSubscriptions > 0, 'Blocked',\\n        NoQuotaSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyAzureAiRegion}' == '*' or Location =~ '{SupplyAzureAiRegion}'\\n| where '{SupplyAzureAiStatus}' == 'all'\\n    or ('{SupplyAzureAiStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureAiStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyAzureAiStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyAzureAiHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyAzureAiHighWater}'), strcat('At or above ', '{SupplyAzureAiHighWater}', '%'),\\n        strcat('Below ', '{SupplyAzureAiHighWater}', '%'))\\n| summarize TotalRows=count()\\n| extend TotalPages=max_of(1, toint(ceiling(todouble(TotalRows) / 50.0)))\\n| mv-expand Page=range(1, TotalPages, 1) to typeof(long)\\n| order by Page asc\\n| project\\n    value=tostring(Page),\\n    label=strcat('Page ', Page, ' of ', TotalPages, ' - ', TotalRows, ' rows'),\\n    selected=Page == 1\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                              "queryType": 9,
                              "typeSettings": {
                                "additionalResourceOptions": [],
                                "showDefault": false
                              }
                            }
                          ],
                          "style": "standard",
                          "queryType": 9
                        },
                        "customWidth": "100",
                        "name": "d3a80034-4286-b313-aeeb-02c219475567"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let AzureAiQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Azure AI services quota usage\\r\\n// DESCRIPTION: Rehydrates the latest Azure AI services quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.CognitiveServices/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'CognitiveServicesUsage'\\r\\n| where ResourceType =~ 'Microsoft.CognitiveServices/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nlet Matrix = materialize(\\nAzureAiQuotaUsage\\n| summarize\\n    RowLabel=take_any(displayName),\\n    Used=sum(currentValue),\\n    Quota=sum(limit),\\n    Subscriptions=dcount(SubAccountId),\\n    InUseSubscriptions=dcountif(SubAccountId, currentValue > 0),\\n    AtLimitSubscriptions=dcountif(SubAccountId, limit > 0 and currentValue >= limit),\\n    QuotaSubscriptions=dcountif(SubAccountId, limit > 0),\\n    NoQuotaSubscriptions=dcountif(SubAccountId, coalesce(limit, 0.0) <= 0),\\n    NegativeLimitSubscriptions=dcountif(SubAccountId, limit < 0),\\n    LatestObservation=max(x_IngestionTime)\\n    by RowKey=ResourceName, Unit=unit, Location=location\\n| extend\\n    UtilizationPercent=iff(Quota > 0 and Used >= 0, round(100.0 * Used / Quota, 1), real(null)),\\n    Headroom=iff(Quota > 0 and Used >= 0, Quota - Used, real(null))\\n);\\nMatrix\\n| extend Search=base64_decode_tostring('{SupplyAzureAiSearch:base64}')\\n| where isempty(Search) or RowLabel contains Search or RowKey contains Search\\n| extend\\n    QuotaStatus=case(\\n        QuotaSubscriptions == 0 and NegativeLimitSubscriptions > 0, 'Invalid',\\n        QuotaSubscriptions == 0, 'No quota',\\n        AtLimitSubscriptions > 0, 'Exhausted',\\n        UtilizationPercent >= 90, 'Action',\\n        UtilizationPercent >= 80, 'Watch',\\n        'Healthy'),\\n    SupplyStatus=case(\\n        QuotaSubscriptions == 0, 'Not reported',\\n        AtLimitSubscriptions > 0, 'Blocked',\\n        NoQuotaSubscriptions > 0, 'Partial',\\n        'Open')\\n| where '{SupplyAzureAiRegion}' == '*' or Location =~ '{SupplyAzureAiRegion}'\\n| where '{SupplyAzureAiStatus}' == 'all'\\n    or ('{SupplyAzureAiStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAzureAiStatus}' == 'at-limit' and AtLimitSubscriptions > 0)\\n    or ('{SupplyAzureAiStatus}' == 'no-quota' and NoQuotaSubscriptions >= Subscriptions)\\n| extend\\n    HighWaterMark=todouble('{SupplyAzureAiHighWater}'),\\n    HighWater=case(\\n        isnull(UtilizationPercent), 'Not comparable',\\n        UtilizationPercent >= todouble('{SupplyAzureAiHighWater}'), strcat('At or above ', '{SupplyAzureAiHighWater}', '%'),\\n        strcat('Below ', '{SupplyAzureAiHighWater}', '%'))\\n| project\\n    ['Model and tier']=RowLabel,\\n    Region=Location,\\n    Used,\\n    Quota,\\n    Headroom,\\n    UtilizationPercent,\\n    Unit,\\n    Subscriptions,\\n    InUseSubscriptions,\\n    AtLimitSubscriptions,\\n    NoQuotaSubscriptions,\\n    NegativeLimitSubscriptions,\\n    QuotaStatus,\\n    SupplyStatus,\\n    HighWater,\\n    LatestObservation\\n| order by UtilizationPercent desc nulls last, ['Model and tier'] asc, Region asc\\n| serialize PageRow=row_number()\\n| extend PageNumber=coalesce(toint('{SupplyAzureAiPairsPage}'), 1)\\n| where PageRow > (PageNumber - 1) * 50\\n    and PageRow <= PageNumber * 50\\n| project-away PageRow, PageNumber\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 3,
                          "title": "Filtered model and region detail",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "rowLimit": 50,
                            "formatters": [
                              {
                                "columnMatch": "QuotaStatus|EvidenceState",
                                "formatter": 18,
                                "formatOptions": {
                                  "thresholdsOptions": "colors",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Healthy",
                                      "representation": "green",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Watch",
                                      "representation": "yellow",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Action",
                                      "representation": "orange",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Exhausted",
                                      "representation": "red",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Invalid",
                                      "representation": "red",
                                      "text": "{0}{1}"
                                    },
                                    {

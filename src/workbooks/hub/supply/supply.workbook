                              "label": "Page",
                              "type": 2,
                              "isRequired": true,
                              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let ResourceSearch=base64_decode_tostring('{SupplyComputeSearch:base64}');\\nlet SubscriptionSearch=base64_decode_tostring('{SupplyComputeSubscriptionSearch:base64}');\\nlet ComputeFamilyUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: Compute VM family quota usage\\r\\n// DESCRIPTION: Shows the latest VM family vCPU quota, usage, headroom, and utilization for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Compute/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'ComputeUsage'\\r\\n| where ResourceType =~ 'Microsoft.Compute/locations/usages'\\r\\n| where ResourceName endswith 'Family'\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| extend\\r\\n    HeadroomCores = iff(limit >= 0, limit - currentValue, real(null)),\\r\\n    PercentUsed = iff(limit > 0, round(100.0 * currentValue / limit, 1), real(null))\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    SubscriptionId = SubAccountId,\\r\\n    Location = location,\\r\\n    Family = displayName,\\r\\n    FamilyKey = ResourceName,\\r\\n    CoresUsed = currentValue,\\r\\n    CoresTotal = limit,\\r\\n    HeadroomCores,\\r\\n    PercentUsed,\\r\\n    unit,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubscriptionId asc, Location asc, FamilyKey asc\\n);\\nComputeFamilyUsage\\n| project SubscriptionId, Region=Location, RowKey=FamilyKey, RowLabel=Family, Used=CoresUsed, Quota=CoresTotal, LatestObservation=x_IngestionTime\\n| where isempty(ResourceSearch) or RowLabel contains ResourceSearch or RowKey contains ResourceSearch\\n| where isempty(SubscriptionSearch) or SubscriptionId startswith SubscriptionSearch\\n| where '{SupplyComputeStatus}' == 'all'\\n    or ('{SupplyComputeStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyComputeStatus}' == 'at-limit' and Quota > 0 and Used >= Quota)\\n    or ('{SupplyComputeStatus}' == 'no-quota' and Quota <= 0)\\n| where '{SupplyComputeRegion}' == '*' or Region =~ '{SupplyComputeRegion}'\\n| summarize\\n    Families=dcount(RowKey),\\n    Regions=dcount(Region),\\n    UsedCores=sum(Used),\\n    QuotaCores=sum(Quota),\\n    HeadroomCores=sum(Quota) - sum(Used),\\n    LatestObservation=max(LatestObservation)\\n    by SubscriptionId\\n| order by UsedCores desc, SubscriptionId asc\\n| summarize TotalRows=count()\\n| extend TotalPages=max_of(1, toint(ceiling(todouble(TotalRows) / 50.0)))\\n| mv-expand Page=range(1, TotalPages, 1) to typeof(long)\\n| order by Page asc\\n| project\\n    value=tostring(Page),\\n    label=strcat('Page ', Page, ' of ', TotalPages, ' - ', TotalRows, ' rows'),\\n    selected=Page == 1\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",

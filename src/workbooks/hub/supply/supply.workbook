          {
            "type": 1,
            "content": {
              "json": "## Supply\n\nReview quota and inventory as separate evidence. Missing observations are unknown, not healthy."
            },
            "customWidth": "100",
            "name": "0d33b10e-7774-de5f-8527-ae6e16105e5b"
          },
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "tabs",
              "links": [

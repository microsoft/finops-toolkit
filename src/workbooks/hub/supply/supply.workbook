          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "lazy",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "### Storage quotas\n\nReview raw provider-reported Storage observations. This class remains unclassified because the capacity registry does not define a Storage utilization metric.\n\n**Evidence:** Provider-reported storage quota - point-in-time\n\n**Next action:** Validate ingestion and expected subscription-region coverage before drawing a Storage quota conclusion."
                  },
                  "customWidth": "100",
                  "name": "e91c5109-f1bd-dde1-2542-f2f00b7df1a2"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "d1cf495b-284f-055f-91c3-f85857bf7843",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyStorageQuotaSeries",
                        "label": "Quota series",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\nQuota()\\n| where x_SourceType =~ 'StorageUsage'\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\n);\\nCurrent\\n| order by SubAccountId asc, location asc, ResourceName asc\\n| serialize\\n| extend\\n    value=base64_encode_tostring(strcat(\\n        ResourceId, '|||',\\n        SubAccountId, '|||',\\n        location, '|||',\\n        ResourceName, '|||',\\n        unit, '|||',\\n        x_SourceVersion)),\\n    label=strcat(coalesce(displayName, ResourceName), ' | ', SubAccountId, ' | ', coalesce(location, 'global')),\\n    selected=row_number() == 1\\n| project value, label, selected\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      },
                      {
                        "id": "03a4dac3-f789-d7e4-0503-819747f17d38",
                        "version": "KqlParameterItem/1.0",
                        "name": "SupplyStorageDemandSeries",
                        "label": "Billed-demand series",
                        "type": 2,
                        "isRequired": true,
                        "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"Costs()\\n| where ChargePeriodStart >= startofday(now() - 430d)\\n| where ProviderName =~ 'Microsoft' and ChargeCategory =~ 'Usage'\\n| where x_ResourceType =~ 'microsoft.storage/storageaccounts'\\n| where ConsumedUnit in~ ('Units', 'Units/Hour', 'GB', 'GB/Month', 'Units/Month')\\n| summarize EffectiveCost=sum(EffectiveCost)\\n    by x_SkuMeterCategory, x_SkuMeterSubcategory, SkuMeter, SkuPriceId, ConsumedUnit, BillingCurrency\\n| order by BillingCurrency asc, x_SkuMeterSubcategory asc, SkuMeter asc\\n| serialize\\n| extend\\n    value=base64_encode_tostring(strcat(\\n        x_SkuMeterCategory, '|||',\\n        x_SkuMeterSubcategory, '|||',\\n        SkuMeter, '|||',\\n        SkuPriceId, '|||',\\n        ConsumedUnit, '|||',\\n        BillingCurrency)),\\n    label=strcat(SkuMeter, ' | ', ConsumedUnit, ' | ', BillingCurrency),\\n    selected=row_number() == 1\\n| project value, label, selected\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                        "queryType": 9,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        }
                      }
                    ],
                    "style": "standard",
                    "queryType": 9
                  },
                  "customWidth": "100",
                  "name": "2970c8dd-c0b9-a889-0b7e-56dd4590a066"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\nQuota()\\n| where x_SourceType =~ 'StorageUsage'\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\n);\\nlet Coverage = Quota()\\n| where x_SourceType =~ 'StorageUsage'\\n| summarize Observations=count(), SnapshotDays=dcount(startofday(x_IngestionTime));\\nlet CurrentSummary = Current\\n| summarize ResourceKeys=count(), Stale=countif(datetime_diff('hour', now(), x_IngestionTime) > 48);\\nunion\\n    (Coverage | project Sort=1, Metric='Observations', Value=Observations),\\n    (Coverage | project Sort=2, Metric='Snapshot days', Value=SnapshotDays),\\n    (CurrentSummary | project Sort=3, Metric='Current resource keys', Value=ResourceKeys),\\n    (CurrentSummary | project Sort=4, Metric='Stale', Value=Stale)\\n| order by Sort asc\\n| project Metric, Value\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Storage quotas summary",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false,
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Metric",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "Value",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "style": "decimal",
                            "maximumFractionDigits": 1,
                            "maximumSignificantDigits": 4
                          }
                        }
                      },
                      "showBorder": false,
                      "rowLimit": 6,
                      "size": "auto"
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "db764fd5-fe65-1d61-0d9f-2e73a46ade79"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Current = (\\nQuota()\\n| where x_SourceType =~ 'StorageUsage'\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\n);\\nCurrent\\n| extend\\n    CurrentValue=todouble(currentValue),\\n    LimitValue=todouble(limit),\\n    AgeHours=round(todouble(datetime_diff('minute', now(), x_IngestionTime)) / 60.0, 1)\\n| extend EvidenceState=case(\\n        AgeHours > 48, 'Stale',\\n        'Unknown or unclassified')\\n| project\\n    Subscription=SubAccountId,\\n    Region=location,\\n    Metric=coalesce(displayName, ResourceName),\\n    Current=CurrentValue,\\n    Limit=iff(false, real(null), LimitValue),\\n    Unit=iff('storage' == 'premium-ssd-v2', 'GiB', unit),\\n    EvidenceState,\\n    AgeHours,\\n    LatestObservation=x_IngestionTime,\\n    SourceKey=ResourceId\\n| order by Subscription asc, Region asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Current quota",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000,
                      "formatters": [
                        {
                          "columnMatch": "QuotaStatus|EvidenceState",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Healthy",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Watch",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Action",
                                "representation": "orange",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Exhausted",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Invalid",
                                "representation": "red",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Stale",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "No quota",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Observed",
                                "representation": "green",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Observed inventory",
                                "representation": "blue",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Unknown or unclassified",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Not reported - collection outcome unknown",
                                "representation": "gray",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "gray",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "noDataMessage": "No Storage quota was reported. Validate ingestion, permissions, supported regions, and source execution."
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "322c37aa-c23c-039e-6102-f17bcaba4d16"
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "loadType": "always",
                    "items": [
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Selection=split(base64_decode_tostring('{SupplyStorageQuotaSeries}'), '|||');\\nlet SelectedResourceId=tostring(Selection[0]);\\nlet SelectedSubscription=tostring(Selection[1]);\\nlet SelectedRegion=tostring(Selection[2]);\\nlet SelectedResourceName=tostring(Selection[3]);\\nlet SelectedUnit=tostring(Selection[4]);\\nlet SelectedSourceVersion=tostring(Selection[5]);\\nlet History = Quota()\\n| where x_SourceType =~ 'StorageUsage'\\n| where isnotempty(SelectedResourceId)\\n| where ResourceId =~ SelectedResourceId\\n| where SubAccountId =~ SelectedSubscription\\n| where location =~ SelectedRegion\\n| where ResourceName =~ SelectedResourceName\\n| where unit =~ SelectedUnit\\n| where x_SourceVersion =~ SelectedSourceVersion\\n| extend Day=startofday(x_IngestionTime)\\n| summarize arg_max(x_IngestionTime, *) by Day, ResourceId;\\nlet SnapshotDays=toscalar(History | summarize dcount(Day));\\nHistory\\n| extend HistoryMode=case(\\n    SnapshotDays == 1, 'Collecting history - trends are disabled',\\n    false, 'Observed inventory history - runway is not applicable',\\n    SnapshotDays == 2, 'Observed delta - insufficient trend points',\\n    SnapshotDays < 7, 'Provisional trend - low confidence',\\n    'Compatible daily history')\\n| project\\n    Day,\\n    Current=currentValue,\\n    Limit=iff(false, real(null), limit),\\n    Unit=iff('storage' == 'premium-ssd-v2', 'GiB', unit),\\n    HistoryMode,\\n    Ingested=x_IngestionTime\\n| order by Day asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 2,
                          "title": "Observed history",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "rowLimit": 10000,
                            "formatters": [
                              {
                                "columnMatch": "HistoryMode",
                                "formatter": 18,
                                "formatOptions": {
                                  "thresholdsOptions": "colors",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Compatible daily history",
                                      "representation": "green",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Provisional trend - low confidence",
                                      "representation": "yellow",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Observed delta - insufficient trend points",
                                      "representation": "yellow",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Collecting history - trends are disabled",
                                      "representation": "gray",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Observed inventory history - runway is not applicable",
                                      "representation": "blue",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "Default",
                                      "thresholdValue": null,
                                      "representation": "gray",
                                      "text": "{0}{1}"
                                    }
                                  ]
                                }
                              }
                            ]
                          },
                          "noDataMessage": "Select an exact source key with compatible observations to view history."
                        },
                        "doNotRunWhenHidden": true,
                        "customWidth": "50",
                        "name": "2eaa7696-0208-17ba-1747-b8de4a8938c7"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Selection=split(base64_decode_tostring('{SupplyStorageQuotaSeries}'), '|||');\\nlet SelectedResourceName=tostring(Selection[3]);\\nlet SelectedUnit=tostring(Selection[4]);\\nlet SelectedSourceVersion=tostring(Selection[5]);\\nQuota()\\n| where x_SourceType =~ 'StorageUsage'\\n| where isnotempty(SelectedResourceName)\\n| where ResourceName =~ SelectedResourceName\\n| where unit =~ SelectedUnit\\n| where x_SourceVersion =~ SelectedSourceVersion\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\n| summarize\\n    Current=sum(todouble(currentValue)),\\n    Limit=sum(todouble(limit)),\\n    LatestObservation=max(x_IngestionTime)\\n    by Subscription=SubAccountId, Region=coalesce(location, 'global')\\n| extend Cell=strcat(\\n    round(Current, 1), ' current | ',\\n    round(Limit, 1), ' limit | ',\\n    SelectedUnit, ' | Unclassified')\\n| project Subscription, Region, Cell\\n| evaluate pivot(Region, take_any(Cell), Subscription)\\n| order by Subscription asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                          "size": 2,
                          "title": "Subscription x region",
                          "timeContext": {
                            "durationMs": 0
                          },
                          "queryType": 9,
                          "visualization": "table",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "rowLimit": 10000
                          }
                        },
                        "doNotRunWhenHidden": true,
                        "customWidth": "50",
                        "name": "eb3d49c8-fd93-caf3-90db-91eccad9153e"
                      }
                    ]
                  },
                  "customWidth": "100",
                  "name": "277373a1-ed3d-0123-4ad1-0f12f8296e25"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let Selection=split(base64_decode_tostring('{SupplyStorageDemandSeries}'), '|||');\\nlet SelectedCategory=tostring(Selection[0]);\\nlet SelectedSubcategory=tostring(Selection[1]);\\nlet SelectedMeter=tostring(Selection[2]);\\nlet SelectedPriceId=tostring(Selection[3]);\\nlet SelectedUnit=tostring(Selection[4]);\\nlet SelectedCurrency=tostring(Selection[5]);\\nCosts()\\n| where ChargePeriodStart >= startofday(now() - 430d)\\n| where ProviderName =~ 'Microsoft' and ChargeCategory =~ 'Usage'\\n| where x_ResourceType =~ 'microsoft.storage/storageaccounts'\\n| where ConsumedUnit in~ ('Units', 'Units/Hour', 'GB', 'GB/Month', 'Units/Month')\\n| where isnotempty(SelectedMeter)\\n| where x_SkuMeterCategory =~ SelectedCategory\\n| where x_SkuMeterSubcategory =~ SelectedSubcategory\\n| where SkuMeter =~ SelectedMeter\\n| where SkuPriceId =~ SelectedPriceId\\n| where ConsumedUnit =~ SelectedUnit\\n| where BillingCurrency =~ SelectedCurrency\\n\\n| summarize BilledQuantity=sum(ConsumedQuantity), EffectiveCost=sum(EffectiveCost), Rows=count()\\n    by Day=startofday(ChargePeriodStart), SkuMeter, ConsumedUnit, BillingCurrency\\n| order by Day asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 2,
                    "title": "Parallel billed demand",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000
                    },
                    "noDataMessage": "Select one exact meter, unit, price, and currency series. Quota and billed demand are never combined."
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "54d98a93-8ae7-35ac-fc38-446a633ed93c"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"Quota()\\n| where x_SourceType =~ 'StorageUsage'\\n| summarize\\n    Observations=count(),\\n    Resources=dcount(ResourceId),\\n    Subscriptions=dcount(SubAccountId),\\n    SnapshotDays=dcount(startofday(x_IngestionTime)),\\n    LatestObservation=max(x_IngestionTime)\\n| extend EvidenceState=iff(Observations == 0, 'Not reported - collection outcome unknown', 'Observed')\\n| project EvidenceState, Observations, Resources, Subscriptions, SnapshotDays, LatestObservation\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,

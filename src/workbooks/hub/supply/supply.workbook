                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "loadType": "lazy",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "5b76a493-8082-e28c-6957-b4d948ea5086",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAppServiceSubscriptionSearch",
                              "label": "Search subscriptions",
                              "type": 1,
                              "isRequired": false,
                              "value": ""
                            },
                            {
                              "id": "0b6ce370-9c69-5714-3cbf-7b612daee260",
                              "version": "KqlParameterItem/1.0",
                              "name": "SupplyAppServiceSubscriptionPage",
                              "label": "Page",
                              "type": 2,
                              "isRequired": true,
                              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let ResourceSearch=base64_decode_tostring('{SupplyAppServiceSearch:base64}');\\nlet SubscriptionSearch=base64_decode_tostring('{SupplyAppServiceSubscriptionSearch:base64}');\\nlet AppServiceQuotaUsage = (\\n// Copyright (c) Microsoft Corporation.\\r\\n// Licensed under the MIT License.\\r\\n//\\r\\n// NAME: App Service quota usage\\r\\n// DESCRIPTION: Rehydrates the latest App Service quota usage records for each subscription and region.\\r\\n// CATEGORY: Governance\\r\\n// FEATURE: Quota\\r\\n// REGION: All\\r\\n// TECH: KQL\\r\\n//\\r\\n// RESOURCE TYPES: Microsoft.Web/locations/usages\\r\\n//\\r\\n// SOURCE: Quota()\\r\\n//\\r\\n\\r\\nQuota()\\r\\n| where x_SourceType =~ 'AppServiceUsage'\\r\\n| where ResourceType =~ 'Microsoft.Web/locations/usages'\\r\\n| where isnotempty(ResourceName)\\r\\n| summarize arg_max(x_IngestionTime, *) by ResourceId\\r\\n| project\\r\\n    ProviderName,\\r\\n    ResourceId,\\r\\n    ResourceName,\\r\\n    ResourceType,\\r\\n    SubAccountId,\\r\\n    displayName,\\r\\n    location,\\r\\n    currentValue,\\r\\n    limit,\\r\\n    unit,\\r\\n    x_QuotaDetails,\\r\\n    x_SourceType,\\r\\n    x_SourceVersion,\\r\\n    x_IngestionTime\\r\\n| order by SubAccountId asc, location asc, ResourceName asc\\n);\\nAppServiceQuotaUsage\\n\\n| project SubscriptionId=SubAccountId, Region=location, RowKey=ResourceName, RowLabel=coalesce(displayName, ResourceName), Used=currentValue, Quota=limit, LatestObservation=x_IngestionTime\\n| where isempty(ResourceSearch) or RowLabel contains ResourceSearch or RowKey contains ResourceSearch\\n| where isempty(SubscriptionSearch) or SubscriptionId startswith SubscriptionSearch\\n| where '{SupplyAppServiceStatus}' == 'all'\\n    or ('{SupplyAppServiceStatus}' == 'in-use' and Used > 0)\\n    or ('{SupplyAppServiceStatus}' == 'at-limit' and Quota > 0 and Used >= Quota)\\n    or ('{SupplyAppServiceStatus}' == 'no-quota' and Quota <= 0)\\n| where '{SupplyAppServiceRegion}' == '*' or Region =~ '{SupplyAppServiceRegion}'\\n| summarize\\n    ['SKUs']=dcount(RowKey),\\n    Regions=dcount(Region),\\n    Pairs=count(),\\n    InUse=countif(Used > 0),\\n    AtLimit=countif(Quota > 0 and Used >= Quota),\\n    NoQuota=countif(coalesce(Quota, 0.0) <= 0),\\n    LatestObservation=max(LatestObservation)\\n    by SubscriptionId\\n| order by AtLimit desc, NoQuota desc, InUse desc, SubscriptionId asc\\n| summarize TotalRows=count()\\n| extend TotalPages=max_of(1, toint(ceiling(todouble(TotalRows) / 50.0)))\\n| mv-expand Page=range(1, TotalPages, 1) to typeof(long)\\n| order by Page asc\\n| project\\n    value=tostring(Page),\\n    label=strcat('Page ', Page, ' of ', TotalPages, ' - ', TotalRows, ' rows'),\\n    selected=Page == 1\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                              "queryType": 9,
                              "typeSettings": {
                                "additionalResourceOptions": [],
                                "showDefault": false
                              }
                            }
                          ],
                          "style": "standard",

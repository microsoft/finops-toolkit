                                    {
                                      "operator": "Default",
                                      "thresholdValue": null,
                                      "representation": "gray",
                                      "text": "{0}{1}"
                                    }
                                  ]
                                }
                              },
                              {
                                "columnMatch": "UtilizationPercent",
                                "formatter": 8,
                                "formatOptions": {
                                  "min": 0,
                                  "max": 100,
                                  "palette": "greenRed",
                                  "customColumnWidthSetting": "18ch"
                                }
                              }
                            ]
                          },
                          "noDataMessage": "No quota rows match the selected status and region."
                        },
                        "doNotRunWhenHidden": true,
                        "customWidth": "100",
                        "name": "d75d8289-f7ea-3be0-82fb-4ca0648743aa"
                      }

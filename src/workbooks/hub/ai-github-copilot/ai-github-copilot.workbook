            "customWidth": "100",
            "name": "2a080577-3d2e-6917-9a0b-322ee4c11ca3"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "dependencies\n| where cloud_RoleName in ({CopilotSource})\n| where tostring(customDimensions[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| extend operation = tostring(customDimensions[\"gen_ai.operation.name\"]),\n    agent = tostring(customDimensions[\"gen_ai.agent.name\"]),\n    model = coalesce(tostring(customDimensions[\"gen_ai.response.model\"]), tostring(customDimensions[\"gen_ai.request.model\"])),\n    input_tokens = tolong(customDimensions[\"gen_ai.usage.input_tokens\"]),\n    output_tokens = tolong(customDimensions[\"gen_ai.usage.output_tokens\"])\n| project timestamp, Source = cloud_RoleName, operation, agent, model, success, duration, input_tokens, output_tokens, TraceId=operation_Id\n| order by timestamp desc",

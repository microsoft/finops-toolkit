          {
            "type": 1,
            "content": {
              "json": "#### Trace detail"
            },
            "customWidth": "100",
            "name": "a1fbb1b3-aa9b-e92f-dca6-6e40afe2529e"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet TraceId = '{CopilotTraceId}';\nunion isfuzzy=true\n    (requests | extend ItemType = 'request', Name = name, Detail = url, DurationMs = duration, Ok = success),\n    (dependencies | extend ItemType = 'dependency', Name = name, Detail = data, DurationMs = duration, Ok = success),\n    (traces | extend ItemType = 'trace', Name = message, Detail = tostring(customDimensions), DurationMs = real(null), Ok = bool(null)),\n    (customEvents | extend ItemType = 'event', Name = name, Detail = tostring(customDimensions), DurationMs = real(null), Ok = bool(null)),\n    (exceptions | extend ItemType = 'exception', Name = type, Detail = outerMessage, DurationMs = real(null), Ok = false)\n| where timestamp >= StartTime and timestamp < EndTime\n| where operation_Id == TraceId\n| project timestamp, ItemType, Name, DurationMs, Ok, SpanId = itemId, ParentId = operation_ParentId, Detail\n| order by timestamp asc",
                    "size": 2,
                    "title": "Trace spans",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "timeContextFromParameter": "TimeRange",
                    "queryType": 0,
                    "resourceType": "microsoft.insights/components",
                    "crossComponentResources": [

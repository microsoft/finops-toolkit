          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "exceptions\n| where cloud_RoleName in ({CopilotSource})\n| extend ExceptionType = coalesce(type, outerType, tostring(customDimensions[\"exception.type\"])),\n    Message = coalesce(outerMessage, innermostMessage, problemId)\n| project timestamp, ExceptionType, Message\n| order by timestamp desc",

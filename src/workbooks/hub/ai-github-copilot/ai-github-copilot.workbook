          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "dependencies\n| where cloud_RoleName in ({CopilotSource})\n| where tostring(customDimensions[\"gen_ai.operation.name\"]) == \"execute_tool\"\n| extend tool = tostring(customDimensions[\"gen_ai.tool.name\"])\n| where isnotempty(tool)\n| summarize Calls = count(), Failed = countif(tobool(success) == false), ['P90 Duration'] = round(percentile(duration, 90), 0) by Source = cloud_RoleName, Tool = tool\n| where Failed > 0\n| extend ['Failure %'] = round(100.0 * Failed / Calls, 1)\n| project Source, Tool, Failed, Calls, ['Failure %'], ['P90 Duration']\n| order by Failed desc\n| take 15",
              "size": 1,
              "title": "Tool call failures by tool",
              "timeContext": {
                "durationMs": 0

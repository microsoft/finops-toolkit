            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "dependencies\n| where cloud_RoleName in ({CopilotSource})\n| summarize ['Last Span'] = max(timestamp), Spans = count(), ['Agent Runs'] = countif(tostring(customDimensions[\"gen_ai.operation.name\"]) == \"invoke_agent\") by Source = cloud_RoleName\n| extend ['Since Last Span'] = round(datetime_diff('minute', now(), ['Last Span']) / 60.0, 1)\n| project Source, ['Last Span'], ['Since Last Span'], Spans, ['Agent Runs']\n| order by Source asc",
              "size": 1,
              "title": "Telemetry freshness",

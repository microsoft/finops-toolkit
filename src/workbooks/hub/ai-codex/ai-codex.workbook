          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts});\n\nresponseCosts | where input >= 0 and output >= 0 and total == input + output | summarize inputTokens = sum(input), outputTokens = sum(output) | project value = iff(inputTokens + outputTokens > 0, 100.0 * outputTokens / (inputTokens + outputTokens), real(null))",

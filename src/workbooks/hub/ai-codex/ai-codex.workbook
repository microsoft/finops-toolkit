            "name": "31ba5fbd-2dc7-2962-e766-aee94e00bac9"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet Bucket = case(\n    EndTime - StartTime <= 1d, 15m,\n    EndTime - StartTime <= 7d, 1h,\n    EndTime - StartTime <= 30d, 6h,\n    1d);\ndependencies\n| where (timestamp >= StartTime and timestamp < EndTime)\r\n| where cloud_RoleName in ('codex-app-server', 'coding-agent.codex-app-server', '[coding-agent]/codex-app-server')\r\n| where name == 'handle_responses'\r\n| extend total = todouble(customDimensions['codex.usage.total_tokens']),\r\n         input = todouble(customDimensions['gen_ai.usage.input_tokens']),\r\n         cached = todouble(customDimensions['gen_ai.usage.cache_read.input_tokens']),\r\n         output = todouble(customDimensions['gen_ai.usage.output_tokens']),\r\n         reasoning = todouble(customDimensions['codex.usage.reasoning_output_tokens'])\r\n| where isnotnull(total)\r\n| where input >= 0 and cached >= 0 and cached <= input\r\n| summarize non_cached = sum(input - cached), cached = sum(cached) by bin(timestamp, Bucket)\r\n| order by timestamp asc",
              "size": 1,
              "title": "Response input tokens",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,

          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts});\n\nresponseCosts | where input >= 0 and cached >= 0 and cached <= input | summarize inputTokens = sum(input), readTokens = sum(cached) | project value = iff(inputTokens > 0, 100.0 * readTokens / inputTokens, real(null))",

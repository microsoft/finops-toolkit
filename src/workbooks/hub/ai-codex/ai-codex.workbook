          {
            "type": 1,
            "content": {
              "json": "#### Models & tokens"
            },
            "customWidth": "100",
            "name": "830ab90c-6372-9eeb-c5f8-e87e2150d795"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet streamParents = dependencies\n| where (timestamp >= StartTime and timestamp < EndTime)\r\n| where cloud_RoleName in ('codex-app-server', 'coding-agent.codex-app-server', '[coding-agent]/codex-app-server')\r\n| where name == 'receiving_stream'\r\n| project cloud_RoleName, operation_Id, streamId = id, samplingId = operation_ParentId;\r\nlet samplingModels = dependencies\n| where (timestamp >= StartTime and timestamp < EndTime)\r\n| where cloud_RoleName in ('codex-app-server', 'coding-agent.codex-app-server', '[coding-agent]/codex-app-server')\r\n| where name == 'try_run_sampling_request'\r\n| project cloud_RoleName, operation_Id, samplingId = id, model = tostring(customDimensions['model']);\r\ndependencies\n| where (timestamp >= StartTime and timestamp < EndTime)\r\n| where cloud_RoleName in ('codex-app-server', 'coding-agent.codex-app-server', '[coding-agent]/codex-app-server')\r\n| where name == 'handle_responses'\r\n| extend total = todouble(customDimensions['codex.usage.total_tokens']),\r\n         input = todouble(customDimensions['gen_ai.usage.input_tokens']),\r\n         cached = todouble(customDimensions['gen_ai.usage.cache_read.input_tokens']),\r\n         output = todouble(customDimensions['gen_ai.usage.output_tokens']),\r\n         reasoning = todouble(customDimensions['codex.usage.reasoning_output_tokens'])\r\n| where isnotnull(total)\r\n| extend streamId = operation_ParentId\r\n| join kind=leftouter streamParents on cloud_RoleName, operation_Id, streamId\r\n| join kind=leftouter samplingModels on cloud_RoleName, operation_Id, samplingId\r\n| extend model = iff(isempty(model), 'Unattributed', model)\r\n| where total >= 0\r\n| summarize tokens = sum(total) by model\r\n| order by tokens desc",
              "size": 1,
              "title": "Response tokens by model",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "piechart"
            },
            "doNotRunWhenHidden": true,
            "customWidth": "50",
            "name": "b17b071e-8873-7688-949f-c85102ae2026"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\ndependencies\n| where (timestamp >= StartTime and timestamp < EndTime)\r\n| where cloud_RoleName in ('codex-app-server', 'coding-agent.codex-app-server', '[coding-agent]/codex-app-server')\r\n| where name == 'session_task.turn'\r\n| extend reasoning = tostring(customDimensions['codex.turn.reasoning_effort'])\r\n| extend reasoning = iff(isempty(reasoning), 'Not reported', reasoning)\r\n| summarize turns = count() by reasoning\r\n| order by turns desc",
              "size": 1,
              "title": "Reasoning effort of completed turns",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "piechart"
            },
            "doNotRunWhenHidden": true,
            "customWidth": "50",
            "name": "6cf4ad5a-127d-c974-7e9b-3aaa9242b7f2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts}| lookup kind=leftouter (spans | where name == 'run_sampling_request'\n    | project cloud_RoleName, operation_Id, requestId = id, runTurnId = operation_ParentId) on cloud_RoleName, operation_Id, requestId\n| lookup kind=leftouter (spans | where name == 'run_turn'\n    | project cloud_RoleName, operation_Id, runTurnId = id, taskRunId = operation_ParentId) on cloud_RoleName, operation_Id, runTurnId\n| lookup kind=leftouter (spans | where name == 'session_task.run'\n    | project cloud_RoleName, operation_Id, taskRunId = id, turnSpanId = operation_ParentId) on cloud_RoleName, operation_Id, taskRunId\n| lookup kind=leftouter (turns | project cloud_RoleName, operation_Id, turnSpanId, turnPresent = true) on cloud_RoleName, operation_Id, turnSpanId);\nlet turnCosts = responseCosts\n| where turnPresent == true\n| summarize responses = count(), pricedResponses = countif(priceStatus == 'Priced'),\n            responseInput = sum(input), responseCached = sum(cached), responseWritten = sum(written),\n            responseOutput = sum(output), responseTotal = sum(total),\n            cost_usd = sum(cost_usd), retail_usd = sum(retail_usd), negotiated_discount_usd = sum(negotiated_discount_usd),\n            input_cost_usd = sum(input_cost_usd), cached_cost_usd = sum(cached_cost_usd),\n            write_cost_usd = sum(write_cost_usd), output_cost_usd = sum(output_cost_usd),\n            cache_benefit_usd = sum(cache_benefit_usd), context_premium_usd = sum(context_premium_usd),\n            longResponses = countif(context == 'long'), maxResponseInput = max(input),\n            responseIssues = make_set_if(priceStatus, priceStatus != 'Priced', 8)\n    by cloud_RoleName, operation_Id, turnSpanId;\nlet pricedTurns = materialize(turns\n| lookup kind=leftouter turnCosts on cloud_RoleName, operation_Id, turnSpanId\n| extend pricingStatus = case(isnull(responses), 'No response usage in range',\n                              isempty(turnModel), 'Missing turn model',\n                              pricedResponses != responses, strcat_array(responseIssues, '; '),\n                              isnull(turnTotal) or isnull(turnInput) or isnull(turnCached) or isnull(turnOutput), 'Turn summary missing',\n                              responseInput != turnInput or responseCached != turnCached\n                                  or responseOutput != turnOutput or responseTotal != turnTotal, 'Response and turn usage differ',\n                              isnotnull(turnWritten) and responseWritten != turnWritten, 'Response and turn cache writes differ',\n                              'Complete')\n| extend complete = pricingStatus == 'Complete'\n| extend cost_usd = iff(complete, cost_usd, real(null)),\n         retail_usd = iff(complete, retail_usd, real(null)),\n         negotiated_discount_usd = iff(complete, negotiated_discount_usd, real(null)),\n         input_cost_usd = iff(complete, input_cost_usd, real(null)),\n         cached_cost_usd = iff(complete, cached_cost_usd, real(null)),\n         write_cost_usd = iff(complete, write_cost_usd, real(null)),\n         output_cost_usd = iff(complete, output_cost_usd, real(null)),\n         cache_benefit_usd = iff(complete, cache_benefit_usd, real(null)),\n         context_premium_usd = iff(complete, context_premium_usd, real(null)));\n\npricedTurns\n| summarize turns = count(), priced_turns = countif(complete), turns_with_tokens = countif(isnotnull(turnTotal)),\n            total_tokens = sum(turnTotal), totalInput = sum(turnInput), totalCached = sum(turnCached),\n            p95_s = percentile(duration_s, 95), cost_usd = sum(cost_usd), retail_usd = sum(retail_usd),\n            negotiated_discount_usd = sum(negotiated_discount_usd), input_cost_usd = sum(input_cost_usd),\n            cached_cost_usd = sum(cached_cost_usd), write_cost_usd = sum(write_cost_usd), output_cost_usd = sum(output_cost_usd),\n            cache_benefit_usd = sum(cache_benefit_usd), context_premium_usd = sum(context_premium_usd),\n            longResponses = sum(longResponses), maxResponseInput = max(maxResponseInput),\n            issues = make_set_if(pricingStatus, not(complete), 8) by model = turnModel\n| extend complete = priced_turns == turns, missing_usage = turns - turns_with_tokens,\n         total_tokens = iff(turns_with_tokens > 0, total_tokens, real(null)),\n         avg_per_turn = iff(turns_with_tokens > 0, total_tokens / turns_with_tokens, real(null)),\n         cache_pct = iff(totalInput > 0, 100.0 * totalCached / totalInput, real(null)),\n         pricing_coverage = 100.0 * priced_turns / turns\n| extend pricingStatus = iff(complete, 'Complete', strcat(priced_turns, '/', turns, ' turns priced; ', strcat_array(issues, '; '))),\n         cost_usd = iff(complete, cost_usd, real(null)), retail_usd = iff(complete, retail_usd, real(null)),\n         negotiated_discount_usd = iff(complete, negotiated_discount_usd, real(null)),\n         input_cost_usd = iff(complete, input_cost_usd, real(null)),\n         cached_cost_usd = iff(complete, cached_cost_usd, real(null)),\n         write_cost_usd = iff(complete, write_cost_usd, real(null)),\n         output_cost_usd = iff(complete, output_cost_usd, real(null)),\n         cache_benefit_usd = iff(complete, cache_benefit_usd, real(null)),\n         context_premium_usd = iff(complete, context_premium_usd, real(null))\n| extend cost_per_turn_usd = cost_usd / turns,\n         negotiated_discount_pct = iff(retail_usd > 0, 100.0 * negotiated_discount_usd / retail_usd, real(null))\n| project model, turns, pricingStatus, cost_usd, retail_usd, negotiated_discount_pct, cost_per_turn_usd, p95_s, pricing_coverage,\n          input_cost_usd, cached_cost_usd, write_cost_usd, output_cost_usd, negotiated_discount_usd, cache_benefit_usd, context_premium_usd,\n          longResponses, maxResponseInput, total_tokens, avg_per_turn, cache_pct, turns_with_tokens, missing_usage\n| order by cost_usd desc nulls last",
              "size": 1,
              "title": "Completed turns and estimates by model",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",

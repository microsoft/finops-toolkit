          {
            "type": 1,
            "content": {
              "json": "#### Tool health"
            },
            "customWidth": "100",
            "name": "c4881656-8c26-b1cf-1f50-f692c4457f8b"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet metricCounts = customMetrics\n| where (timestamp >= StartTime and timestamp < EndTime)\r\n| where cloud_RoleName in ('codex-app-server', 'coding-agent.codex-app-server', '[coding-agent]/codex-app-server')\r\n| where name == 'codex.tool.call'\r\n| extend role = iff(cloud_RoleName == '[coding-agent]/codex-app-server', 'coding-agent.codex-app-server', cloud_RoleName), tool = tostring(customDimensions['tool']),\r\n         outcome = tobool(customDimensions['success'])\r\n| extend tool = iff(isempty(tool), 'Not reported', tool)\r\n| where valueSum >= 0\r\n| summarize total = sum(valueSum), failures = sumif(valueSum, outcome == false),\r\n            successes = sumif(valueSum, outcome == true),\r\n            unknown = sumif(valueSum, isnull(outcome)) by role, tool\r\n| where total > 0;\r\nlet logCounts = traces\n| where (timestamp >= StartTime and timestamp < EndTime)\r\n| where cloud_RoleName in ('codex-app-server', 'coding-agent.codex-app-server', '[coding-agent]/codex-app-server')\r\n| where tostring(customDimensions['event.name']) == 'codex.tool_result'\r\n| extend role = iff(cloud_RoleName == '[coding-agent]/codex-app-server', 'coding-agent.codex-app-server', cloud_RoleName),\r\n         conversation = tostring(customDimensions['conversation.id']),\r\n         call = tostring(customDimensions['call_id']),\r\n         tool = tostring(customDimensions['tool_name']),\r\n         outcome = tobool(customDimensions['success']),\r\n         duration_ms = todouble(customDimensions['duration_ms'])\r\n| where isnotempty(conversation) and isnotempty(call)\r\n| extend tool = iff(isempty(tool), 'Not reported', tool)\r\n| summarize timestamp = min(timestamp), outcomes = make_set_if(tostring(outcome), isnotnull(outcome), 3),\r\n            durations = make_set(duration_ms, 3), tool = take_any(tool)\r\n            by role, conversation, call\r\n| extend outcome = iff(array_length(outcomes) == 1, tobool(outcomes[0]), bool(null)),\r\n         duration_ms = iff(array_length(durations) == 1, todouble(durations[0]), real(null))\r\n| join kind=leftanti (metricCounts | project role, tool) on role, tool\r\n| summarize total = todouble(count()), failures = todouble(countif(outcome == false)),\r\n            successes = todouble(countif(outcome == true)),\r\n            unknown = todouble(countif(isnull(outcome))) by role, tool;\r\nunion (metricCounts | extend source = 'Metrics'), (logCounts | extend source = 'Logs')\r\n| summarize total = sum(total), failures = sum(failures), successes = sum(successes),\r\n            unknown = sum(unknown) by tool, source\r\n| extend failPct = iff(failures + successes > 0, 100.0 * failures / (failures + successes), real(null))\r\n| project tool, source, total, failures, unknown, failPct\r\n| order by total desc",
              "size": 1,
              "title": "Tool reliability by tool",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [

              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts});\n\nresponseCosts\n| where priceStatus == 'Priced'\n| summarize reports = count(), cost = sum(cost_usd), tokens = sum(total),\n            benefit = sum(cache_benefit_usd),\n            inputCost = sum(input_cost_usd), inputTokens = sum(uncached),\n            readCost = sum(cached_cost_usd), readTokens = sum(cached),\n            writeCost = sum(write_cost_usd), writeTokens = sum(written),\n            outputCost = sum(output_cost_usd), outputTokens = sum(output)\n| project value = iff(readTokens > 0, readCost / readTokens * 1000000.0, real(null))",

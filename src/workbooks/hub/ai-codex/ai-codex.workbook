        "loadType": "lazy",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Codex\n\nToken economics, tool health, and telemetry coverage for OpenAI Codex workloads, measured from Application Insights and priced from the hub price sheet. An absent signal is unknown, not zero."
            },
            "customWidth": "100",
            "name": "fb28af2e-15d5-d7d8-222c-2abe9cc2cdb6"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "2bef0704-0527-8dbf-09ac-69fe79d3fc44",
                  "version": "KqlParameterItem/1.0",
                  "name": "TimeRange",
                  "label": "Time range",
                  "type": 4,
                  "isRequired": true,
                  "value": {
                    "durationMs": 604800000
                  },
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 3600000
                      },
                      {
                        "durationMs": 14400000
                      },
                      {
                        "durationMs": 86400000
                      },
                      {
                        "durationMs": 172800000
                      },
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 2592000000
                      },
                      {
                        "durationMs": 7776000000
                      }
                    ],
                    "allowCustom": true
                  }
                }
              ]
            },
            "customWidth": "100",
            "name": "df2ea716-8e50-7e7f-b583-cec90976d5b8"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Token economics"
            },
            "customWidth": "100",
            "name": "842a71a6-f4cf-dd37-1930-4eeefbecb512"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts});\n\nresponseCosts\n| where priceStatus == 'Priced'\n| summarize reports = count(), cost = sum(cost_usd), tokens = sum(total),\n            benefit = sum(cache_benefit_usd),\n            inputCost = sum(input_cost_usd), inputTokens = sum(uncached),\n            readCost = sum(cached_cost_usd), readTokens = sum(cached),\n            writeCost = sum(write_cost_usd), writeTokens = sum(written),\n            outputCost = sum(output_cost_usd), outputTokens = sum(output)\n| project value = iff(reports > 0, cost, real(null))",
              "size": 4,
              "title": "Priced token cost",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  },
                  "numberFormat": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "25",
            "name": "840deda5-2472-38de-63d0-cbc0f8c91610"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts});\n\nresponseCosts\n| where priceStatus == 'Priced'\n| summarize reports = count(), cost = sum(cost_usd), tokens = sum(total),\n            benefit = sum(cache_benefit_usd),\n            inputCost = sum(input_cost_usd), inputTokens = sum(uncached),\n            readCost = sum(cached_cost_usd), readTokens = sum(cached),\n            writeCost = sum(write_cost_usd), writeTokens = sum(written),\n            outputCost = sum(output_cost_usd), outputTokens = sum(output)\n| project value = iff(tokens > 0, cost / tokens * 1000000.0, real(null))",
              "size": 4,
              "title": "Blended cost / 1M tokens",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  },
                  "numberFormat": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "25",
            "name": "006dd8f7-e78b-ce97-399c-c87a2772afa5"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts}| lookup kind=leftouter (spans | where name == 'run_sampling_request'\n    | project cloud_RoleName, operation_Id, requestId = id, runTurnId = operation_ParentId) on cloud_RoleName, operation_Id, requestId\n| lookup kind=leftouter (spans | where name == 'run_turn'\n    | project cloud_RoleName, operation_Id, runTurnId = id, taskRunId = operation_ParentId) on cloud_RoleName, operation_Id, runTurnId\n| lookup kind=leftouter (spans | where name == 'session_task.run'\n    | project cloud_RoleName, operation_Id, taskRunId = id, turnSpanId = operation_ParentId) on cloud_RoleName, operation_Id, taskRunId\n| lookup kind=leftouter (turns | project cloud_RoleName, operation_Id, turnSpanId, turnPresent = true) on cloud_RoleName, operation_Id, turnSpanId);\nlet turnCosts = responseCosts\n| where turnPresent == true\n| summarize responses = count(), pricedResponses = countif(priceStatus == 'Priced'),\n            responseInput = sum(input), responseCached = sum(cached), responseWritten = sum(written),\n            responseOutput = sum(output), responseTotal = sum(total),\n            cost_usd = sum(cost_usd), retail_usd = sum(retail_usd), negotiated_discount_usd = sum(negotiated_discount_usd),\n            input_cost_usd = sum(input_cost_usd), cached_cost_usd = sum(cached_cost_usd),\n            write_cost_usd = sum(write_cost_usd), output_cost_usd = sum(output_cost_usd),\n            cache_benefit_usd = sum(cache_benefit_usd), context_premium_usd = sum(context_premium_usd),\n            longResponses = countif(context == 'long'), maxResponseInput = max(input),\n            responseIssues = make_set_if(priceStatus, priceStatus != 'Priced', 8)\n    by cloud_RoleName, operation_Id, turnSpanId;\nlet pricedTurns = materialize(turns\n| lookup kind=leftouter turnCosts on cloud_RoleName, operation_Id, turnSpanId\n| extend pricingStatus = case(isnull(responses), 'No response usage in range',\n                              isempty(turnModel), 'Missing turn model',\n                              pricedResponses != responses, strcat_array(responseIssues, '; '),\n                              isnull(turnTotal) or isnull(turnInput) or isnull(turnCached) or isnull(turnOutput), 'Turn summary missing',\n                              responseInput != turnInput or responseCached != turnCached\n                                  or responseOutput != turnOutput or responseTotal != turnTotal, 'Response and turn usage differ',\n                              isnotnull(turnWritten) and responseWritten != turnWritten, 'Response and turn cache writes differ',\n                              'Complete')\n| extend complete = pricingStatus == 'Complete'\n| extend cost_usd = iff(complete, cost_usd, real(null)),\n         retail_usd = iff(complete, retail_usd, real(null)),\n         negotiated_discount_usd = iff(complete, negotiated_discount_usd, real(null)),\n         input_cost_usd = iff(complete, input_cost_usd, real(null)),\n         cached_cost_usd = iff(complete, cached_cost_usd, real(null)),\n         write_cost_usd = iff(complete, write_cost_usd, real(null)),\n         output_cost_usd = iff(complete, output_cost_usd, real(null)),\n         cache_benefit_usd = iff(complete, cache_benefit_usd, real(null)),\n         context_premium_usd = iff(complete, context_premium_usd, real(null)));\n\n\npricedTurns | summarize included = countif(complete), cost = sum(cost_usd) | project value = iff(included > 0, cost / included, real(null))",
              "size": 4,
              "title": "Cost / priced turn",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  },
                  "numberFormat": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "25",
            "name": "573e073e-3e01-574f-35f3-df6e94a3c76c"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkCodexPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkCodexPrices3}{FtkCodexCosts});\n\nresponseCosts\n| where priceStatus == 'Priced'\n| summarize reports = count(), cost = sum(cost_usd), tokens = sum(total),\n            benefit = sum(cache_benefit_usd),\n            inputCost = sum(input_cost_usd), inputTokens = sum(uncached),\n            readCost = sum(cached_cost_usd), readTokens = sum(cached),\n            writeCost = sum(write_cost_usd), writeTokens = sum(written),\n            outputCost = sum(output_cost_usd), outputTokens = sum(output)\n| project value = iff(reports > 0, benefit, real(null))",

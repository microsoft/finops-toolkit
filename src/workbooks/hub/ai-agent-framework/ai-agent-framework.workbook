          {
            "type": 1,
            "content": {
              "json": "#### Select a trace"
            },
            "customWidth": "100",
            "name": "dd4f4d0f-a47a-efd9-16a0-a7874ea23d2d"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nlet costs = agentUsage\n| where isnotempty(agentRunId)\n| summarize input_tokens = iff(countif(isnotnull(input)) > 0, sum(input), long(null)), output_tokens = iff(countif(isnotnull(output)) > 0, sum(output), long(null)), ['Input cost'] = iff(countif(priced) > 0, sum(inputCost), real(null)), ['Cache-read cost'] = iff(countif(priced) > 0, sum(cacheReadCost), real(null)), ['Cache-write cost'] = iff(countif(priced) > 0, sum(cacheWriteCost), real(null)), ['Output cost'] = iff(countif(priced) > 0, sum(outputCost), real(null)), ['Priced token cost'] = iff(countif(priced) > 0, sum(estimated_cost), real(null)), ['Pricing coverage'] = 100.0 * countif(priced) / count() by cloud_RoleName, operation_Id, id = agentRunId, agentKey;\nagentRuns\n| where agentKey in (agentKeys)\n| lookup kind=leftouter costs on cloud_RoleName, operation_Id, id, agentKey\n| project timestamp, Agent = agentLabel, success, duration, input_tokens, output_tokens, ['Priced token cost'], ['Input cost'], ['Cache-read cost'], ['Cache-write cost'], ['Output cost'], ['Pricing coverage'], TraceId = operation_Id, Foundry = foundryName, Project = projectName, Version = agentVersion, ['Agent ID'] = agentId, ['Session ID'] = sessionId, ['Project resource ID'] = projectId\n| order by timestamp desc",
              "size": 1,
              "title": "Agent runs and token costs",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,

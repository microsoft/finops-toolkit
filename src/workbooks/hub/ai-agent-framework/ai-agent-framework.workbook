{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "loadType": "lazy",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Agent framework\n\nRuns, tokens, cost, and reliability for Microsoft Agent Framework workloads, attributed per agent from Application Insights traces and priced from the hub price sheet. An absent signal is unknown, not zero."
            },
            "customWidth": "100",
            "name": "a623f7b2-4010-e77c-2566-f26ec4dc5935"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "e4b2a310-c282-4678-d1f0-751610ed19e4",
                  "version": "KqlParameterItem/1.0",
                  "name": "TimeRange",
                  "label": "Time range",
                  "type": 4,
                  "isRequired": true,
                  "value": {
                    "durationMs": 604800000
                  },
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 3600000
                      },
                      {
                        "durationMs": 14400000
                      },
                      {
                        "durationMs": 86400000
                      },
                      {
                        "durationMs": 172800000
                      },
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 2592000000
                      },
                      {
                        "durationMs": 7776000000
                      }
                    ],
                    "allowCustom": true
                  }
                }
              ]
            },
            "customWidth": "100",
            "name": "408673fb-14cc-46ea-1b84-4481057b614b"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "version": "KqlParameterItem/1.0",
                  "multiSelect": true,
                  "quote": "\"",
                  "delimiter": ",",
                  "queryType": 0,
                  "resourceType": "microsoft.insights/components",
                  "crossComponentResources": [
                    "{TelemetryApplications}"
                  ],
                  "timeContext": {
                    "durationMs": 0
                  },
                  "timeContextFromParameter": "TimeRange",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "id": "6d4f0af2-db14-969d-47bc-53b286af2682",
                  "name": "AgentKeys",
                  "label": "Agents",
                  "type": 2,
                  "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet spans = dependencies | where (timestamp >= StartTime and timestamp < EndTime);\nlet pricing = dynamic({\"services\":[],\"projectResourceId\":\"\",\"longContextTokens\":272000});\n// Pricing intentionally disabled here; no hub price lookup is needed for this result.\nlet price = dynamic({});\nlet priceStart = datetime(null);\nlet priceEnd = datetime(null);\nlet pricesLoaded = false;\n{FtkAgentUsage}\nnamedSpans\n| summarize label = take_any(iff(identityComplete, strcat(agentLabel, ' / ', projectName, ' / ', foundryName), agentLabel)), operationCount = countif(name has 'invoke_agent') by agentKey\n| sort by operationCount desc\n| project value = agentKey, label = label, selected = true"
                },
                {
                  "version": "KqlParameterItem/1.0",
                  "multiSelect": true,
                  "quote": "\"",
                  "delimiter": ",",
                  "queryType": 0,
                  "resourceType": "microsoft.insights/components",
                  "crossComponentResources": [
                    "{TelemetryApplications}"
                  ],
                  "timeContext": {
                    "durationMs": 0
                  },
                  "timeContextFromParameter": "TimeRange",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "id": "0e11cfb0-7b5f-1e45-6dc0-eb9d04b3144e",
                  "name": "AgentProjects",
                  "label": "Foundry projects",
                  "type": 2,
                  "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet spans = dependencies | where (timestamp >= StartTime and timestamp < EndTime);\nlet pricing = dynamic({\"services\":[],\"projectResourceId\":\"\",\"longContextTokens\":272000});\n// Pricing intentionally disabled here; no hub price lookup is needed for this result.\nlet price = dynamic({});\nlet priceStart = datetime(null);\nlet priceEnd = datetime(null);\nlet pricesLoaded = false;\n{FtkAgentUsage}\nattributedSpans\n| where agentKey in (dynamic([{AgentKeys}])) and isnotempty(projectId)\n| summarize by projectId\n| project value = projectId, label = projectId, selected = true"
                }
              ]
            },
            "customWidth": "100",
            "name": "1e8b9865-7372-17e6-9932-750494684e1d"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nlet totals = materialize(agentUsage\n| where agentKey in (agentKeys)\n| summarize inputTokens = sum(input), outputTokens = sum(output), cost = iff(countif(priced) > 0, sum(estimated_cost), real(null)), coverage = iff(count() > 0, 100.0 * countif(priced) / count(), real(null)));\nagentRuns\n| where agentKey in (agentKeys)\n| summarize ['Total Operations'] = count(), ['Avg Response Time'] = round(avg(duration) / 1000, 2)\n| project ['Total Operations'], ['Total Input Tokens'] = toscalar(totals | project inputTokens), ['Total Output Tokens'] = toscalar(totals | project outputTokens), ['Avg Response Time'], ['Priced token cost'] = toscalar(totals | project cost), ['Pricing coverage'] = toscalar(totals | project coverage)",
              "size": 4,
              "title": "Summary statistics",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "rowLimit": 1000
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "100",
            "name": "2a7bb998-33f3-d3ac-aec5-8162d881a2a1"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Agent and project context"
            },
            "customWidth": "100",
            "name": "77864e3a-5080-3a5c-4506-c49d4db511d9"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet spans = dependencies | where (timestamp >= StartTime and timestamp < EndTime);\nlet pricing = dynamic({\"services\":[],\"projectResourceId\":\"\",\"longContextTokens\":272000});\n// Pricing intentionally disabled here; no hub price lookup is needed for this result.\nlet price = dynamic({});\nlet priceStart = datetime(null);\nlet priceEnd = datetime(null);\nlet pricesLoaded = false;\n{FtkAgentUsage}\nattributedSpans\n| where agentKey in (dynamic([{AgentKeys}]))\n| summarize take_any(agentDisplayName, foundryName, projectName, projectId, agentId, tenantId, identityComplete), ['Last seen'] = max(timestamp) by agentKey, agentVersion\n| project Agent = agentDisplayName, Foundry = foundryName, Project = projectName, Version = agentVersion, Identity = iff(identityComplete, 'Complete', 'Missing IDs'), ['Agent ID'] = agentId, ['Last seen'], ['Project resource ID'] = projectId, ['Tenant ID'] = tenantId\n| order by Agent asc, Version asc",
              "size": 1,
              "title": "Agent identity",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "rowLimit": 1000
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "100",
            "name": "63244e90-a63d-f232-c794-7a037938822c"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type in~ ('microsoft.cognitiveservices/accounts', 'microsoft.cognitiveservices/accounts/projects')\n| extend selectedProjects = dynamic([{AgentProjects}])\n| mv-expand selectedProject = selectedProjects\n| extend parentId = extract(@'(?i)^(.+)/projects/[^/]+$', 1, tostring(selectedProject))\n| where id =~ tostring(selectedProject) or id =~ parentId\n| summarize take_any(name, type, location, tags) by id\n| project Scope = iff(type =~ 'microsoft.cognitiveservices/accounts/projects', 'Project', 'Foundry'), Resource = name, Region = location, ['Project tag'] = tostring(tags.Project), Environment = tostring(tags.env), Organization = tostring(tags.org), Tags = tostring(tags), ['Resource ID'] = id\n| order by Scope desc, Resource asc",
              "size": 1,
              "title": "Current project and Foundry tags",
              "timeContext": {
                "durationMs": 0
              },
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "value::selected"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "rowLimit": 1000
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "100",
            "name": "f08f6e47-325f-5e55-d122-12317d8632ad"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Token usage & cost analysis"
            },
            "customWidth": "100",
            "name": "26719b3d-fc7b-8e31-3993-23dfdc3028f8"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet Bucket = case(\n    EndTime - StartTime <= 1d, 15m,\n    EndTime - StartTime <= 7d, 1h,\n    EndTime - StartTime <= 30d, 6h,\n    1d);\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys)\n| summarize ['Input Tokens'] = sum(input), ['Output Tokens'] = sum(output), ['Priced token cost'] = iff(countif(priced) > 0, sum(estimated_cost), real(null)) by bin(timestamp, Bucket)\n| order by timestamp asc",
              "size": 1,
              "title": "Token usage and cost over time",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "timechart",
              "chartSettings": {
                "showLegend": true
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "42",
            "name": "fff311e3-ff2f-edc4-83e7-94099cb6b581"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys)\n| summarize total_tokens = sum(input) + sum(output), agent_name = take_any(agentLabel) by agentKey\n| project agent_name, total_tokens",
              "size": 1,
              "title": "Token usage by agent",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "piechart"
            },
            "doNotRunWhenHidden": true,
            "customWidth": "29",
            "name": "dac47cde-4767-0df2-a3d0-5ccf2ad000dc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys)\n| summarize estimated_cost = iff(countif(priced) > 0, sum(estimated_cost), real(null)) by bin(timestamp, 1d)\n| order by timestamp asc\n| project Day = format_datetime(timestamp, 'yyyy-MM-dd'), estimated_cost",
              "size": 1,
              "title": "Daily token cost estimate",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "barchart",
              "chartSettings": {
                "showLegend": true
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "29",
            "name": "5d59a7db-0589-c251-9758-4aa76debe2d9"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys)\n| summarize Calls = count(), pricedCalls = countif(priced), pricedTokens = sumif(input + output, priced), cost = sum(estimated_cost), inputRate = take_anyif(inputRate, pricingApplies), readRate = take_anyif(cacheReadRate, pricingApplies), writeRate = take_anyif(cacheWriteRate, pricingApplies), outputRate = take_anyif(outputRate, pricingApplies) by provider, model, contextTier\n| project Model = model, Provider = provider, Context = contextTier, Calls, ['Token cost'] = iff(pricedCalls > 0, cost, real(null)), ['Blended / 1M'] = iff(pricedTokens > 0, cost * 1e6 / pricedTokens, real(null)), ['Input / 1M'] = inputRate, ['Cache read / 1M'] = readRate, ['Cache write / 1M'] = writeRate, ['Output / 1M'] = outputRate, ['Pricing coverage'] = 100.0 * pricedCalls / Calls\n| order by ['Token cost'] desc",
              "size": 1,
              "title": "Model rates and token costs",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "rowLimit": 1000
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "100",
            "name": "984b6edd-48d5-7429-8a1d-c95dfa79d2a2"
          },
          {
            "type": 1,
            "content": {
              "json": "#### LLM & tool insights"
            },
            "customWidth": "100",
            "name": "19bd152e-8a15-f4dc-26d8-25200792baf5"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys) and cacheValid\n| summarize inputTokens = sum(input), cachedTokens = sum(cached)\n| project cache_hit_pct = iff(inputTokens > 0, 100.0 * cachedTokens / inputTokens, real(null))",
              "size": 4,
              "title": "Cache hit rate (chat)",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "cache_hit_pct",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  },
                  "numberFormat": {
                    "unit": 1,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "25",
            "name": "16d232aa-6810-c227-5436-5df8696cc29f"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys)\n| summarize ['Cache-read tokens'] = iff(countif(cacheValid) > 0, sumif(cached, cacheValid), long(null)), ['Cache-write tokens'] = iff(countif(written >= 0 and written <= input) > 0, sumif(written, written >= 0 and written <= input), long(null)), ['Cache cost'] = iff(countif(priced) > 0, sum(cacheReadCost + cacheWriteCost), real(null)), ['Net cache benefit'] = iff(countif(priced) > 0, sum(cacheBenefit), real(null))",
              "size": 4,
              "title": "Cache economics",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "rowLimit": 1000
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "25",
            "name": "7c14e867-db54-294a-5949-cf6116129cc1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys)\n| extend finish = tostring(customDimensions['gen_ai.response.finish_reasons'])\n| where isnotempty(finish)\n| summarize call_count = count() by finish",
              "size": 1,
              "title": "Chat finish reasons",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "piechart"
            },
            "doNotRunWhenHidden": true,
            "customWidth": "50",
            "name": "162ad827-5953-f7f1-d31e-e304962097b3"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet Bucket = case(\n    EndTime - StartTime <= 1d, 15m,\n    EndTime - StartTime <= 7d, 1h,\n    EndTime - StartTime <= 30d, 6h,\n    1d);\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentUsage\n| where agentKey in (agentKeys)\n| extend model = tostring(customDimensions['gen_ai.response.model'])\n| extend model = iff(isempty(model), '(unknown)', model)\n| summarize p95_ms = percentile(duration, 95) by bin(timestamp, Bucket), model\n| order by timestamp asc",
              "size": 1,
              "title": "Chat p95 latency by model",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "timechart",
              "chartSettings": {
                "showLegend": true
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "50",
            "name": "e4dbc589-e8ad-47f0-fbfe-1a5c730691b9"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentTools\n| where agentKey in (agentKeys)\n| extend tool = tostring(customDimensions['gen_ai.tool.name'])\n| where isnotempty(tool)\n| summarize calls = count(), success_rate = round(countif(success == 'True') * 100.0 / count(), 1), avg_duration_ms = round(avg(duration), 0), p95_duration_ms = round(percentile(duration, 95), 0) by tool\n| order by calls desc\n| take 30",
              "size": 1,
              "title": "Tool usage leaderboard",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "rowLimit": 1000
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "50",
            "name": "21701c31-9a61-a689-1f36-72c26d503229"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Performance monitoring"
            },
            "customWidth": "100",
            "name": "6f70eb1a-19a8-aef6-4b59-c494aeef6c44"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet Bucket = case(\n    EndTime - StartTime <= 1d, 15m,\n    EndTime - StartTime <= 7d, 1h,\n    EndTime - StartTime <= 30d, 6h,\n    1d);\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nagentRuns\n| where agentKey in (agentKeys)\n| summarize avg = avg(duration) / 1000, p95 = percentile(duration, 95) / 1000, p99 = percentile(duration, 99) / 1000 by bin(timestamp, Bucket)",
              "size": 1,
              "title": "Agent response time trends",
              "timeContext": {

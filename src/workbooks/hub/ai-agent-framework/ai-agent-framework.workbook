          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\n{FtkAgentPrices1}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices2}adx('{HubQueryUri}/{HubDatabase}'){FtkAgentPrices3}{FtkAgentUsage}\nlet agentKeys = dynamic([{AgentKeys}]);\nlet costs = agentUsage\n| where agentKey in (agentKeys)\n| summarize priced_cost = iff(countif(priced) > 0, sum(estimated_cost), real(null)), priced_calls = countif(priced), priced_tokens = sumif(input + output, priced), pricing_coverage = 100.0 * countif(priced) / count() by agentKey\n| extend cost_per_call = iff(priced_calls > 0, priced_cost / priced_calls, real(null)), blended_rate = iff(priced_tokens > 0, priced_cost * 1e6 / priced_tokens, real(null));\nagentRuns\n| where agentKey in (agentKeys)\n| summarize agent_name = take_any(agentLabel), operations = count(), avg_duration = round(avg(duration) / 1000, 2), success_rate = round(countif(success == 'True') * 100.0 / count(), 2) by agentKey\n| lookup kind=leftouter costs on agentKey\n| project agent_name, operations, avg_duration, success_rate, priced_cost, cost_per_call, blended_rate, pricing_coverage, agentKey\n| order by operations desc",

                    "columnId": "output_tokens",
                    "label": "Output tokens"
                  },
                  {
                    "columnId": "TraceId",
                    "label": "Trace ID"
                  }
                ]
              }
            },
            "doNotRunWhenHidden": true,
            "customWidth": "100",
            "name": "c70616e6-dc4d-c1f0-6b61-36b34fef9717"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Trace detail"
            },
            "customWidth": "100",
            "name": "182a8ba1-5b99-e012-a596-b6f5c57d16d6"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let StartTime = todatetime({TimeRange:start});\nlet EndTime = todatetime({TimeRange:end});\nlet TraceId = '{AgentTraceId}';\nunion isfuzzy=true\n    (requests | extend ItemType = 'request', Name = name, Detail = url, DurationMs = duration, Ok = success),\n    (dependencies | extend ItemType = 'dependency', Name = name, Detail = data, DurationMs = duration, Ok = success),\n    (traces | extend ItemType = 'trace', Name = message, Detail = tostring(customDimensions), DurationMs = real(null), Ok = bool(null)),\n    (customEvents | extend ItemType = 'event', Name = name, Detail = tostring(customDimensions), DurationMs = real(null), Ok = bool(null)),\n    (exceptions | extend ItemType = 'exception', Name = type, Detail = outerMessage, DurationMs = real(null), Ok = false)\n| where timestamp >= StartTime and timestamp < EndTime\n| where operation_Id == TraceId\n| project timestamp, ItemType, Name, DurationMs, Ok, SpanId = itemId, ParentId = operation_ParentId, Detail\n| order by timestamp asc",
                    "size": 2,
                    "title": "Trace spans",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "timeContextFromParameter": "TimeRange",
                    "queryType": 0,
                    "resourceType": "microsoft.insights/components",
                    "crossComponentResources": [
                      "{TelemetryApplications}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": ".*",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "useGrouping": true,
                              "maximumFractionDigits": 2
                            }
                          }
                        }
                      ],
                      "rowLimit": 1000,
                      "labelSettings": [
                        {
                          "columnId": "timestamp",
                          "label": "Timestamp"
                        },
                        {
                          "columnId": "ItemType",
                          "label": "Item type"
                        },
                        {
                          "columnId": "DurationMs",
                          "label": "Duration ms"
                        },
                        {
                          "columnId": "SpanId",
                          "label": "Span ID"
                        },
                        {
                          "columnId": "ParentId",
                          "label": "Parent ID"
                        }
                      ]
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "e3efda99-a74a-29e0-6e2d-b30a93bb8c8c"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "AgentTraceId",
              "comparison": "isNotEqualTo",
              "value": ""
            },
            "name": "3ccf5cab-78da-b226-ca96-b6694065cf38"
          },

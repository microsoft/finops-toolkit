          },
          {
            "type": 1,
            "content": {
              "json": "#### Detailed metrics"
            },
            "customWidth": "100",
            "name": "238fca3c-3251-7df8-ad83-8267eff66577"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let agentNames = dynamic([$agentName]);\ndependencies \n| where name contains \"invoke_agent\"\n| extend agent_name = tostring(customDimensions[\"gen_ai.agent.name\"])\n| where isnotempty(agent_name)\n| where array_length(agentNames) > 0\n| where agent_name in (agentNames)\n| summarize \n    p50 = percentile(duration, 50) / 1000,\n    p95 = percentile(duration, 95) / 1000,\n    p99 = percentile(duration, 99) / 1000\n    by agent_name",
              "size": 3,
              "title": "Response time percentiles by agent",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [

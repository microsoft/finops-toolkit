          },
          {
            "type": 1,
            "content": {
              "json": "#### Select a trace"
            },
            "customWidth": "100",
            "name": "dd4f4d0f-a47a-efd9-16a0-a7874ea23d2d"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let agentNames = dynamic([$agentName]);\r\ndependencies\r\n| where name contains \"invoke_agent\"\r\n| extend Agent = tostring(customDimensions[\"gen_ai.agent.name\"])\r\n| where isnotempty(Agent)\r\n| where array_length(agentNames) > 0\r\n| where Agent in (agentNames)\r\n| extend input_tokens = toint(customDimensions[\"gen_ai.usage.input_tokens\"]), output_tokens = toint(customDimensions[\"gen_ai.usage.output_tokens\"])\r\n| project timestamp, Agent, success, duration, input_tokens, output_tokens, TraceId=operation_Id\r\n| order by timestamp desc ",
              "size": 1,
              "title": "",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{TelemetryApplications}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": ".*",
                    "formatter": 0,

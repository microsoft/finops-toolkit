{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "Invoicing and chargeback refer to the process of receiving, reconciling, and paying provider invoices, and then billing internal teams for their respective cloud costs using existing internal finance tools and processes. With this capability, you break down invoices and cross-charge portions of these invoices to the teams responsible for the charges.\r\n\r\n[Learn more](http://aka.ms/ftk/fx/chargeback) &nbsp; &nbsp; [Give feedback](https://portal.azure.com/#view/HubsExtension/InProductFeedbackBlade/extensionName/FinOpsToolkit/cesQuestion/How%20easy%20or%20hard%20is%20it%20to%20use%20the%20FinOps%20hubs%20Data%20Explorer%20dashboard%3F/cvaQuestion/How%20valuable%20the%20FinOps%20hubs%20Data%20Explorer%20dashboard%3F/surveyId/FTK15.0.0-dev.0/bladeName/Hubs.Dashboard/featureName/Manage.Invoicing)"
                  },
                  "customWidth": "100",
                  "name": "c525449a-0db9-bc6c-9829-0337f444d321"
                }
              ]
            },
            "customWidth": "100",
            "name": "bad29603-04f1-08a2-5df2-3d50c19939f7"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nlet monthname = dynamic(['(ignore)', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']);\\nlet costs = materialize(\\n    CostsLastMonth\\n    | summarize BilledCost = round(sum(BilledCost), 2), EffectiveCost = round(sum(EffectiveCost), 2) by BillingPeriodStart = startofmonth(BillingPeriodStart)\\n    | extend json = todynamic(strcat('[{\\\"type\\\":\\\"Billed cost\\\", \\\"Cost\\\":', BilledCost, '}, {\\\"type\\\":\\\"Effective cost\\\", \\\"Cost\\\":', EffectiveCost, '}]'))\\n    | mv-expand json\\n    | project Type = strcat(json.type, ' (', monthname[monthofyear(BillingPeriodStart)], ' ', format_datetime(BillingPeriodStart, 'yyyy'), ')'), Cost = todouble(json.Cost)\\n);\\ncosts\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Cost last month",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "25",
                  "name": "a23ee0ef-4f06-d553-9cab-a790d50e45bd"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nCostsByMonth\\n| summarize BilledCost = round(sum(BilledCost), 2), EffectiveCost = round(sum(EffectiveCost), 2) by BillingPeriodStart = startofmonth(BillingPeriodStart)\\n| render timechart\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 2,
                    "title": "Cost over time",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "barchart",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "75",
                  "name": "a0aed94b-176e-9319-0388-5e334dc783d4"
                }
              ]
            },
            "customWidth": "100",
            "name": "3d26ddf4-02bd-aea4-ce0b-5d36d9e6d854"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nCostsByMonth\\n// | summarize BilledCost = round(sum(BilledCost), 2), EffectiveCost = round(sum(EffectiveCost), 2) by BillingPeriodStart = startofmonth(BillingPeriodStart)\\n// | render timechart\\n| summarize BilledCost = sum(BilledCost), EffectiveCost = sum(EffectiveCost) by BillingPeriodStart = startofmonth(BillingPeriodStart)\\n| order by BillingPeriodStart asc\\n| extend PreviousBilledCost = prev(BilledCost)\\n| extend PreviousEffectiveCost = prev(EffectiveCost)\\n| project BillingPeriodStart\\n    , BilledCost = iif(isempty(PreviousBilledCost), todouble(0), todouble((BilledCost - PreviousBilledCost) * 100.0 / PreviousBilledCost))\\n    , EffectiveCost = iif(isempty(PreviousEffectiveCost), todouble(0), todouble((EffectiveCost - PreviousEffectiveCost) * 100.0 / PreviousEffectiveCost))\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 2,
                    "title": "Change over time",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "barchart",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "5727a866-fdcf-bb55-1479-d10bf683a2cb"
                }
              ]
            },
            "customWidth": "100",
            "name": "e9234703-2ef4-067d-b8b7-3266b0e541fd"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nlet data = materialize(\\n    CostsLastMonth\\n    | summarize\\n        Subscriptions = dcount(SubAccountId),\\n        ResourceGroups = dcount(strcat(SubAccountId, x_ResourceGroupName)),\\n        Resources = dcount(ResourceId),\\n        Services = dcount(ServiceName)\\n    | project json = todynamic(strcat('[{ \\\"Type\\\":\\\"Subscriptions\\\", \\\"Count\\\":', Subscriptions, ' }, { \\\"Type\\\":\\\"Resource groups\\\", \\\"Count\\\":', ResourceGroups, ' }, { \\\"Type\\\":\\\"Resources\\\", \\\"Count\\\":', Resources, ' }, { \\\"Type\\\":\\\"Services\\\", \\\"Count\\\":', Services, ' }]'))\\n    | mv-expand json\\n    | project Label = tostring(json.Type), Count = tolong(json.Count)\\n);\\ndata\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Counts",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "100",
                  "name": "5784d581-fd48-f5f8-59ed-5e7f353f9d0e"
                }
              ]
            },
            "customWidth": "100",
            "name": "554fa079-42a1-2fcf-087d-0ea36f30be38"
          }
        ]
      },
      "name": "group - invoicing-chargeback"
    }

          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nlet ai = materialize(\\n    CostsLastMonth\\n    | extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n    | where ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n);\\nlet total = toscalar(ai | summarize sum(EffectiveCost));\\nlet appCoverage = toscalar(ai | extend keys = coalesce(bag_keys(Tags), dynamic([])) | summarize sumif(EffectiveCost, array_length(set_intersect(keys, dynamic(['application', 'app', 'workload', 'product', 'service']))) > 0));\\nlet ownerCoverage = toscalar(ai | extend keys = coalesce(bag_keys(Tags), dynamic([])) | summarize sumif(EffectiveCost, array_length(set_intersect(keys, dynamic(['owner', 'team', 'createdby']))) > 0));\\nlet costCenterCoverage = toscalar(ai | summarize sumif(EffectiveCost, isnotempty(x_CostCenter)));\\nlet resourceGroupCoverage = toscalar(ai | summarize sumif(EffectiveCost, isnotempty(x_ResourceGroupName)));\\nunion\\n    (print _order = 1, ['Allocation dimension'] = 'Application / workload tag', ['Allocated cost'] = round(appCoverage, 2), ['Coverage %'] = iff(total == 0, real(null), round(appCoverage / total * 100.0, 2)), ['Unallocated cost'] = round(total - appCoverage, 2)),\\n    (print _order = 2, ['Allocation dimension'] = 'Owner / team tag', ['Allocated cost'] = round(ownerCoverage, 2), ['Coverage %'] = iff(total == 0, real(null), round(ownerCoverage / total * 100.0, 2)), ['Unallocated cost'] = round(total - ownerCoverage, 2)),\\n    (print _order = 3, ['Allocation dimension'] = 'Cost center', ['Allocated cost'] = round(costCenterCoverage, 2), ['Coverage %'] = iff(total == 0, real(null), round(costCenterCoverage / total * 100.0, 2)), ['Unallocated cost'] = round(total - costCenterCoverage, 2)),\\n    (print _order = 4, ['Allocation dimension'] = 'Resource group', ['Allocated cost'] = round(resourceGroupCoverage, 2), ['Coverage %'] = iff(total == 0, real(null), round(resourceGroupCoverage / total * 100.0, 2)), ['Unallocated cost'] = round(total - resourceGroupCoverage, 2))\\n| order by _order asc\\n| project-away _order\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "AI allocation coverage by dimension (last month)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "50",
                  "name": "bfbb5edb-98ff-d89c-6936-48a1bbdbec34"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nlet ai = materialize(\\n    CostsLastMonth\\n    | extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n    | where ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n);\\nlet total = toscalar(ai | summarize sum(EffectiveCost));\\nai\\n| extend Owner = coalesce(tostring(Tags['owner']), tostring(Tags['team']), x_CostCenter, x_ResourceGroupName, '(unassigned)')\\n| summarize Cost = sum(EffectiveCost) by Owner\\n| where Cost > 0\\n| summarize Cost = sum(Cost), Variants = dcount(Owner), (TopCost, Owner) = arg_max(Cost, Owner) by OwnerKey = tolower(Owner)\\n| project ['Owner / cost center'] = Owner, ['Effective cost'] = round(Cost, 2), ['Share %'] = iff(total == 0, real(null), round(Cost / total * 100.0, 2))\\n| top maxGroupCount by ['Effective cost'] desc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "AI spend by owner / cost center (last month)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "50",
                  "name": "72504003-36ea-3d2a-6c62-f3910c965692"
                }
              ]
            },
            "customWidth": "100",
            "name": "2d0b307a-d1a8-190e-eae3-c720bc324c91"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nlet ai = materialize(\\n    CostsLastMonth\\n    | extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n    | where ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n);\\nlet total = toscalar(ai | summarize sum(EffectiveCost));\\nlet committed = toscalar(ai | summarize sumif(EffectiveCost, isnotempty(CommitmentDiscountCategory)));\\nlet recommendations = toscalar(\\n    Recommendations()\\n    | where ResourceType has_any ('MachineLearning', 'CognitiveServices', 'Search/search', 'Databricks', 'BotService', 'VideoIndexer')\\n        or x_RecommendationDescription has_any ('AI', 'OpenAI', 'GPU', 'machine learning', 'cognitive')\\n    | count\\n);\\nlet transactions = toscalar(\\n    Transactions()\\n    | where ChargeDescription has_any ('NC', 'ND', 'NV', 'NG', 'GPU', 'Machine Learning', 'Cognitive', 'OpenAI', 'Databricks', 'AI Search')\\n    | count\\n);\\nunion\\n    (print _order = 1, Signal = 'AI on-demand spend', Value = round(total - committed, 2), State = 'baseline'),\\n    (print _order = 2, Signal = 'AI commitment-covered spend', Value = round(committed, 2), State = iff(committed > 0, 'active', 'none in data')),\\n    (print _order = 3, Signal = 'Commitment coverage (%)', Value = iff(total == 0, real(null), round(committed / total * 100.0, 2)), State = 'informational'),\\n    (print _order = 4, Signal = 'AI rate recommendations', Value = todouble(recommendations), State = iff(recommendations > 0, 'review', 'none in data')),\\n    (print _order = 5, Signal = 'AI commitment transactions', Value = todouble(transactions), State = iff(transactions > 0, 'present', 'none in data'))\\n| order by _order asc\\n| project Signal, Value, State\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "AI commitment & optimization posture (query-backed)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "50",
                  "name": "17535a0f-c6ac-8bff-0417-2a109d4a3d93"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nlet _last = startofmonth(startofmonth(now()) - 1d);\\nlet _prev = startofmonth(_last - 1d);\\nCostsByMonth\\n| extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n| where ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n| where ChargePeriodStart >= _prev and ChargePeriodStart < startofmonth(now())\\n| summarize Cost = sumif(EffectiveCost, ChargePeriodStart >= _last), Prev = sumif(EffectiveCost, ChargePeriodStart < _last) by Service = ServiceName, Meter = x_SkuMeterSubcategory\\n| where Cost > 0 or Prev > 0\\n| extend ['MoM change'] = round(Cost - Prev, 2)\\n| project Service, Meter, ['Effective cost'] = round(Cost, 2), ['Prior month'] = round(Prev, 2), ['MoM change']\\n| top maxGroupCount by ['Effective cost'] desc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "Top AI cost drivers to review (MoM)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "50",
                  "name": "322c0c87-8f67-cfcc-a0a9-1e1c90f9ee8f"
                }
              ]
            },
            "customWidth": "100",
            "name": "ad911a08-904b-93cf-7a07-fe23fc8eff18"
          }
        ]
      },
      "name": "group - ai-emerging-workloads"
    }
  ],

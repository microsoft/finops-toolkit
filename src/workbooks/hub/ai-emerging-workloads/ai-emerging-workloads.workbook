                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nCostsLastMonth\\n| where ServiceName in~ ('Azure AI Services', 'Azure AI Video Indexer') and x_SkuMeterCategory !~ 'Foundry Models'\\n| summarize ['Effective cost'] = round(sum(EffectiveCost), 2), ['Calls/units'] = round(sum(ConsumedQuantity), 2) by ['Cognitive service'] = x_SkuMeterSubcategory\\n| where ['Effective cost'] > 0\\n| top maxGroupCount by ['Effective cost'] desc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",

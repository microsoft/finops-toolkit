                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "50",
                  "name": "b72fe8dd-8567-260f-f0b4-fc0d558823f4"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nCostsLastMonth\\n| extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n| where ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n| summarize ['Effective cost'] = round(sum(EffectiveCost), 2), Meters = dcount(x_SkuMeterSubcategory) by Service = ServiceName, Category = ServiceCategory\\n| where ['Effective cost'] > 0\\n| top maxGroupCount by ['Effective cost'] desc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 3,
                    "title": "AI/ML spend by service (last month)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "table",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "rowLimit": 10000
                    }
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "50",
                  "name": "72b50697-4fb6-359b-a4a4-1651e39e2bbc"
                }
              ]
            },
            "customWidth": "100",
            "name": "4da5554c-2c57-0d55-6a2a-81bd4c1e31d0"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",

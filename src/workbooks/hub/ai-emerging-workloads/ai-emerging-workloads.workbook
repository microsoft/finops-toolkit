{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "# AI & emerging workloads\n**AI as a 2026 FinOps Technology Scope** — the full AI/ML estate, not just tokens: foundation models, cognitive services, ML platform & compute, AI Search/retrieval, and GPU/accelerated compute. Tokens are one unit-economic layer. Latest closed month vs prior; effective cost. **Honest gaps (not in FOCUS, so out of scope here):** GPU utilization-per-token, retry/orchestration overhead, request/inference counts, and business-value denominators — so cost-per-inference and AI ROI need non-FOCUS telemetry. GPU posture, commitment posture, and allocation gaps below are query-backed and render neutral/honest when the underlying data is absent."
                  },
                  "customWidth": "100",
                  "name": "289383a1-31d0-2801-d8d3-36300c308fac"
                }
              ]
            },
            "customWidth": "100",
            "name": "c1f46897-f52b-2b8f-9eb8-7de535108094"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "## Trends"
                  },
                  "customWidth": "100",
                  "name": "8395c244-4db7-3c30-3514-38bab8cd7a9c"
                }
              ]
            },
            "customWidth": "100",
            "name": "4537bbe3-49fd-155f-5c2e-eef1ed296519"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nCostsByMonth\\n| where ChargePeriodStart < startofmonth(now())\\n| extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n| where ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n| extend Capability = case(\\n    _gpu, 'GPU / accelerated compute',\\n    x_SkuMeterCategory =~ 'Foundry Models' or x_SkuMeterSubcategory has_any ('OpenAI', 'Deepseek', 'GPT'), 'Foundation models (LLM)',\\n    ServiceName =~ 'Azure AI Search', 'AI Search / retrieval',\\n    ServiceName =~ 'Azure Machine Learning', 'ML platform & compute',\\n    ServiceName =~ 'Azure Databricks', 'ML / analytics platform',\\n    ServiceName =~ 'Azure AI Video Indexer' or x_SkuMeterSubcategory has_any ('Vision', 'Speech', 'Translator', 'Content Understanding', 'Video Indexer', 'Bing', 'Content Safety', 'Phi'), 'Cognitive services',\\n    ServiceName =~ 'Azure AI Bot Service', 'Bot & agents',\\n    'Other AI/ML')\\n| summarize ['Effective cost'] = round(sum(EffectiveCost), 2) by Month = startofmonth(ChargePeriodStart), Capability\\n| order by Month asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 2,
                    "title": "AI/ML estate by capability (monthly trend)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "barchart",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "33",
                  "name": "b7e889c7-e28b-65af-a557-2a80c8a6954f"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nCostsByMonth\\n| where ChargePeriodStart < startofmonth(now())\\n| where x_SkuMeterCategory =~ 'Foundry Models' and PricingUnit =~ 'Units'\\n| summarize ['Tokens (M)'] = round(sum(ConsumedQuantity) / 1000000.0, 2) by Month = startofmonth(ChargePeriodStart)\\n| order by Month asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 2,
                    "title": "Token demand — volume in millions (monthly trend)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "timechart",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "33",
                  "name": "214452c5-a8fe-a130-dfab-e647238e5e7d"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nCostsByMonth\\n| where ChargePeriodStart < startofmonth(now())\\n| where x_SkuMeterCategory =~ 'Foundry Models' and PricingUnit =~ 'Units'\\n| summarize Cost = sum(EffectiveCost), Tokens = sum(ConsumedQuantity) by Month = startofmonth(ChargePeriodStart)\\n| where Tokens > 0\\n| extend CPMT = round(Cost / Tokens * 1000000.0, 2)\\n| project Month, CPMT\\n| order by Month asc\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 2,
                    "title": "Unit price — cost per 1M tokens (monthly trend)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "timechart",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "33",
                  "name": "f64dbd77-a012-a09c-b9d0-dc1b832e2d13"
                }
              ]
            },
            "customWidth": "100",
            "name": "ffeac330-69a0-6ce5-ef5d-820d2021062b"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "loadType": "always",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nlet _last = startofmonth(startofmonth(now()) - 1d);\\nlet _prev = startofmonth(_last - 1d);\\nlet monthly = materialize(\\n    CostsByMonth\\n    | extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n    | extend _ai = ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n    | summarize Cloud = sum(EffectiveCost), Estate = sumif(EffectiveCost, _ai) by Month = startofmonth(ChargePeriodStart)\\n);\\nlet cur = toscalar(monthly | where Month == _last | project Estate);\\nlet prev = toscalar(monthly | where Month == _prev | project Estate);\\nlet cloud = toscalar(monthly | where Month == _last | project Cloud);\\nunion\\n    (print _order = 1, Metric = 'AI/ML spend', Value = round(cur, 2), Status = ''),\\n    (print _order = 2, Metric = 'MoM change', Value = iff(isnull(prev) or prev == 0, real(null), round((cur - prev) / prev * 100.0, 2)), Status = ''),\\n    (print _order = 3, Metric = 'Share of cloud %', Value = iff(isnull(cloud) or cloud == 0, real(null), round(cur / cloud * 100.0, 2)), Status = '')\\n| order by _order asc\\n| project Metric, Value, Status\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "AI/ML estate spend",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "20",
                  "name": "f68182f7-cdbc-ad29-7381-605ac36bef3f"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nlet _last = startofmonth(startofmonth(now()) - 1d);\\nlet _prev = startofmonth(_last - 1d);\\nlet monthly = materialize(\\n    CostsByMonth\\n    | extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n    | summarize MlGpu = sumif(EffectiveCost, ServiceName =~ 'Azure Machine Learning' or _gpu) by Month = startofmonth(ChargePeriodStart)\\n);\\nlet cur = toscalar(monthly | where Month == _last | project MlGpu);\\nlet prev = toscalar(monthly | where Month == _prev | project MlGpu);\\nunion\\n    (print _order = 1, Metric = 'Compute cost', Value = round(cur, 2), Status = ''),\\n    (print _order = 2, Metric = 'MoM change', Value = iff(isnull(prev) or prev == 0, real(null), round((cur - prev) / prev * 100.0, 2)), Status = ''),\\n    (print _order = 3, Metric = 'Prior month', Value = round(prev, 2), Status = '')\\n| order by _order asc\\n| project Metric, Value, Status\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "ML & GPU compute",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "20",
                  "name": "53e05953-14c7-89ea-e4d7-7ce2a18324bf"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nlet _last = startofmonth(startofmonth(now()) - 1d);\\nlet _prev = startofmonth(_last - 1d);\\nlet monthly = materialize(\\n    CostsByMonth\\n    | extend _tokens = x_SkuMeterCategory =~ 'Foundry Models' and PricingUnit =~ 'Units'\\n    | summarize Tokens = sumif(ConsumedQuantity, _tokens) by Month = startofmonth(ChargePeriodStart)\\n);\\nlet cur = toscalar(monthly | where Month == _last | project Tokens);\\nlet prev = toscalar(monthly | where Month == _prev | project Tokens);\\nunion\\n    (print _order = 1, Metric = 'Tokens (M)', Value = round(cur / 1000000.0, 2), Status = ''),\\n    (print _order = 2, Metric = 'MoM change', Value = iff(isnull(prev) or prev == 0, real(null), round((cur - prev) / prev * 100.0, 2)), Status = ''),\\n    (print _order = 3, Metric = 'Tokens', Value = round(cur, 2), Status = '')\\n| order by _order asc\\n| project Metric, Value, Status\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Token volume",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "20",
                  "name": "b8281bbe-4021-2a7c-243b-32e66454cd17"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsByMonth = (\\nCostsPlus\\r\\n| where startofmonth(ChargePeriodStart) >= startofmonth(now(), -numberOfMonths)\\r\\n| extend ChargePeriodStart = startofmonth(ChargePeriodStart)\\r\\n| extend BillingPeriodStart = startofmonth(BillingPeriodStart)\\n);\\n\\nlet _last = startofmonth(startofmonth(now()) - 1d);\\nlet _prev = startofmonth(_last - 1d);\\nlet monthly = materialize(\\n    CostsByMonth\\n    | where x_SkuMeterCategory =~ 'Foundry Models' and PricingUnit =~ 'Units'\\n    | summarize Cost = sum(EffectiveCost), Tokens = sum(ConsumedQuantity) by Month = startofmonth(ChargePeriodStart)\\n    | extend Cpmt = iff(Tokens == 0, real(null), Cost / Tokens * 1000000.0)\\n);\\nlet cur = toscalar(monthly | where Month == _last | project Cpmt);\\nlet currentCost = toscalar(monthly | where Month == _last | project Cost);\\nlet prev = toscalar(monthly | where Month == _prev | project Cpmt);\\nunion\\n    (print _order = 1, Metric = 'Cost per 1M tokens', Value = round(cur, 2), Status = ''),\\n    (print _order = 2, Metric = 'MoM change', Value = iff(isnull(prev) or prev == 0, real(null), round((cur - prev) / prev * 100.0, 2)), Status = ''),\\n    (print _order = 3, Metric = 'Token cost', Value = round(currentCost, 2), Status = '')\\n| order by _order asc\\n| project Metric, Value, Status\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "Cost per 1M tokens (CPMT)",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "20",
                  "name": "a7bfe723-6522-42a6-6354-5e9ebdef5bf2"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let numberOfMonths = toint('{numberOfMonths}');\\nlet numberOfDays = toint('{numberOfDays}');\\nlet maxGroupCount = toint('{maxGroupCount}');\\nlet selectedBillingCurrency = '{selectedBillingCurrency}';\\n\\n{FtkCostsPlus}\\n\\nlet CostsLastMonth = (\\nCostsPlus\\n| where startofmonth(BillingPeriodStart) == startofmonth(startofmonth(now()) - 1d)\\n);\\n\\nlet ai = materialize(\\n    CostsLastMonth\\n    | extend _gpu = strcat(' ', ServiceName, ' ', x_SkuMeterCategory, ' ', x_SkuMeterSubcategory, ' ', x_SkuInstanceType, ' ', tostring(SkuMeter), ' ') matches regex @'(?i)(^|[^a-z0-9])(nc|nd|nv|ng)[a-z0-9_\\\\-]*'\\n    | where ServiceCategory =~ 'AI and Machine Learning' or ServiceName in~ ('Azure AI Search', 'Azure Databricks') or _gpu\\n);\\nlet total = toscalar(ai | summarize sum(EffectiveCost));\\nlet coverage = materialize(\\n    ai\\n    | extend tagKeys = coalesce(bag_keys(Tags), dynamic([]))\\n    | extend HasApp = array_length(set_intersect(tagKeys, dynamic(['application', 'app', 'workload', 'product', 'service']))) > 0\\n    | extend HasOwner = array_length(set_intersect(tagKeys, dynamic(['owner', 'team', 'createdby']))) > 0\\n    | extend HasCostCenter = isnotempty(x_CostCenter)\\n    | summarize Allocated = sumif(EffectiveCost, HasApp or HasOwner or HasCostCenter), CostCenter = sumif(EffectiveCost, HasCostCenter)\\n    | extend AllocatedPercent = iff(total == 0, real(null), round(Allocated / total * 100.0, 2))\\n);\\nunion\\n    (coverage | project _order = 1, Metric = 'Allocated %', Value = AllocatedPercent, Status = case(AllocatedPercent >= 85, 'ok', AllocatedPercent >= 65, 'warn', isnull(AllocatedPercent), '', 'bad')),\\n    (coverage | project _order = 2, Metric = 'Cost-center %', Value = iff(total == 0, real(null), round(CostCenter / total * 100.0, 2)), Status = ''),\\n    (coverage | project _order = 3, Metric = 'Unallocated cost', Value = round(total - Allocated, 2), Status = '')\\n| order by _order asc\\n| project Metric, Value, Status\",\"clusterName\":\"{HubClusterName}\",\"databaseName\":\"{HubDatabase}\"}",
                    "size": 0,
                    "title": "AI allocation coverage",
                    "timeContext": {
                      "durationMs": 0
                    },
                    "queryType": 9,
                    "visualization": "tiles",
                    "showExportToExcel": false
                  },
                  "doNotRunWhenHidden": true,
                  "customWidth": "20",
                  "name": "f6d970c1-7541-bcad-9d79-27fe8beef47f"
                }
              ]
            },
            "customWidth": "100",
            "name": "18126437-6133-3351-668f-8989d25b9269"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",

        "wideLayout": true
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "azureMonitor": {
            "aggregation": "Total",
            "alias": "{{modeldeploymentname}}",
            "allowedTimeGrainsMs": [

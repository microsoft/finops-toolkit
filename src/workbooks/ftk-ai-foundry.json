  "description": "Foundry usage and latency with contracted token rates from the FinOps Toolkit Prices() table. The original operational panels and layout are unchanged.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Doc",
      "tooltip": "Documentation",
      "type": "link",
      "url": "https://aka.ms/amg/dash-doc/ai-foundry"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${adx_ds}"
      },
      "description": "Billed token cost by model for the selected Foundry account, read from the FinOps hub. Rates are never embedded in this dashboard: the hub supplies the billed cost for every token meter, so cached input, cache writes, and output are each charged at their own contracted rate. Token volume on this page comes from Azure Monitor metrics, which report total input tokens only and cannot separate cached from uncached input.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 13,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [],
          "fields": "/^Cost$/",
          "values": true
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.9",
      "targets": [
        {
          "clusterUri": "${cluster}",
          "database": "${database}",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${adx_ds}"
          },
          "query": "let selectedResourceGroup = tostring(${rg:doublequote});\nlet selectedResource = tostring(${res:doublequote});\nlet selectedBillingCurrency = tostring(${selectedBillingCurrency:doublequote});\nCosts()\n| where $__timeFilter(ChargePeriodStart)\n| where isempty(selectedBillingCurrency) or BillingCurrency == selectedBillingCurrency\n| where isempty(selectedResourceGroup) or x_ResourceGroupName =~ selectedResourceGroup\n| where isempty(selectedResource) or ResourceName =~ selectedResource\n| where SkuMeter has \"1M Tokens\"\n| extend Model = strcat(\"gpt-\", replace_string(trim(\" \", extract(@\"^(.+?)\\s+(?:Short|Long)Co\\s\", 1, SkuMeter)), \" \", \"-\"))\n| where isnotempty(Model)\n| summarize Cost = sum(BilledCost) by Model\n| order by Cost desc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "table"
        }
      ],
      "title": "Token cost by model (${selectedBillingCurrency})",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
